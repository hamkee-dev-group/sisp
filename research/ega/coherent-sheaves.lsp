; ============================================================
; ega/coherent-sheaves -- Coherent sheaves on Spec(R)
; Coherent = quasi-coherent with finite presentation.
; M̃ is coherent iff M is finitely generated.
; Kernel, cokernel, image of coherent maps are coherent.
; Verified for modules over the 4-element ring F_2[x]/(x²).
; ============================================================

(print "=== EGA: Coherent Sheaves ===")
(define (quotient a b) (truncate (/ a b)))

; ---------- Ring F_2[x]/(x²) ----------
; Elements: 0, 1, x, 1+x.  Ring has 4 elements.
; This is the ring of dual numbers over F_2.
(define r4 {0 1 2 3})  ; 0=0, 1=1, 2=x, 3=1+x
(define (add4 a b)
  (let ((bits (mod (+ a b) 2))
        (xbits (mod (quotient a 2) 2))
        (xbits2 (mod (quotient b 2) 2)))
    (let ((xsum (mod (+ xbits xbits2) 2)))
      (+ (* 2 xsum) bits))))

(define (mul4 a b)
  (let ((a0 (mod a 2)) (a1 (quotient a 2))
        (b0 (mod b 2)) (b1 (quotient b 2)))
    (let ((c0 (mod (* a0 b0) 2))
          (c1 (mod (+ (* a0 b1) (* a1 b0)) 2)))
      (+ (* 2 c1) c0))))

; Multiplication table for F_2[x]/(x²):
; a=0→0, a=1→1, a=2→x, a=3→1+x
; x²=0 so x·x = 0, x·(1+x) = x + x² = x, (1+x)·(1+x) = 1 + 2x + x² = 1.
; In the encoding a = a0 + 2·a1, mul4 computes c0 = a0·b0, c1 = a0·b1 + a1·b0 mod 2.
; a=3 (binary 11, a0=1 a1=1), b=3: c0=1*1=1, c1=1*1+1*1=2≡0.
; So 3*3 = 0*2 + 1 = 1. ✓
; 2*2 (binary 10): a0=0 a1=1, b0=0 b1=1: c0=0*0=0, c1=0*1+1*0=0. So 2*2=0. ✓
; 2*3: a0=0 a1=1, b0=1 b1=1: c0=0*1=0, c1=0*1+1*1=1. So 2*3=2. ✓ (x·(1+x)=x+x²=x)

(define (neg4 a) a)  ; characteristic 2

(check "four-elements" (= (length r4) 4))
(check "x-squared-is-zero" (= (mul4 2 2) 0))
(check "one-plus-x-squared-is-one" (= (mul4 3 3) 1))
(check "characteristic-two" (= (add4 1 1) 0))

; ---------- Finitely generated modules over F_2[x]/(x²) ----------
; A module M is finitely generated (fg) if ∃ finite generating set.
; Over a finite ring, a module is fg iff it is finite (a module generated
; by g1..gn has at most |R|^n elements), so fg can be checked by counting.

; Example: M = Z/2Z as an F_2[x]/(x²)-module where x acts as 0.
; Elements: {0, 1}. This is finitely generated (1 element).
(define m2 {0 1})
(define (add-m2 a b) (mod (+ a b) 2))
(define (act-m2 r m)
  (let ((r0 (mod r 2)))
    (mod (* r0 m) 2)))

(check "m2-is-fg" (= (length m2) 2))

; Another example: the ring itself R = F_2[x]/(x²) is fg (generate by 1).
(check "R-is-fg" (= (length r4) 4))

; Kernel of a coherent sheaf map is coherent:
; φ: R → M where M = Z/2Z via φ(x) = 0 (the augmentation map).
; Define φ(a + bx) = a mod 2.
(define (phi a) (mod a 2))

; Kernel of φ: {a ∈ R : φ(a) = 0} = {0, x} = {0, 2}
(define kernel-phi (filter (lambda (a) (= (phi a) 0)) r4))
(check "kernel-has-2-elements" (= (length kernel-phi) 2))
(check "kernel-is-xR" (equal kernel-phi {0 2}))

; The kernel is x·R = (x), which is isomorphic to Z/2Z (action of x gives 0).
; This is an ideal, hence finitely generated (by x).
; So kernel of a map between coherent sheaves is coherent.

; Cokernel of φ: coker = M/im(φ). im(φ) = {φ(0), φ(1), φ(x), φ(1+x)} = {0, 1, 0, 1} = {0, 1}.
(define im-phi (map (lambda (a) (phi a)) r4))
(check "image-is-two-elements" (= (length im-phi) 2))
; Coker = M/im(φ): build the quotient module as the actual set of cosets
; m + im(φ) for m ∈ M.  It is the zero module exactly when there is 1 coset.
(define coker-phi
  (map (lambda (m)
    (map (lambda (v) (add-m2 m v)) im-phi)) m2))
(print (list (quote cokernel-cosets) coker-phi))
(check "cokernel-is-zero" (= (length coker-phi) 1))

; Image of a coherent sheaf map is coherent, i.e. finitely generated:
; compute the submodule of M generated by the single element 1 (all R-multiples,
; closed under addition) and check it is exactly im(φ).
(define (m2-span g)
  (let ((base (map (lambda (rr) (act-m2 rr g)) r4)))
    (list-to-set
      (foldr append nil
        (map (lambda (a) (map (lambda (b) (add-m2 a b)) (set-to-list base)))
             (set-to-list base))))))

(check "image-is-coherent" (equal (m2-span 1) im-phi))

; ---------- Coherent = quasi-coherent of finite type ----------
; The structure sheaf O_X is coherent (f.g. as O_X-module).
; O(Spec(R)) = R = F_2[x]/(x²), size 4.
; M̃ coherent iff M is finitely generated over R.

; For the dual numbers ring, the ideal (x) = {0, x} ⊂ R
; defines a coherent sheaf (it's an ideal of a Noetherian ring).
(define ideal-x {0 2})
(define (add-x a b) (let ((s (+ a b))) (cond ((= s 4) 0) ((= s 2) 2) (t s))))
(check "x-ideal-is-coherent" (and (= (length ideal-x) 2) (in 0 ideal-x) (in 2 ideal-x)))

; Verify: x·ideal-x = {0} (x·x = 0, x·0 = 0), so it's a Z/2Z module.
(check "x-acts-as-zero-on-ideal"
  (every (lambda (a) (= (mul4 2 a) 0)) ideal-x))

; ---------- M̃ f.g. vs finite presentation ----------
; Over a Noetherian ring (which all finite rings are),
; "coherent" = "finitely generated" for sheaves.
; Check: R is Noetherian (finite ⇒ Noetherian).
; R is a principal ideal ring: each of its four elements g generates the
; finitely generated principal ideal (g) = g·R.  The four generators
; 0, 1, x, 1+x give (0)={0}, (1)=R, (x)={0,x}, (1+x)=R -- exhibiting a finite
; generator for every ideal, so R is Noetherian.  (As sets (1)=(1+x)=R, since
; 1+x is a unit; the distinct ideals are (0), (x), R.)
(define (principal-ideal g) (map (lambda (rr) (mul4 rr g)) r4))
(define all-ideals (map principal-ideal (set-to-list r4)))

(print (list (quote principal-ideals-of-F2x-mod-x2) all-ideals))
; four generators, but (1)=(1+x)=R, so exactly three DISTINCT ideals: (0), (x), R
(check "three-distinct-ideals" (= (length (list-to-set all-ideals)) 3))

; Every ideal is f.g.: (0) by 0, (x) by x, and R by 1 (or by the unit 1+x).
; So R is Noetherian and Spec(R) has coherent structure sheaf.

; Verifying the coherent sheaf M̃ for M = R:
; Global sections = R (size 4).
; In F_2[x]/(x²) the nilpotent elements are 0 and x (since x²=0), and the
; units are 1 and 1+x (since (1+x)²=1, so (1+x)⁻¹ = 1+x).
; The only prime is P = (x) = {0, 2}, so Spec has 1 point, and:
; D(1) = D(1+x) = Spec (units lie in no prime);
; D(x) = ∅ (x is nilpotent, so it lies in every prime).

(define (prime-p4 p)
  (and (in 0 p) (not (equal p r4))
    (every (lambda (a)
      (every (lambda (b)
        (or (notin (mul4 a b) p) (in a p) (in b p))) r4)) r4)))

(define spec4 (filter (lambda (p) (prime-p4 p)) all-ideals))
(check "one-point-spectrum" (= (length spec4) 1))
(check "prime-is-x-ideal" (in {0 2} spec4))

; For a 1-point spectrum, Γ(Spec(R), M̃) is the stalk M_p at the unique point.
; Localize explicitly: over a finite ring, M_f is the stable image of
; multiplication by f (Fitting: the part of M on which f acts invertibly).
(define (loc-mod mset f)
  (let ((nxt (map (lambda (m) (mul4 f m)) mset)))
    (cond ((= (length nxt) (length mset)) mset)
          (t (loc-mod nxt f)))))

; The stalk at p inverts every element OUTSIDE p, i.e. every unit of R.
(define the-point (car (set-to-list spec4)))
(define outside-p (filter (lambda (f) (notin f the-point)) r4))
(define stalk-at-p
  (foldr (lambda (f acc) (loc-mod acc f)) r4 (set-to-list outside-p)))

(print (list (quote point) the-point (quote inverted) outside-p
             (quote stalk) stalk-at-p (quote loc-at-x) (loc-mod r4 2)))

; Γ(X, M̃) = M for M = R, while localizing at the nilpotent x (which lies IN p,
; so it is NOT inverted here) collapses the module -- the localization really bites.
(check "M-tilde-is-M"
  (and (= (length spec4) 1)
       (equal stalk-at-p r4)
       (equal (loc-mod r4 2) (list-to-set (list 0)))))

(print "=== EGA: Coherent Sheaves Done ===")
