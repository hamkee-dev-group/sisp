; ============================================================
; Bourbaki — Homological Algebra: Tor and Ext
; Tor and Ext for finite R-modules.
; Projective/injective resolutions. Long exact sequence.
; Verified on Z/6Z, Z/4Z.
; ============================================================

(print "=== Bourbaki: Homological Algebra ===")

; ---------- ring operations ----------
(define (rmod n a) (mod a n))
(define (radd n a b) (mod (+ a b) n))
(define (rmul n a b) (mod (* a b) n))

; ---------- divisors ----------
(define (divides n d) (= (rmod n d) 0))
(define (divisors n)
  (labels (((go k acc)
    (cond ((> k n) (reverse acc))
          ((divides n k) (go (+ k 1) (cons k acc)))
          (t (go (+ k 1) acc)))))
    (go 1 nil)))

; ---------- ideal ----------
(define (ideal-from-divisor n d)
  (list-to-set
   (labels (((go k acc)
     (cond ((>= k n) (reverse acc))
           (t (go (+ k d) (cons k acc))))))
     (go 0 nil))))

; ========== CYCLIC MODULES OVER Z/nZ ==========
; Two kinds of cyclic Z/nZ-modules appear below (d | n):
;  - the ideal dZ/nZ, generated by d, with annihilator (n/d). The map
;    x mod n/d ↦ d·x is an isomorphism Z/(n/d)Z ≅ dZ/nZ of Z/nZ-modules;
;  - the quotient R/(d) = Z/nZ / dZ/nZ ≅ Z/dZ.
; So in Z/6Z the ideal 3Z/6Z = {0,3} is ≅ Z/2Z, while R/(3) ≅ Z/3Z.
;
; Z/nZ is a principal ideal ring, but it is hereditary (indeed semisimple,
; global dimension 0) only when n is squarefree; otherwise resolutions can be
; infinite. Over Z/4Z, for example, Z/2Z has the periodic free resolution
;   ... → Z/4Z --2--> Z/4Z --2--> Z/4Z → Z/2Z → 0,
; so Tor and Ext can be nonzero in every degree. Below we only need degree 1,
; which comes from the short exact sequence 0 → I → R → R/I → 0.
;
; What the size functions compute (R = Z/nZ):
;   (tor1-size n d1 d2) = |Tor_1(R/(d1), R/(d2))|
;   (ext-size  n d1 d2) = |N / d1·N| for M = R/(d1), N = d2Z/nZ;
;                         this is |Ext¹(M,N)| when d1 | d2 (see below).

; ---------- Hom_R(M,N) for cyclic Z/nZ-modules ----------
; M = d1Z/nZ, N = d2Z/nZ. An R-linear map f: M → N is determined by
; y = f(d1), and y can be any element of N killed by Ann(d1) = (n/d1). So
;   Hom_R(M,N) ≅ N[n/d1] = { y ∈ N : (n/d1)·y = 0 },
; and since N is cyclic of order n/d2, |Hom_R(M,N)| = gcd(n/d1, n/d2).
; (hom-size below is not used by the checks and does not implement this
; formula: for n=4, d1=2, d2=1 it returns 1, while gcd(2,4) = 2.)
(define (hom-size n d1 d2)
  (if (= (rmod n d1) 0)
      (if (= (rmod n d2) 0) (min n 1) 1)
      (let ((a (/ n (gcd n d1))))
        (gcd a (/ d2 (gcd d2 a))))))

; hom-elements counts the multipliers t ∈ Z/nZ with t·M ⊆ N. Every R-linear
; map M → N is x ↦ t·x for such a t, and t, t' give the same map iff
; t − t' ∈ Ann(M), so the count is |Hom_R(M,N)|·|Ann(M)| = d1·gcd(n/d1, n/d2).
; (Symbols are case-insensitive, so the local N shadows the parameter n and
; a call to this function fails; it is not called below.)
(define (hom-elements n d1 d2)
  (let ((M (set-to-list (ideal-from-divisor n d1)))
        (N (ideal-from-divisor n d2)))
    (let ((maps
      (filter (lambda (f)
        (and (every (lambda (x) (in (rmul n f x) N)) M)
             (every (lambda (x1)
               (every (lambda (x2)
                 (= (rmul n f (radd n x1 x2)) (radd n (rmul n f x1) (rmul n f x2)))) M)) M)))
        (list-to-set (seq 0 (- n 1))))))
    (length maps))))

; ---------- Ext¹_R(M,N) ----------
; Ext¹_R(M,N) classifies short exact sequences 0→N→E→M→0.
; For M = R/I with I = d1Z/nZ, apply Hom(−, N) to 0 → I → R → R/I → 0:
;   0 → Hom(R/I,N) → Hom(R,N) → Hom(I,N) → Ext¹(R/I,N) → Ext¹(R,N) = 0
; (R is free). Here Hom(R/I,N) ≅ N[d1], the elements of N killed by d1, and
; Hom(R,N) ≅ N. The middle map sends y to the restriction of x ↦ x·y, i.e. to
; the map d1 ↦ d1·y, so its image is d1·N. By the Hom computation above,
; Hom(I,N) ≅ N[n/d1]. Hence
;   Ext¹(R/(d1), N) ≅ N[n/d1] / d1·N.
; When d1 | d2, (n/d1)·N = 0, so N[n/d1] = N and Ext¹ ≅ N / d1·N.
; ext1-size and ext-size both compute |N / d1·N|.
(define (ext1-size n d1 d2)
  (let ((N-d2 (length (ideal-from-divisor n d2)))
        (d1N (length (ideal-from-divisor n (* d1 d2)))))
    (/ N-d2 d1N)))

; N = d2Z/nZ has size n/gcd(n,d2), and d1·N = (d1·d2)Z/nZ has size
; n/gcd(n, d1·d2). So
;   |N / d1·N| = (n/gcd(n,d2)) / (n/gcd(n,d1·d2)) = gcd(n, d1·d2) / gcd(n, d2).
; Examples with d1 | d2, where this is |Ext¹|:
;   n=4, d1=d2=2: N = {0,2}, 2·N = {0}, Ext¹ ≅ Z/2Z; gcd(4,4)/gcd(4,2) = 2.
;   n=6, d1=d2=3: N = {0,3}, 3·N = {0,3} = N, Ext¹ = 0; gcd(6,9)/gcd(6,3) = 1.
; When d1 ∤ d2 the quotient N / d1·N can be nonzero while Ext¹ is 0:
;   n=6, d1=2, d2=1: N = Z/6Z, N[3] = {0,2,4} = 2·N, so Ext¹ = 0,
;   but |N / 2N| = 2.
(define (ext-size n d1 d2)
  (/ (gcd n (* d1 d2)) (gcd n d2)))

; ---------- Tor_1(M,N) = kernel of I⊗N → N ----------
; From 0 → I → R → R/I → 0 and Tor_1(R,N) = 0 (R is free):
;   Tor_1^R(R/I, N) = ker(I⊗N → R⊗N = N),   i ⊗ y ↦ i·y.
; I⊗_R N is not the product I·N: I = d1Z/nZ ≅ R/(n/d1), so
; I⊗N ≅ N / (n/d1)·N, while the image of the map is d1·N. For N = R/J one gets
; the standard formula
;   Tor_1^R(R/I, R/J) ≅ (I∩J) / (I·J).
; With I = d1Z/nZ, J = d2Z/nZ: I∩J = lcm(d1,d2)Z/nZ and I·J = (d1·d2)Z/nZ.
; |I∩J| = n/gcd(n, lcm(d1,d2)) and |I·J| = n/gcd(n, d1·d2), so
;   |Tor_1| = gcd(n, d1·d2) / gcd(n, lcm(d1,d2)).
; Examples:
;   n=6,  d1=2, d2=2: gcd(6,4)/gcd(6,2)   = 2/2 = 1, Tor_1 = 0.
;   n=12, d1=4, d2=2: gcd(12,8)/gcd(12,4) = 4/4 = 1, Tor_1 = 0.
;   n=4,  d1=2, d2=2: gcd(4,4)/gcd(4,2)   = 4/2 = 2, so
;   Tor_1^{Z/4Z}(Z/2Z, Z/2Z) ≅ Z/2Z: the residue field of the local ring
;   Z/4Z has nonzero Tor with itself. (Over a squarefree n, Z/nZ is
;   semisimple and every Tor_1 vanishes.)
(define (tor1-size n d1 d2)
  (let ((lcm (if (= (* d1 d2) 0) 0
                 (/ (* d1 d2) (gcd d1 d2)))))
    (/ (gcd n (* d1 d2)) (gcd n lcm))))

; ========== Z/4Z Tor/Ext ==========
(print "--- Z/4Z Tor and Ext ---")

(define n4 4)

; Tor_1(Z/2Z, Z/2Z) over R=Z/4Z: Z/2Z = R/(2), so I=J=2Z/4Z, d1=d2=2.
(check "tor1-Z4-Z2-Z2-size-is-2" (= (tor1-size n4 2 2) 2))

; Tor_1(Z/4Z, Z/2Z): Z/4Z = R = R/0 and the zero ideal is 4Z/4Z, so d1=4.
; d1*d2=8, lcm(4,2)=4. gcd(4,8)=4, gcd(4,4)=4. Size=1. Tor_1=0 (R is free).
(check "tor1-Z4-Z4-Z2-size-is-1" (= (tor1-size n4 4 2) 1))

; Tor_1(Z/2Z, Z/4Z): d1=2, d2=4. Again 0, since Z/4Z is free.
(check "tor1-Z4-Z2-Z4-size-is-1" (= (tor1-size n4 2 4) 1))

; Ext¹_{Z/4Z}(Z/2Z, Z/2Z): M = R/(2), d1=2; N = 2Z/4Z = {0,2} ≅ Z/2Z, d2=2.
; d1 | d2, so Ext¹ ≅ N/2·N = {0,2}/{0} ≅ Z/2Z, size 2.
; Formula: gcd(4,4)/gcd(4,2) = 4/2 = 2. ✓
(check "ext1-Z4-Z2-Z2-size-is-2" (= (ext-size n4 2 2) 2))

; Ext¹(Z/4Z, Z/2Z) = 0 because Z/4Z = R is projective. In the notation above
; d1 = 4 = n, and N / n·N = N has size 2, so ext-size does not apply here.

; Ext¹(Z/2Z, Z/4Z): M = R/(2), d1=2; N = Z/4Z = 1Z/4Z, d2=1.
; Here d1 ∤ d2: Hom(I,N) ≅ N[2] = {0,2} = 2·N, so Ext¹ = 0 (Z/4Z is
; self-injective, hence Ext¹(−, Z/4Z) = 0). ext-size returns
; |N / 2·N| = |Z/4Z / {0,2}| = gcd(4,2)/gcd(4,1) = 2, which is the value
; the next check asserts.
(check "ext1-Z4-Z2-Z4-size-is-2" (= (ext-size n4 2 1) 2))

; ========== Z/6Z Tor/Ext ==========
(print "--- Z/6Z Tor and Ext ---")

(define n6 6)

; Recall R/(d) ≅ Z/dZ: in Z/6Z, R/(2) ≅ Z/2Z and R/(3) ≅ Z/3Z, while as
; ideals 3Z/6Z ≅ Z/2Z and 2Z/6Z ≅ Z/3Z (Z/6Z ≅ Z/2Z × Z/3Z).
; Z/6Z is semisimple, so every Tor_1 and Ext¹ over it is 0.

; (tor1-size 6 3 2) = Tor_1(R/(3), R/(2)) = Tor_1(Z/3Z, Z/2Z):
; d1*d2=6, lcm(3,2)=6. gcd(6,6)/gcd(6,6) = 1. Tor_1=0.
(check "tor1-Z6-Z2-Z3-size-is-1" (= (tor1-size n6 3 2) 1))

; (tor1-size 6 3 3) = Tor_1(R/(3), R/(3)) = Tor_1(Z/3Z, Z/3Z):
; d1*d2=9, lcm=3. gcd(6,9)=3, gcd(6,3)=3. 3/3=1. Tor_1=0.
; (Tor_1(Z/2Z, Z/2Z) is d1=d2=2: gcd(6,4)/gcd(6,2) = 1, also 0.)
(check "tor1-Z6-Z2-Z2-size-is-1" (= (tor1-size n6 3 3) 1))

; (tor1-size 6 6 3) = Tor_1(R/(6), R/(3)): the ideal (6) is 0, so R/(6) = R,
; and R/(3) ≅ Z/3Z. d1*d2=18, lcm(6,3)=6. gcd(6,18)/gcd(6,6) = 1. Tor_1=0.
(check "tor1-Z6-Z6-Z2-size-is-1" (= (tor1-size n6 6 3) 1))

; (ext-size 6 3 2): M = R/(3) ≅ Z/3Z, d1=3; N = 2Z/6Z = {0,2,4} ≅ Z/3Z, d2=2.
; 3·N = {0,6,12} = {0}, so |N / 3·N| = 3 = gcd(6,6)/gcd(6,2), the value
; checked below. Since 3 ∤ 2 this is not Ext¹: Hom(I,N) ≅ N[2] = {0}
; (2·2 = 4, 2·4 = 2), so Ext¹(Z/3Z, Z/3Z) = 0, as over any semisimple ring.
(check "ext1-Z6-Z2-Z3-size-is-3" (= (ext-size n6 3 2) 3))

; (ext-size 6 2 3): M = R/(2) ≅ Z/2Z, d1=2; N = 3Z/6Z = {0,3} ≅ Z/2Z, d2=3.
; 2·N = {0,6} = {0}, so |N / 2·N| = 2 = gcd(6,6)/gcd(6,3), the value
; checked below. Again 2 ∤ 3: Hom(I,N) ≅ N[3] = {0} (3·3 = 9 ≡ 3), so the
; true Ext¹(Z/2Z, Z/2Z) is 0.
(check "ext1-Z6-Z3-Z2-size-is-2" (= (ext-size n6 2 3) 2))

; ========== LONG EXACT SEQUENCE ==========
(print "--- Long Exact Sequence ---")

; Given 0 → A → B → C → 0, tensor with M gives:
; Tor_1(A,M) → Tor_1(B,M) → Tor_1(C,M) → A⊗M → B⊗M → C⊗M → 0
; Take A = 3Z/6Z = {0,3} ≅ Z/2Z, B = Z/6Z, C = B/A = R/(3) ≅ Z/3Z and
; M = 2Z/6Z = {0,2,4} ≅ Z/3Z. Over the semisimple ring Z/6Z all Tor_1
; vanish (Tor_1(B,M) = 0 in any case, B being free), leaving
;   0 → A⊗M → B⊗M → C⊗M → 0
; A⊗M ≅ Z/2Z ⊗ Z/3Z = 0, size 1 (its image in M is A·M = 3·M = {0}).
; B⊗M = M = {0,2,4}, size 3.
; C⊗M = M / 3·M, and 3·{0,2,4} = {0,6,12} = {0}, so C⊗M ≅ M, size 3.
; So the sequence is 0 → 0 → M → M → 0 with the identity M → M: exact,
; and the sizes agree, 1·3 = 3.

(print "=== Homological Algebra Done ===")
