; ============================================================
; Bourbaki — Flat Modules over Finite Rings
; M flat iff -⊗M is exact. For finite rings: flat ⇔ projective
; for finitely presented. Verify flatness for specific modules.
; Verified on Z/12Z, Z/6Z-modules.
; ============================================================

(print "=== Bourbaki: Flat Modules ===")

; ---------- ring operations ----------
(define (rmod n a) (mod a n))
(define (radd n a b) (mod (+ a b) n))
(define (rmul n a b) (mod (* a b) n))

; ---------- divisors ----------
; d divides n  <=>  n mod d = 0   (note (rmod n d) computes d mod n instead)
(define (divides n d) (= (mod n d) 0))
(define (divisors n)
  (labels (((go k acc)
    (cond ((> k n) (reverse acc))
          ((divides n k) (go (+ k 1) (cons k acc)))
          (t (go (+ k 1) acc)))))
    (go 1 nil)))

; ---------- ideal dZ/nZ ----------
(define (ideal-from-divisor n d)
  (list-to-set
   (labels (((go k acc)
     (cond ((>= k n) (reverse acc))
           (t (go (+ k d) (cons k acc))))))
     (go 0 nil))))

; ---------- free module = R ----------
(define (free-module n) (list-to-set (seq 0 (- n 1))))

; ---------- tensor product of cyclic Z/nZ-modules ----------
; Returns the product ideal (d)(e) = (gcd(n, d*e))Z/nZ, which is the image
; of dZ/nZ ⊗ eZ/nZ → Z/nZ. It is isomorphic to the tensor product itself when
; one factor is flat; in general dZ/nZ ⊗_{Z/nZ} eZ/nZ ≅ Z/gcd(n/d, n/e)
; (n = 12, d = e = 2: the tensor is Z/6Z, the product ideal 4Z/12Z has size 3).
(define (tensor-cyclic n d e)
  (ideal-from-divisor n (gcd n (* d e))))

; ---------- flat module characterization for Z/nZ ----------
; A Z/nZ-module M is flat iff for every ideal I ⊆ R, the natural map
; I ⊗_R M → R ⊗_R M ≅ M is injective.
; For cyclic modules take M = dZ/nZ ≅ Z/(n/d) and I = eZ/nZ ≅ Z/(n/e).
; The map I⊗M → M sends e·x ⊗ d·y ↦ e·d·x·y ∈ M = dZ/nZ. Its source is
; I⊗M ≅ Z/gcd(n/d, n/e) and its image is IM = (gcd(n, e*d))Z/nZ, so it is
; injective iff these two have the same size.
; A finitely generated module over a Noetherian ring is flat iff it is
; projective, and dZ/nZ is projective iff it is a direct summand of Z/nZ,
; i.e. iff gcd(d, n/d) = 1 (then (d) is generated by an idempotent).
; So for Z/nZ: flat cyclic module ⇔ projective cyclic module ⇔ gcd(d, n/d) = 1.

(define (flat-ideal-p n d)
  (let ((cofactor (/ n d)))
    (cond ((not (divides n d)) nil)
          ((= (gcd d cofactor) 1) t)
          (t nil))))

; ---------- test flatness via tensor with exact sequences ----------
; 0 → I → R → R/I → 0 exact. Tensor with M:
; 0 → I⊗M → R⊗M → (R/I)⊗M → 0 should be exact if M flat.
; For M = dZ/nZ, I = eZ/nZ:
; I⊗M ≅ Z/gcd(n/d, n/e), R⊗M ≅ dZ/nZ, (R/I)⊗M ≅ M/IM = dZ/nZ / edZ/nZ.
; The map I⊗M → R⊗M injective ⇔ the kernel is trivial.

(define (flatness-test n d e)
  (let ((tensor-IM (gcd n (* e d)))
        (tensor-RM d))
    (let ((kernel-size (/ tensor-RM (gcd tensor-RM e))))
      (= kernel-size tensor-RM))))

; ---------- all flat ideals ----------
(define (flat-ideals n)
  (filter (lambda (d) (flat-ideal-p n d)) (list-to-set (divisors n))))

; ========== Z/6Z FLAT MODULES ==========
(print "--- Z/6Z Flat Modules ---")

(define n6 6)

; All ideals are flat (all projective) since 6 is squarefree.
; Check: d=1,2,3,6 should all be flat.
(check "1Z6-is-flat" (flat-ideal-p n6 1))
(check "2Z6-is-flat" (flat-ideal-p n6 2))
(check "3Z6-is-flat" (flat-ideal-p n6 3))
(check "6Z6-is-flat" (flat-ideal-p n6 6))

; All flat ideals = all ideals
(define flat6 (flat-ideals n6))
(check "Z6-all-ideals-flat" (= (length flat6) 4))

; --- Flatness = Projective for Z/6Z ---
; All modules are flat/projective over Z/6Z (semisimple).
(check "Z6-flat-eq-projective"
  (and (flat-ideal-p n6 1) (flat-ideal-p n6 2)
       (flat-ideal-p n6 3) (flat-ideal-p n6 6)))

; ========== Z/12Z FLAT MODULES ==========
(print "--- Z/12Z Flat Modules ---")

(define n12 12)

; Not all ideals are flat. Flat = projective: only d where gcd(d,12/d)=1.
; Flat ideals: 1,3,4,12 (same as projectives).
(check "1Z12-is-flat" (flat-ideal-p n12 1))
(check "3Z12-is-flat" (flat-ideal-p n12 3))
(check "4Z12-is-flat" (flat-ideal-p n12 4))
(check "12Z12-is-flat" (flat-ideal-p n12 12))

(check "2Z12-is-NOT-flat" (not (flat-ideal-p n12 2)))
(check "6Z12-is-NOT-flat" (not (flat-ideal-p n12 6)))

(define flat12 (flat-ideals n12))
(check "Z12-has-4-flat-ideals" (= (length flat12) 4))

; --- Flat ⇔ Projective for Z/12Z ---
(check "flat-eq-projective-Z12"
  (equal flat12 (list-to-set (list 1 3 4 12))))

; ========== Z/4Z FLAT MODULES ==========
(print "--- Z/4Z Flat Modules ---")

(define n4 4)

; Z/4Z local. Flat ideals: only d where gcd(d,4/d)=1 → only 1 and 4.
(check "1Z4-is-flat" (flat-ideal-p n4 1))
(check "2Z4-is-NOT-flat" (not (flat-ideal-p n4 2)))
(check "4Z4-is-flat" (flat-ideal-p n4 4))

(define flat4 (flat-ideals n4))
(check "Z4-flat-ideals-1-and-4" (equal flat4 {1 4}))

; ========== Z/30Z FLAT MODULES ==========
(print "--- Z/30Z Flat Modules ---")

(define n30 30)
; Squarefree → all 8 divisors flat.
(define flat30 (flat-ideals n30))
(check "Z30-all-8-divisors-flat" (= (length flat30) 8))

; ========== EXACTNESS AFTER TENSORING ==========
(print "--- Exactness Property ---")

; 0 → I → R → R/I → 0 with R = Z/12Z, I = 2Z/12Z ≅ Z/6Z, R/I ≅ Z/2Z.
; For finite modules, 0 → A → B → C → 0 exact forces |B| = |A|·|C|.
;
; Tensor with M = 3Z/12Z = {0,3,6,9} ≅ Z/4Z (flat):
; I⊗M ≅ Z/6Z ⊗ Z/4Z ≅ Z/2Z, size 2; its image in M is IM = 2·M = {0,6}.
; R⊗M = M ≅ Z/4Z, size 4.
; (R/I)⊗M ≅ M / IM = {0,3,6,9} / {0,6} ≅ Z/2Z, size 2 (cosets {0,6}, {3,9}).
; So the sequence is 0 → Z/2Z → Z/4Z → Z/2Z → 0. The map I⊗M → M is
; injective (its image {0,6} has size 2), and M → Z/2Z sends 0,6 ↦ 0 and
; 3,9 ↦ 1, with kernel {0,6}. Exact, and the sizes agree: 2·2 = 4.

; Tensor the same sequence with M = 2Z/12Z = {0,2,4,6,8,10} ≅ Z/6Z (NOT flat):
; I⊗M ≅ Z/6Z ⊗ Z/6Z ≅ Z/6Z, size 6; its image in M is IM = 2·M = {0,4,8}.
; R⊗M = M, size 6.
; (R/I)⊗M ≅ M / IM = {0,2,4,6,8,10} / {0,4,8}, size 2
; (cosets {0,4,8} and {2,6,10}).
; Sizes 6, 6, 2 and 6·2 ≠ 6, so the sequence is not exact: I⊗M → M has
; image of size 3, hence a kernel of size 2 (this kernel is Tor_1(R/I, M)).
; Exactness fails because M is not flat.

; This illustrates: M is flat ⇔ − ⊗ M preserves exact sequences.

; ========== SUMMARY ==========
(print "--- Summary ---")

; For Z/nZ cyclic modules: flat = projective = idempotent-generated.
; Flat iff gcd(d, n/d) = 1.
; Squarefree n ⇒ all modules flat.
; Non-squarefree ⇒ only some modules flat.

(check "flatness-summary"
  (and (flat-ideal-p 6 2) (flat-ideal-p 6 3)
       (not (flat-ideal-p 4 2))
       (not (flat-ideal-p 12 2))
       (flat-ideal-p 12 3) (flat-ideal-p 12 4)))

(print "=== Flat Modules Done ===")
