; ============================================================
; Bourbaki — Localization at Multiplicative Sets
; S⁻¹R for finite rings. D(f) standard opens. Local ring R_p.
; Verified on Z/12Z.
; ============================================================

(print "=== Bourbaki: Localization ===")

; ---------- ring Z/nZ ----------
(define (r+ n a b) (mod (+ a b) n))
(define (r* n a b) (mod (* a b) n))

; ---------- powers mod n ----------
(define (pow-mod n a k)
  (cond ((= k 0) 1)
        (t (mod (* a (pow-mod n a (- k 1))) n))))

; ---------- multiplicative set generated by f in Z/nZ ----------
; S = {f^k mod n : k >= 0}
(define (mult-set-generated-by n f)
  (labels (((build seen k)
    (let ((val (pow-mod n f k)))
      (cond ((= val 0) seen)
            ((in val seen) seen)
            (t (build (cons val seen) (+ k 1)))))))
    (list-to-set (build nil 0))))

; ---------- check S is multiplicatively closed ----------
(define (mult-closed-p S mul)
  (and (in 1 S)
       (every (lambda (a)
         (every (lambda (b) (in (mul a b) S)) S)) S)))

; ---------- kernel of localization: {r : sr=0 for some s in S} ----------
(define (localization-kernel n S)
  (filter (lambda (r)
    (any (lambda (s) (= (mod (* r s) n) 0)) S))
    (list-to-set (seq 0 (- n 1)))))

; ---------- equivalence classes for S⁻¹R: r ~ r' if (r-r')s=0 for some s∈S ----------
(define (localization-equiv n S a b)
  (let ((diff (mod (- a b) n)))
    (any (lambda (s) (= (mod (* diff s) n) 0)) S)))

; ---------- representatives of S⁻¹R: one per equivalence class ----------
(define (localization-reps n S)
  (labels (((pick candidates chosen)
    (cond ((eq candidates nil) (reverse chosen))
          ((any (lambda (c)
             (localization-equiv n S (car candidates) c)) chosen)
           (pick (cdr candidates) chosen))
          (t (pick (cdr candidates) (cons (car candidates) chosen))))))
    (pick (seq 0 (- n 1)) nil)))

; ---------- S⁻¹R as a ring with representatives ----------
(define (localized-ring n S)
  (let ((reps (localization-reps n S)))
    (list-to-set reps)))

; ---------- S⁻¹R addition ----------
(define (loc-add n S a b)
  (let ((sum (mod (+ a b) n)))
    (labels (((find-rep reps)
      (cond ((eq reps nil) sum)
            ((localization-equiv n S sum (car reps)) (car reps))
            (t (find-rep (cdr reps))))))
      (find-rep (localization-reps n S)))))

; ---------- S⁻¹R multiplication ----------
(define (loc-mul n S a b)
  (let ((prod (mod (* a b) n)))
    (labels (((find-rep reps)
      (cond ((eq reps nil) prod)
            ((localization-equiv n S prod (car reps)) (car reps))
            (t (find-rep (cdr reps))))))
      (find-rep (localization-reps n S)))))

; ---------- is the localized ring local? (has a unique maximal ideal) ----------
(define (local-ring-p n S)
  (let ((ring (localized-ring n S)))
    (labels (((nonunit-p x)
      (not (any (lambda (y)
        (= (loc-mul n S x y) 1)) ring))))
      (let ((nonunits (filter nonunit-p ring)))
        (and (not (equal nonunits {}))
             (every (lambda (a)
               (every (lambda (b) (in (loc-add n S a b) nonunits)) nonunits)) nonunits)
             (every (lambda (a)
               (every (lambda (r) (in (loc-mul n S r a) nonunits)) ring)) nonunits))))))

; ========== Z/12Z LOCALIZATION EXAMPLES ==========
(print "--- Z/12Z Localization at f=3 ---")

; R_f for f=3 in Z/12Z
(define S3 (mult-set-generated-by 12 3))
(print (list (quote S-from-3) S3))
(check "S-from-3-is-1-3-9" (equal S3 {1 3 9}))
(check "S-from-3-mult-closed" (mult-closed-p S3 (lambda (a b) (mod (* a b) 12))))

; Kernel of localization at S={1,3,9}
(define ker3 (localization-kernel 12 S3))
(check "kernel-S3-is-0-4-8" (equal ker3 {0 4 8}))

; The localized ring has 4 elements (12/3 = 4 reps)
(define Rf3 (localized-ring 12 S3))
(print (list (quote R-f3-reps) Rf3))
(check "R-f3-has-4-elements" (= (length Rf3) 4))

; Each element of S is a unit in S⁻¹R
(check "3-is-unit-in-R-f3"
  (any (lambda (y) (= (loc-mul 12 S3 3 y) 1)) Rf3))

(check "9-is-unit-in-R-f3"
  (any (lambda (y) (= (loc-mul 12 S3 9 y) 1)) Rf3))

; The canonical map sends kernel elements to 0
(check "4-maps-to-zero" (= (loc-add 12 S3 4 0) 0))
(check "8-maps-to-zero" (= (loc-add 12 S3 8 0) 0))

(print "--- Z/12Z Localization at prime P=(3) ---")

; P = {0,3,6,9}, S = R\P = complement of P
(define P12 {0 3 6 9})
(define SP (filter (lambda (x) (notin x P12)) (list-to-set (seq 0 11))))
(check "S-at-P-is-complement" (= (length SP) 8))
(check "S-at-P-mult-closed" (mult-closed-p SP (lambda (a b) (mod (* a b) 12))))

; Kernel = P itself
(define kerP (localization-kernel 12 SP))
(check "kernel-at-P-is-P" (equal kerP P12))

; The localized ring is Z/3Z (field => local)
(define Rp (localized-ring 12 SP))
(check "R-p-has-3-elements" (= (length Rp) 3))

; R_p is a local ring: every non-unit is in the unique maximal ideal
(check "R-p-is-local-ring" (local-ring-p 12 SP))

; Verify: in R_p, non-units form the unique maximal ideal.
; In Z/3Z, non-units = {0} (the zero ideal, the unique maximal ideal of a field).
(define non-units-Rp (filter
  (lambda (x) (not (any (lambda (y) (= (loc-mul 12 SP x y) 1)) Rp))) Rp))
(check "R-p-has-unique-maximal-ideal"
  (and (not (equal non-units-Rp Rp))
       (equal non-units-Rp {0})
       (every (lambda (a)
         (every (lambda (b) (in (loc-add 12 SP a b) non-units-Rp)) non-units-Rp)) non-units-Rp)))

(print "=== Localization Done ===")
