; ============================================================
; Bourbaki — Discrete Valuation Rings
; DVRs over finite rings. Valuation, uniformizer, residue field.
; Z/p^nZ as a finite chain ring. Compute valuations.
; ============================================================

(print "=== Bourbaki: Discrete Valuation Rings ===")

; ---------- ring operations ----------
(define (rmod n a) (mod a n))
(define (radd n a b) (mod (+ a b) n))
(define (rmul n a b) (mod (* a b) n))

; ---------- Z/p^kZ as a finite valuation ring ----------
; Z/p^kZ is a finite chain ring, NOT a DVR (it's not an integral domain),
; but it has a valuation-like structure.
; Every element x can be written as x = p^v * u where u is a unit (coprime to p).
; v = v_p(x) = the highest power of p dividing x, limited to < k.

; NOTE: `rmod` takes the MODULUS FIRST — (rmod n a) = (mod a n) — so
; "x mod p" is (rmod p x), not (rmod x p). The reversed form computed p mod x
; and raised MODULUS ZERO at x = 0.
; Also `/` yields exact RATIONALS in SISP, so the recursive step must truncate.
(define (p-adic-valuation p n x)
  (cond ((= x 0) n)
        ((= (rmod p x) 0) (+ 1 (p-adic-valuation p n (truncate (/ x p)))))
        (t 0)))

; For Z/p^kZ, valuations cap at k-1, with 0 having valuation k.
(define (valuation-mod-pk p k x)
  (cond ((= x 0) k)
        (t (labels (((count v y)
              (cond ((= (rmod p y) 0) (count (+ v 1) (truncate (/ y p))))
                    ((>= v k) (- k 1))
                    (t v))))
             (count 0 x)))))

; ---------- uniformizer of Z/p^kZ = p ----------
(define (uniformizer-pk p)
  p)

; ---------- residue field of Z/p^kZ = F_p ----------
(define (residue-field-size p)
  p)

; ---------- unit group: elements coprime to p ----------
; SISP has no `pow`, but `^` is a builtin taking an integer exponent, so the
; hand-rolled `labels`-based power (whose binding list was mis-nested, leaving
; the body `(pow p k)` stranded inside the bindings) is not needed at all.
(define (unit-p p k x)
  (and (>= x 0)
       (< x (^ p k))
       (not (= (rmod p x) 0))))

; ---------- decompose x = p^v * u with u unit ----------
(define (decompose-pk p k x)
  (cond ((= x 0) (list k 0))
        (t (let ((v (valuation-mod-pk p k x)))
             (let ((u (truncate (/ x (^ p v)))))
               (list v u))))))

; ========== Z/8Z (p=2, k=3) VALUATION ==========
(print "--- Z/8Z (2³=8) ---")

(define p 2)
(define k 3)
(define n8 8)

; Valuations
(check "v2-0-is-3" (= (valuation-mod-pk p k 0) k))
(check "v2-1-is-0" (= (valuation-mod-pk p k 1) 0))
(check "v2-2-is-1" (= (valuation-mod-pk p k 2) 1))
(check "v2-3-is-0" (= (valuation-mod-pk p k 3) 0))
(check "v2-4-is-2" (= (valuation-mod-pk p k 4) 2))
(check "v2-5-is-0" (= (valuation-mod-pk p k 5) 0))
(check "v2-6-is-1" (= (valuation-mod-pk p k 6) 1))
(check "v2-7-is-0" (= (valuation-mod-pk p k 7) 0))

; Unit test: numbers coprime to 2 (odd numbers)
(check "units-in-z8-are-1-3-5-7"
  (let ((units (filter (lambda (x) (unit-p p k x)) (list-to-set (seq 0 7)))))
    (equal units {1 3 5 7})))

; --- Decomposition ---
(check "decomp-0" (equal (decompose-pk p k 0) (list 3 0)))
(check "decomp-1-is-2^0*1" (equal (decompose-pk p k 1) (list 0 1)))
(check "decomp-2-is-2^1*1" (equal (decompose-pk p k 2) (list 1 1)))
(check "decomp-4-is-2^2*1" (equal (decompose-pk p k 4) (list 2 1)))
(check "decomp-6-is-2^1*3" (equal (decompose-pk p k 6) (list 1 3)))

; Valuation additive: v(x*y) = min(v(x)+v(y), k)
(check "v-additive-2-2" (= (valuation-mod-pk p k (rmul 8 2 2)) (min (+ 1 1) k)))
(check "v-additive-2-4" (= (valuation-mod-pk p k (rmul 8 2 4)) (min (+ 1 2) k)))
(check "v-additive-4-4" (= (valuation-mod-pk p k (rmul 8 4 4)) k))

; ========== Z/27Z (p=3, k=3) VALUATION ==========
(print "--- Z/27Z (3³=27) ---")

(define p3 3)
(define k3 3)
(define n27 27)

(check "v3-0-is-3" (= (valuation-mod-pk p3 k3 0) 3))
(check "v3-1-is-0" (= (valuation-mod-pk p3 k3 1) 0))
(check "v3-3-is-1" (= (valuation-mod-pk p3 k3 3) 1))
(check "v3-6-is-1" (= (valuation-mod-pk p3 k3 6) 1))
(check "v3-9-is-2" (= (valuation-mod-pk p3 k3 9) 2))
(check "v3-18-is-2" (= (valuation-mod-pk p3 k3 18) 2))
(check "v3-2-is-0" (= (valuation-mod-pk p3 k3 2) 0))

; Units = elements coprime to 3.
(define units27 (filter (lambda (x) (unit-p p3 k3 x)) (list-to-set (seq 0 26))))
(check "z27-has-18-units" (= (length units27) 18))

; ========== Z/p^nZ IDEAL STRUCTURE ==========
(print "--- Ideal Structure ---")

; Ideals of Z/p^kZ: (p^0), (p^1), ..., (p^{k-1}), (p^k) = {0}
; Chain: {0} = (p^k) ⊂ (p^{k-1}) ⊂ ... ⊂ (p^1) ⊂ (p^0) = whole ring
; All ideals form a single chain (principal ideal domain-like).

; For Z/8Z: ideals generated by 1(=2^0), 2(=2^1), 4(=2^2), 8(=2^3=0).
; Same mis-nested `labels` power as above — replaced with the `^` builtin.
; (p^e) inside Z/p^kZ is {0, p^e, 2p^e, ...} up to p^k.
(define (ideal-pk p k e)
  (cond ((> e k) (list-to-set (list 0)))
        (t (let ((gen (^ p e))
                 (modulus (^ p k)))
             (list-to-set
              (labels (((go i acc)
                (cond ((>= i modulus) (reverse acc))
                      (t (go (+ i gen) (cons i acc))))))
                (go 0 nil)))))))

(define (ideal-sizes-pk p k)
  (map (lambda (e) (length (ideal-pk p k e))) (seq 0 k)))

; Z/8Z: ideals (2^0)=8, (2^1)=4, (2^2)=2, (2^3)=1 zero ideal
(check "ideal-chain-z8-sizes" (equal (ideal-sizes-pk p k) (list 8 4 2 1)))

; ========== DISCRETE VALUATION PROPERTIES ==========
(print "--- Valuation Properties ---")

; The valuation v: R → N ∪ {∞} satisfies:
; 1. v(x*y) = v(x) + v(y) (additive, with cap for finite rings)
; 2. v(x+y) ≥ min(v(x), v(y)) (ultrametric)
; 3. v(x) = ∞ iff x = 0

(check "v-ultrametric-2-4" 
  (>= (valuation-mod-pk p k (rmod n8 (+ 2 4)))
      (min (valuation-mod-pk p k 2) (valuation-mod-pk p k 4))))

(check "v-ultrametric-1-3" 
  (>= (valuation-mod-pk p k (rmod n8 (+ 1 3)))
      (min (valuation-mod-pk p k 1) (valuation-mod-pk p k 3))))

(check "v-ultrametric-3-5" 
  (>= (valuation-mod-pk p k (rmod n8 (+ 3 5)))
      (min (valuation-mod-pk p k 3) (valuation-mod-pk p k 5))))

; For Z/27Z:
(check "v3-ultrametric-3-6" 
  (>= (valuation-mod-pk p3 k3 (rmod n27 (+ 3 6)))
      (min (valuation-mod-pk p3 k3 3) (valuation-mod-pk p3 k3 6))))

; ========== MAXIMAL IDEAL ==========
(print "--- Maximal Ideal ---")

; The maximal ideal of Z/p^kZ is (p), consisting of all elements with v≥1.
; The residue field is Z/p^kZ / (p) ≅ F_p.

(check "z8-max-ideal-size-4" (= (length (ideal-pk p k 1)) 4))
(check "z8-residue-field-size-2" (= (/ (length (ideal-pk p k 0)) (length (ideal-pk p k 1))) 2))

(check "z27-max-ideal-size-9" (= (length (ideal-pk p3 k3 1)) 9))
(check "z27-residue-field-size-3" (= (/ (length (ideal-pk p3 k3 0)) (length (ideal-pk p3 k3 1))) 3))

; ========== Z/16Z ==========
(print "--- Z/16Z (2⁴=16) ---")

(define p2 2)
(define k4 4)

(check "v2-8-is-3" (= (valuation-mod-pk p2 k4 8) 3))
(check "v2-12-is-2" (= (valuation-mod-pk p2 k4 12) 2))
(check "v2-14-is-1" (= (valuation-mod-pk p2 k4 14) 1))
(check "v2-0-is-4" (= (valuation-mod-pk p2 k4 0) 4))

; Ideal chain: (1)=16 elts, (2)=8, (4)=4, (8)=2, (16)=1 (zero ideal)
(check "z16-ideal-chain" (equal (ideal-sizes-pk p2 k4) (list 16 8 4 2 1)))

(print "=== Discrete Valuation Done ===")
