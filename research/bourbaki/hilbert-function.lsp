; ============================================================
; Bourbaki — Hilbert Function & Polynomial
; Hilbert function k → dim_k(R_k) for graded modules over
; polynomial rings. For F_q[x,y]/(f): compute dim_k of graded pieces.
; Verified for monomial ideals.
; ============================================================

(print "=== Bourbaki: Hilbert Function ===")

; ---------- field operations ----------
(define (rmod p a) (mod a p))

; ---------- monomial representation ----------
; A monomial in 2 variables X,Y: (d1,d2) = X^{d1} Y^{d2}
; Total degree: d1+d2

; ---------- ideal generated by X^a, Y^b ----------
; The quotient R/(X^a, Y^b) in variables X,Y.
; Graded piece of degree k: monomials X^i Y^j with i+j=k, i<a, j<b.
; Hilbert function: H(k) = #{ (i,j) : i+j=k, 0≤i<a, 0≤j<b }

(define (hilbert-monomial-ideal a b k)
  (labels (((count i acc)
    (cond ((>= i a) acc)
          (t (let ((j (- k i)))
               (cond ((and (>= j 0) (< j b)) (count (+ i 1) (+ acc 1)))
                     (t (count (+ i 1) acc))))))))
    (count 0 0)))

; --- Example: R = F_q[X,Y]/(X^2, Y^3) ---
; Monomial basis: {1, X, Y, Y^2, XY, XY^2}
; Hilbert function:
; k=0: {1} → 1
; k=1: {X, Y} → 2
; k=2: {Y^2, XY} → 2
; k=3: {XY^2} → 1
; k≥4: empty → 0

(check "hilbert-x2-y3-k0-is-1" (= (hilbert-monomial-ideal 2 3 0) 1))
(check "hilbert-x2-y3-k1-is-2" (= (hilbert-monomial-ideal 2 3 1) 2))
(check "hilbert-x2-y3-k2-is-2" (= (hilbert-monomial-ideal 2 3 2) 2))
(check "hilbert-x2-y3-k3-is-1" (= (hilbert-monomial-ideal 2 3 3) 1))
(check "hilbert-x2-y3-k4-is-0" (= (hilbert-monomial-ideal 2 3 4) 0))

; --- Example: R = F_q[X,Y]/(X^3, Y^2) ---
; Monomials: i<3, j<2
; k=0: 1 → 1
; k=1: X, Y → 2
; k=2: X^2, XY → 2
; k=3: X^2Y (i=2,j=1) → 1   ((3,0) is excluded since i<3)
; k=4: none (since max deg = (2,1)=3) → 0.
(check "hilbert-x3-y2-k0-is-1" (= (hilbert-monomial-ideal 3 2 0) 1))
(check "hilbert-x3-y2-k1-is-2" (= (hilbert-monomial-ideal 3 2 1) 2))
(check "hilbert-x3-y2-k2-is-2" (= (hilbert-monomial-ideal 3 2 2) 2))
(check "hilbert-x3-y2-k3-is-1" (= (hilbert-monomial-ideal 3 2 3) 1))
(check "hilbert-x3-y2-k4-is-0" (= (hilbert-monomial-ideal 3 2 4) 0))

; --- Hilbert series: Σ H(k) t^k ---
; For (X^a, Y^b), the Hilbert series is
; H(t) = Σ_{i=0}^{a-1} Σ_{j=0}^{b-1} t^{i+j} = (1-t^a)(1-t^b)/(1-t)^2
; At t = 1 this gives the total dimension a*b. The two checks below only
; record the products; the Multiplicity section sums H(k) for (X^2, Y^3).
(check "total-dim-x2-y3-is-6" (= (* 2 3) 6))
(check "total-dim-x3-y3-is-9" (= (* 3 3) 9))

; ========== 3-VARIABLE MONOMIAL IDEALS ==========
(print "--- 3-variable monomial ideals ---")

; R = F_q[X,Y,Z]/(X^a, Y^b, Z^c)
; Hilbert: H(k) = #{(i,j,k') : i+j+k'=k, i<a, j<b, k'<c}
(define (hilbert-3var a b c deg)
  (labels (((count i j acc)
    (cond ((>= i a) acc)
          ((>= j b) (count (+ i 1) 0 acc))
          (t (let ((k (- deg i j)))
               (cond ((and (>= k 0) (< k c)) (count i (+ j 1) (+ acc 1)))
                     (t (count i (+ j 1) acc))))))))
    (count 0 0 0)))

; (X^2, Y^2, Z^2): total dim = 8
(check "hilbert-xyz-2-2-2-k0" (= (hilbert-3var 2 2 2 0) 1))
(check "hilbert-xyz-2-2-2-k1" (= (hilbert-3var 2 2 2 1) 3))
(check "hilbert-xyz-2-2-2-k2" (= (hilbert-3var 2 2 2 2) 3))
(check "hilbert-xyz-2-2-2-k3" (= (hilbert-3var 2 2 2 3) 1))
(check "hilbert-xyz-2-2-2-k4" (= (hilbert-3var 2 2 2 4) 0))

; --- Total dimension check ---
(define (total-dim-3var a b c)
  (labels
    (((sum k acc)
      (cond
        ((> k (+ (* 3 (- 0 1)) a b c)) acc)
        (t (sum (+ k 1) (+ acc (hilbert-3var a b c k)))))))
    (sum 0 0)))

(check "total-dim-222-is-8" (= (total-dim-3var 2 2 2) 8))
(check "total-dim-333-is-27" (= (total-dim-3var 3 3 3) 27))

; ========== HILBERT POLYNOMIAL ==========
(print "--- Hilbert Polynomial ---")

; For a graded module over F_q[X,Y], H(k) is eventually polynomial.
; For an Artinian (zero-dimensional) quotient, H(k) = 0 for all k > reg, where
; the regularity reg is the top degree with H(k) ≠ 0.
; For (X^a, Y^b) the top monomial is X^{a-1}Y^{b-1}, so reg = a+b-2.
; For (X^2, Y^3): reg = 3, H(3)=1, H(k)=0 for k≥4.

; If R/I has Krull dimension d, its Hilbert polynomial has degree d-1.
; The polynomial ring F_q[X,Y] itself has Krull dimension 2: its degree-k
; component has C(n+k-1, k) monomials with n = 2 variables, i.e. k+1.
; So H(k) = k+1, which is linear. hilbert-poly-kxz returns this formula.

(define (hilbert-poly-kxz d k)
  (+ k 1))

(check "hilbert-poly-kxz-k0" (= (hilbert-poly-kxz 2 0) 1))
(check "hilbert-poly-kxz-k1" (= (hilbert-poly-kxz 2 1) 2))
(check "hilbert-poly-kxz-k2" (= (hilbert-poly-kxz 2 2) 3))
(check "hilbert-poly-kxz-k3" (= (hilbert-poly-kxz 2 3) 4))

; ========== QUOTIENT BY PRINCIPAL IDEAL ==========
(print "--- F_q[X,Y]/(f) where deg(f)=d ---")

; Take f = X^d: the quotient is F_q[X,Y]/(X^d), with degree-k monomials
; X^i Y^j, i<d, i+j=k.
; For k < d: every i = 0..k works, so H(k) = k+1.
; For k ≥ d: i = 0..d-1, each with j = k-i, so H(k) = d.
; So the Hilbert polynomial is the constant d. (The same holds for any
; homogeneous f of degree d: H(k) = (k+1) - (k-d+1) = d for k ≥ d.)

(define (hilbert-quotient-by-xd d k)
  (cond ((< k d) (+ k 1))
        (t d)))

(check "h-x4-k0-is-1" (= (hilbert-quotient-by-xd 4 0) 1))
(check "h-x4-k2-is-3" (= (hilbert-quotient-by-xd 4 2) 3))
(check "h-x4-k3-is-4" (= (hilbert-quotient-by-xd 4 3) 4))
(check "h-x4-k4-is-4" (= (hilbert-quotient-by-xd 4 4) 4))
(check "h-x4-k5-is-4" (= (hilbert-quotient-by-xd 4 5) 4))
(check "h-x4-k100-is-4" (= (hilbert-quotient-by-xd 4 100) 4))

; F_q[X,Y]/(X^d) is infinite-dimensional over F_q (Krull dimension 1).
; Its constant Hilbert polynomial d is the degree of the projective scheme
; X^d = 0 in P^1: the point [0:1] counted with multiplicity d.

; ========== REGULARITY AND CASTELNUOVO-MUMFORD ==========
(print "--- Regularity ---")

; For F_q[X,Y]/(X^a, Y^b): reg = a+b-2 (degree of X^{a-1}Y^{b-1}).
; a=2,b=3: H(3)=1, H(4)=0, so reg = 3 = 2+3-2.
; a=3,b=2: H(2)=2, H(3)=1, H(4)=0, so reg = 3 = 3+2-2.

(check "reg-x2-y3-is-3" (and (> (hilbert-monomial-ideal 2 3 3) 0) (= (hilbert-monomial-ideal 2 3 4) 0)))
(check "reg-x3-y2-is-3" (and (> (hilbert-monomial-ideal 3 2 3) 0) (= (hilbert-monomial-ideal 3 2 4) 0)))

; ========== MULTIPLICITY ==========
(print "--- Multiplicity ---")

; For an Artinian quotient R/I, the multiplicity e(R/I) = dim_k(R/I) = Σ H(k).
; For R = F_q[X,Y]/I: dim_k(R/I) = a*b when I = (X^a, Y^b) (monomial complete intersection).
(check "mult-x2-y3-is-6" (= (* 2 3) (+ (+ (hilbert-monomial-ideal 2 3 0) (hilbert-monomial-ideal 2 3 1))
                                        (+ (hilbert-monomial-ideal 2 3 2) (hilbert-monomial-ideal 2 3 3)))))
(check "mult-x3-y4-is-12" (= (* 3 4) 12))

; --- Degree sequence verification ---
; (X^2, Y^3) degree sequence: [1, 2, 2, 1, 0, 0, ...]
(define (degree-sequence a b maxk)
  (map (lambda (k) (hilbert-monomial-ideal a b k)) (seq 0 maxk)))

(check "seq-x2-y3-first4" (equal (degree-sequence 2 3 3) (list 1 2 2 1)))

(print "=== Hilbert Function Done ===")
