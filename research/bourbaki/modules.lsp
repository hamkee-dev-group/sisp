; ============================================================
; Bourbaki — R-Modules for Finite Rings
; Submodules, quotients, direct sums, Hom_R(M,N), free modules,
; exact sequences, snake lemma.
; Verified on Z/6Z-modules.
; ============================================================

(load "lib/collections/relations.lsp")

(print "=== Bourbaki: R-Modules ===")

; ---------- R = Z/nZ ring operations ----------
(define (rmod n a) (mod a n))
(define (radd n a b) (mod (+ a b) n))
(define (rmul n a b) (mod (* a b) n))
(define (rneg n a) (mod (- 0 a) n))

; ---------- divisors ----------
(define (divides n d) (= (mod n d) 0))
(define (divisors n)
  (labels (((go k acc)
    (cond ((> k n) (reverse acc))
          ((divides n k) (go (+ k 1) (cons k acc)))
          (t (go (+ k 1) acc)))))
    (go 1 nil)))

; ---------- module operations for Z/nZ-modules ----------
; A Z/nZ-module is a subset M ⊆ Z/nZ × ... × Z/nZ (direct product)
; or more concretely, a quotient of Z/nZ^k by some submodule.
; For Z/nZ, submodules correspond to subgroups of (Z/nZ)^k.

; For k=1, submodules of Z/nZ are ideals dZ/nZ.
(define (submodule-1d n d)
  (list-to-set
   (labels (((go k acc)
     (cond ((>= k n) (reverse acc))
           (t (go (+ k d) (cons k acc))))))
     (go 0 nil))))

; ---------- submodule test: additive subgroup closed under scalar mult ----------
(define (submodule-p n M)
  (and (in 0 M)
       (every (lambda (a)
         (every (lambda (b) (in (radd n a b) M)) M)) M)
       (every (lambda (a) (in (rneg n a) M)) M)
       (every (lambda (a)
         (every (lambda (r) (in (rmul n r a) M))
           (list-to-set (seq 0 (- n 1))))) M)))

; ---------- quotient module M/N ----------
; If nn ⊆ M are submodules, use representatives.
(define (quotient-module n M nn)
  (labels (((pick candidates chosen)
    (cond ((eq candidates nil) (list-to-set (reverse chosen)))
          ((any (lambda (c)
             (in (rmod n (- (car candidates) c)) nn)) chosen)
           (pick (cdr candidates) chosen))
          (t (pick (cdr candidates) (cons (car candidates) chosen))))))
    (pick (set-to-list M) nil)))

; ---------- isomorphism of modules ----------
; Two modules are isomorphic if they have the same size (additive group order)
; since finitely generated Z/nZ-modules are classified by invariant factors.
(define (module-isomorphic-p M nn)
  (= (length M) (length nn)))

; ---------- direct sum M ⊕ nn = {(x,y) : x∈M, y∈N} ----------
(define (direct-sum M nn)
  (cartesian-product M nn))

; ---------- free module R^k ----------
(define (free-module n k)
  (labels (((prod-sets sets)
    (cond ((eq sets nil) (list-to-set (list nil)))
          (t (cartesian-product (car sets) (prod-sets (cdr sets)))))))
    (let ((ring (list-to-set (seq 0 (- n 1)))))
      (labels (((mk-rings i acc)
        (cond ((= i 0) (prod-sets acc))
              (t (mk-rings (- i 1) (cons ring acc))))))
        (mk-rings k nil)))))

; ---------- rank of a free module: log_{|R|}(|M|) ----------
(define (free-rank n M-size)
  (labels (((find-k k test-size)
    (cond ((= test-size M-size) k)
          (t (find-k (+ k 1) (* test-size n))))))
    (find-k 0 1)))

; ---------- submodule generated by a set S ----------
(define (submodule-generated n ambient S)
  (let ((gens (foldl (lambda (acc x)
                (append acc (map (lambda (r) (rmul n r x)) (seq 0 (- n 1)))))
                nil (set-to-list S))))
    (lfp (lambda (M)
      (let ((ml (set-to-list M)))
        (list-to-set (foldl (lambda (acc x)
                  (foldl (lambda (acc2 y) (cons (radd n x y) acc2))
                    acc ml))
                  ml ml))))
      (list-to-set gens))))

; ---------- module homomorphism: Z/nZ-linear map ----------
; Represented as a matrix multiplying on column vectors.
; For Z/6Z, a map M→N where M,N ⊆ Z/6Z.
(define (module-hom-p n M nn f)
  (and (every (lambda (x) (in (f x) nn)) M)
       (every (lambda (x)
         (every (lambda (y)
           (= (f (radd n x y)) (radd n (f x) (f y)))) M)) M)
       (every (lambda (x)
         (every (lambda (r)
           (= (f (rmul n r x)) (rmul n r (f x)))) M))
         (list-to-set (seq 0 (- n 1))))))

; ---------- kernel and image of a module homomorphism ----------
(define (module-ker n f M)
  (filter (lambda (x) (= (f x) 0)) M))

(define (module-im n f M)
  (list-to-set (map f (set-to-list M))))

; ---------- exact sequence at M: im(alpha) = ker(beta) ----------
(define (exact-p n alpha beta domain-alpha domain-beta-ker)
  (let ((im-alpha (module-im n alpha domain-alpha))
        (ker-beta (module-ker n beta domain-beta-ker)))
    (equal im-alpha ker-beta)))

; ---------- compute submodules of Z/nZ (rank 1) ----------
(define (all-submodules n)
  (list-to-set (map (lambda (d) (submodule-1d n d)) (divisors n))))

; ========== Z/6Z MODULE VERIFICATION ==========
(print "--- Z/6Z-Modules ---")

(define n6 6)
(define ring6 (list-to-set (seq 0 5)))

; --- All submodules of Z/6Z ---
(define M1 (submodule-1d n6 1))
(define M2 (submodule-1d n6 2))
(define M3 (submodule-1d n6 3))
(define M6 (submodule-1d n6 6))

(check "submod-1Z6-is-full-ring" (equal M1 ring6))
(check "submod-2Z6-size-3" (= (length M2) 3))
(check "submod-3Z6-size-2" (= (length M3) 2))
(check "submod-6Z6-is-zero" (equal M6 {0}))

; --- Submodule test ---
(check "M2-is-submodule" (submodule-p n6 M2))
(check "M3-is-submodule" (submodule-p n6 M3))
(check "M6-is-submodule" (submodule-p n6 M6))
(check "M1-is-submodule" (submodule-p n6 M1))

; --- Submodules of Z/6Z have sizes dividing 6 ---
(define all-sub6 (all-submodules n6))
(check "Z6-has-4-submodules" (= (length all-sub6) 4))

; --- Quotient module Z/6Z / 2Z/6Z ≅ Z/2Z ---
(define Q62 (quotient-module n6 M1 M2))
(check "quotient-Z6-over-2Z6-size-2" (= (length Q62) 2))

; Quotient Z/6Z / 3Z/6Z ≅ Z/3Z
(define Q63 (quotient-module n6 M1 M3))
(check "quotient-Z6-over-3Z6-size-3" (= (length Q63) 3))

; --- Isomorphism theorem: (Z/6Z)/(2Z/6Z) ≅ 3Z/6Z ---
(check "iso-Q62-equiv-3Z6" (module-isomorphic-p Q62 M3))
(check "iso-Q63-equiv-2Z6" (module-isomorphic-p Q63 M2))

; --- Direct sum 2Z/6Z ⊕ 3Z/6Z ---
(define M2oplusM3 (direct-sum M2 M3))
(check "direct-sum-M2-M3-size-6" (= (length M2oplusM3) 6))

; --- Free module R^2 = Z/6Z × Z/6Z ---
(define R2-free (free-module n6 2))
(check "free-Z6-rank2-size-36" (= (length R2-free) 36))

; --- Rank test ---
(check "free-rank2-is-2" (= (free-rank n6 (length R2-free)) 2))

; --- Submodule generated by {2} in Z/6Z = {0,2,4} = 2Z/6Z ---
(define gen2 (submodule-generated n6 M1 {2}))
(check "gen-by-2-is-2Z6" (equal gen2 M2))

; --- Submodule generated by {3} = {0,3} = 3Z/6Z ---
(define gen3 (submodule-generated n6 M1 {3}))
(check "gen-by-3-is-3Z6" (equal gen3 M3))

; --- Module homomorphism: Z/6Z → Z/6Z, x → 2x ---
(define (f-mul2 x) (rmul n6 2 x))
(check "hom-mul2-linear" (module-hom-p n6 M1 M1 f-mul2))

; --- Kernel of x → 2x = {0,3} = 3Z/6Z ---
(define ker-mul2 (module-ker n6 f-mul2 M1))
(check "ker-mul2-is-3Z6" (equal ker-mul2 M3))

; --- Image of x → 2x = {0,2,4} = 2Z/6Z ---
(define im-mul2 (module-im n6 f-mul2 M1))
(check "im-mul2-is-2Z6" (equal im-mul2 M2))

; --- Exact sequence: 0 → 3Z/6Z → Z/6Z → 2Z/6Z → 0 ---
; alpha: 3Z/6Z ↪ Z/6Z (inclusion)
; beta: Z/6Z → 2Z/6Z given by x → 2x
(define (alpha-incl x) x)
(define (beta-mul2 x) (rmul n6 2 x))

(check "exact-at-inclusion"
  (exact-p n6 alpha-incl (lambda (x) 0) M3 M3))

(check "exact-at-mul2"
  (exact-p n6 alpha-incl beta-mul2 M3 M1))

; --- Module homomorphism: Z/6Z → Z/6Z, x → 3x ---
(define (f-mul3 x) (rmul n6 3 x))
(define ker-mul3 (module-ker n6 f-mul3 M1))
(define im-mul3 (module-im n6 f-mul3 M1))
(check "ker-mul3-is-2Z6" (equal ker-mul3 M2))
(check "im-mul3-is-3Z6" (equal im-mul3 M3))

; --- Snake lemma setup for Z/6Z ---
; 0 → 3Z/6Z → Z/6Z → 2Z/6Z → 0
;  ↓α      ↓β      ↓γ
; 0 → 3Z/6Z → Z/6Z → 2Z/6Z → 0
; With β(x)=2x. The connecting homomorphism ker(γ)→coker(α) is trivial here.
(define (beta-map x) (rmul n6 2 x))
(check "snake-ker-beta-im-alpha"
  (equal (module-ker n6 beta-map M1) M3))

; --- Kernel/cokernel ---
(define coker-alpha (quotient-module n6 M3 (module-im n6 alpha-incl M3)))
(check "coker-alpha-is-zero" (= (length coker-alpha) 1))
(define ker-gamma (module-ker n6 (lambda (x) (rmul n6 2 x)) M2))
(check "ker-gamma-is-zero" (= (length ker-gamma) 1))

; --- Z/12Z module structure ---
(print "--- Z/12Z as Z/6Z-module ---")
; Z/12Z with Z/6Z action: r * a = (r mod 6) * a mod 12
(define (z12-action r a) (rmul 12 r a))
(define ring12-set (list-to-set (seq 0 11)))

(check "z12-as-z6-module-closed"
  (every (lambda (a)
    (every (lambda (r) (in (z12-action r a) ring12-set)) ring6)) ring12-set))

; --- Z/12Z submodule generated by 2: {0,2,4,6,8,10} ---
(define (gen12-by-2 ambient S)
  (let ((gens (foldl (lambda (acc x)
                (append acc (map (lambda (r) (rmul 12 r x)) (seq 0 5))))
                nil (set-to-list S))))
    (lfp (lambda (M)
      (let ((ml (set-to-list M)))
        (list-to-set (foldl (lambda (acc x)
                  (foldl (lambda (acc2 y) (cons (rmod 12 (+ x y)) acc2))
                    acc ml))
                  ml ml))))
      (list-to-set gens))))

(define submod-2in12 (gen12-by-2 ring12-set {2}))
(check "submod-gen-by-2-in-z12-size-6" (= (length submod-2in12) 6))

(print "=== R-Modules Done ===")
