; ============================================================
; Bourbaki — Dedekind Domains over Finite Rings
; Unique factorization of ideals. Class group.
; For rings like F_q[x]/(f) where f is separable.
; Compute class number.
; ============================================================

(print "=== Bourbaki: Dedekind Domains ===")

; ---------- ring operations ----------
(define (rmod n a) (mod a n))
(define (radd n a b) (mod (+ a b) n))
(define (rmul n a b) (mod (* a b) n))

; ---------- divisors ----------
; d divides n  <=>  n mod d = 0
(define (divides n d) (= (mod n d) 0))
(define (divisors n)
  (labels (((go k acc)
    (cond ((> k n) (reverse acc))
          ((divides n k) (go (+ k 1) (cons k acc)))
          (t (go (+ k 1) acc)))))
    (go 1 nil)))

; ---------- prime test ----------
(define (primep n)
  (cond ((<= n 1) nil)
        ((= n 2) t)
        ((= (mod n 2) 0) nil)
        (t (labels (((go d)
              (cond ((> (* d d) n) t)
                    ((= (mod n d) 0) nil)
                    (t (go (+ d 2))))))
             (go 3)))))

; ---------- prime factorization of n ----------
(define (prime-factorization n)
  (labels (((find m d acc)
    (cond ((= m 1) (reverse acc))
          ((and (divides m d) (primep d))
           (find (truncate (/ m d)) d (cons d acc)))
          (t (find m (+ d 1) acc)))))
    (find n 2 nil)))

; ---------- ideal from divisor ----------
(define (ideal-from-divisor n d)
  (list-to-set
   (labels (((go k acc)
     (cond ((>= k n) (reverse acc))
           (t (go (+ k d) (cons k acc))))))
     (go 0 nil))))

; ========== DEDEKIND DOMAIN: Z/pZ IS A FIELD (Dedekind) ==========
; A Dedekind domain is an integral domain where every nonzero prime ideal
; is maximal and every nonzero ideal factors uniquely into prime ideals.
; A finite integral domain is a field, so the only finite Dedekind domains
; are fields. For finite rings we use a weaker "Dedekind-like" property:
; when n is squarefree, Z/nZ is a product of fields (CRT, semisimple) and
; every ideal (d), d | n, is uniquely the product of the distinct prime
; ideals (p) with p | d. (Since (p)^2 = (p) there, "distinct" is needed.)

; ========== UNIQUE IDEAL FACTORIZATION IN Z/30Z ==========
(print "--- Unique Factorization in Z/30Z ---")

(define n30 30)
(define primes30 (filter primep (divisors n30)))
(check "primes-2-3-5" (equal primes30 (list 2 3 5)))

; Ideals: (2) = 2Z/30Z, (3) = 3Z/30Z, (5) = 5Z/30Z
; The ideal (6) = 6Z/30Z factors as (2)*(3); since 2 and 3 are coprime this
; product also equals (2)∩(3). In general, for d | 30 write
; d = p1^e1 * p2^e2 ... (each ei = 0 or 1 since 30 is squarefree);
; then (d) = ∏_{p_i|d} (p_i).

(define (ideal-factor n d)
  (let ((factors (prime-factorization d)))
    (list-to-set (map (lambda (p) (ideal-from-divisor n p)) factors))))

(define (product-of-ideals n I J)
  (let ((gen-I (car (set-to-list (filter (lambda (x) (not (= x 0))) I))))
        (gen-J (car (set-to-list (filter (lambda (x) (not (= x 0))) J)))))
    (ideal-from-divisor n (gcd n (* gen-I gen-J)))))

; Check: (6) = (2)*(3) in Z/30Z
(define I2-30 (ideal-from-divisor n30 2))
(define I3-30 (ideal-from-divisor n30 3))
(define I5-30 (ideal-from-divisor n30 5))
(define I6-30 (ideal-from-divisor n30 6))

(check "ideal-6-equals-2-times-3" (equal I6-30 (product-of-ideals n30 I2-30 I3-30)))

; (10) = (2)*(5)
(define I10-30 (ideal-from-divisor n30 10))
(check "ideal-10-equals-2-times-5" (equal I10-30 (product-of-ideals n30 I2-30 I5-30)))

; (15) = (3)*(5)
(define I15-30 (ideal-from-divisor n30 15))
(check "ideal-15-equals-3-times-5" (equal I15-30 (product-of-ideals n30 I3-30 I5-30)))

; (30) = (2)*(3)*(5) = {0} (the zero ideal)
(check "ideal-30-equals-product-of-all" (equal (ideal-from-divisor n30 30) 
  (product-of-ideals n30 I2-30 (product-of-ideals n30 I3-30 I5-30))))

; ========== CLASS GROUP FOR FINITE RINGS ==========
(print "--- Class Group ---")

; Z/nZ is a principal ideal ring for every n: each ideal is generated by a
; divisor of n. (It is a domain only for n prime, so "PID" in the strict sense
; applies only then.) Since every ideal is principal, the class group is
; trivial and the class number h(Z/nZ) = 1 for all n, squarefree or not.
; The function below just returns this value; the checks record the fact.

(define (class-number-z-nz n)
  1)

(check "class-number-Z6-is-1" (= (class-number-z-nz 6) 1))
(check "class-number-Z12-is-1" (= (class-number-z-nz 12) 1))
(check "class-number-Z30-is-1" (= (class-number-z-nz 30) 1))
(check "class-number-Z8-is-1" (= (class-number-z-nz 8) 1))

; ========== IDEAL CLASS GROUP OF QUADRATIC FIELDS ==========
; For Q(√d) with ring of integers O_K, the class group is not always trivial.
; But for finite rings Z/nZ, the class group is always trivial.

; ========== PRIMARY DECOMPOSITION ==========
(print "--- Primary Decomposition ---")

; When n is not squarefree, Z/nZ is not Dedekind-like, but its ideals still
; have primary decompositions. In Z/12Z the zero ideal is (0) = (4)∩(3), where
; (4) is (2)-primary and (3) is prime. In general (d) = ∩_{p|d} (p^{v_p(d)}).

; The ideals of Z/12Z are (1) = everything, (2), (3), (4), (6), (12) = {0},
; one for each divisor of 12 = 2²×3: the map d ↦ (d) is a bijection between
; divisors of n and ideals of Z/nZ.

; So every ideal of Z/nZ is I = dZ/nZ for a unique divisor d = ∏ p_i^{e_i}
; of n, and I = ∏ (p_i)^{e_i}. The exponents are unique only while
; e_i ≤ v_{p_i}(n); beyond that the powers stabilise (in Z/12Z,
; (2)^3 = (8) = (4) = (2)^2), so this is weaker than factorization in a
; genuine Dedekind domain.

; ========== VALUATIONS FOR IDEALS ==========
(print "--- Ideal Valuations ---")

; For an ideal I = dZ/nZ and a prime p|n, the p-adic valuation of I is:
; v_p(I) = v_p(d) (the exponent of p in d).
(define (ideal-valuation n d p)
  (labels (((count x e)
    (cond ((= (mod x p) 0) (count (truncate (/ x p)) (+ e 1)))
          (t e))))
    (count d 0)))

(check "v2-of-6-in-Z12" (= (ideal-valuation 12 6 2) 1))
(check "v2-of-4-in-Z12" (= (ideal-valuation 12 4 2) 2))
(check "v3-of-6-in-Z12" (= (ideal-valuation 12 6 3) 1))
(check "v3-of-3-in-Z12" (= (ideal-valuation 12 3 3) 1))

; ========== DEDEKIND CRITERION ==========
(print "--- Dedekind Criterion ---")

; Z/nZ is Dedekind-like (a product of fields, in the sense above) iff n is
; squarefree, i.e. iff the ring is reduced (no nonzero nilpotents). Every
; prime ideal of Z/nZ is maximal for every n, so reducedness is the deciding
; condition.
; Z/30Z is Dedekind-like (product of fields).
; Z/12Z is NOT Dedekind-like (6 is nilpotent: 6² = 36 ≡ 0 mod 12).

(define (squarefree-p n)
  (labels (((check d)
    (cond ((> (* d d) n) t)
          ((and (divides n d) (divides n (* d d))) nil)
          (t (check (+ d 1))))))
    (check 2)))

(check "Z30-is-squarefree-dedekind-like" (squarefree-p n30))
(check "Z12-is-not-squarefree" (not (squarefree-p 12)))
(check "Z6-is-squarefree" (squarefree-p 6))

; ========== FINITE FIELD QUOTIENT: F_q[x]/(x^k) ==========
(print "--- F_q[x]/(x^k) ---")

; F_q[x]/(x^k) has ideal chain: (1)⊃(x)⊃(x²)⊃...⊃(x^{k-1})⊃(x^k)={0}
; This is a chain ring, NOT Dedekind (not reduced). Each ideal is primary.
; Ideal sizes: |(x^j)| = q^{k-j} for 0 ≤ j ≤ k.
(define (chain-ring-ideal-sizes q k)
  (labels (((go j acc)
    (cond ((> j k) (reverse acc))
          (t (let ((size (labels (((pow a e)
                                    (cond ((= e 0) 1)
                                          (t (* a (pow a (- e 1)))))))
                           (pow q (- k j)))))
               (go (+ j 1) (cons size acc)))))))
    (go 0 nil)))

(check "chain-F2-x3-sizes" (equal (chain-ring-ideal-sizes 2 3) (list 8 4 2 1)))

; F_2[x]/(x³): ideals (1)=8, (x)=4, (x²)=2, (x³)=1 (zero)
; All ideals are powers of the maximal ideal (x) → local Artinian Gorenstein ring.
; This is what makes it a "DVR-like" chain ring.

(check "F2-x3-has-4-ideals" (= (length (chain-ring-ideal-sizes 2 3)) 4))

(print "=== Dedekind Domains Done ===")
