; ============================================================
; SGA 4 — Étale Fundamental Group π₁(Spec(F_q))
; π₁(Spec(F_q)) = Ẑ = profinite completion of Z.
; Finite étale covers ↔ finite Ẑ-sets ↔ finite sets with Z-action.
; ============================================================

(print "=== Étale Fundamental Group ===")

; ------------------------------------------------------------
; Machinery A — finite fields F_{p^d} = Z/pZ[x]/(f), elements are coefficient
; lists LOW to HIGH of length d.
; ------------------------------------------------------------
(define (zn a m) (mod (+ (mod a m) m) m))
(define (zeros k) (cond ((<= k 0) nil) (t (cons 0 (zeros (- k 1))))))
(define (padto p dd) (append p (zeros (- dd (length p)))))
(define (coefat p i) (cond ((< i 0) 0) ((>= i (length p)) 0) (t (nth i p))))
(define (vsub a b m) (map (lambda (pr) (zn (- (car pr) (cadr pr)) m)) (zip a b)))
(define (vadd a b m) (map (lambda (pr) (zn (+ (car pr) (cadr pr)) m)) (zip a b)))
(define (scale-poly c p m) (map (lambda (co) (zn (* c co) m)) p))
(define (poly-mul a b m)
  (map (lambda (k)
         (zn (foldl + 0 (map (lambda (i) (* (coefat a i) (coefat b (- k i)))) (seq 0 k))) m))
       (seq 0 (- (+ (length a) (length b)) 2))))
(define (poly-reduce p f m)
  (cond ((< (length p) (length f)) p)
        (t (let ((cc (last p)) (shift (- (length p) (length f))))
             (poly-reduce (butlast (vsub p (append (zeros shift) (scale-poly cc f m)) m)) f m)))))
(define (fdeg f) (- (length f) 1))
(define (fone f) (padto (list 1) (fdeg f)))
(define (fzero f) (zeros (fdeg f)))
(define (fmul a b f m) (padto (poly-reduce (poly-mul a b m) f m) (fdeg f)))
(define (felts dd m)
  (cond ((= dd 0) (list nil))
        (t (foldr append nil
                  (map (lambda (v) (map (lambda (c) (cons c v)) (seq 0 (- m 1))))
                       (felts (- dd 1) m))))))
(define (fpow a k f m) (cond ((= k 0) (fone f)) (t (fmul a (fpow a (- k 1) f m) f m))))
(define (frob a f m) (fpow a m f m))
(define (iterfrob k a f m) (cond ((= k 0) a) (t (iterfrob (- k 1) (frob a f m) f m))))
; evaluate a polynomial with Z/pZ coefficients at a point of the field
(define (feval p a f m)
  (foldl (lambda (acc i)
           (vadd acc (fmul (padto (list (coefat p i)) (fdeg f)) (fpow a i f m) f m) m))
         (fzero f) (seq 0 (- (length p) 1))))
(define (froots p f m)
  (filter (lambda (a) (equal (feval p a f m) (fzero f))) (felts (fdeg f) m)))

; ------------------------------------------------------------
; Machinery B — finite Ẑ-sets. A continuous Ẑ-action on {0,...,n-1} is just a
; permutation (the image of Frobenius). A permutation is stored as the list of
; images: point i goes to (nth i p). Isomorphism class = cycle type.
; ------------------------------------------------------------
(define (insert-at x k l) (append (take l k) (cons x (drop l k))))
(define (perms l)
  (cond ((eq l nil) (list nil))
        (t (foldr append nil
                  (map (lambda (p) (map (lambda (k) (insert-at (car l) k p)) (seq 0 (length p))))
                       (perms (cdr l)))))))
(define (orb-go p cur acc)
  (cond ((contains cur acc) acc) (t (orb-go p (nth cur p) (cons cur acc)))))
(define (orbits-of p)
  (dedup (map (lambda (s) (sort < (orb-go p s nil))) (seq 0 (- (length p) 1)))))
(define (cycle-type p) (sort < (map length (orbits-of p))))
(define (cycle-types-of-sn nn) (dedup (map cycle-type (perms (seq 0 (- nn 1))))))

; partitions of nn as ascending lists — the independent classification of
; degree-nn étale algebras by the degrees of their field factors.
(define (parts-ge nn lo)
  (cond ((= nn 0) (list nil))
        (t (foldr append nil
                  (map (lambda (k) (map (lambda (rest) (cons k rest)) (parts-ge (- nn k) k)))
                       (seq lo nn))))))
(define (partitions nn) (parts-ge nn 1))
; unordered comparison of two collections of lists
(define (same-collection la lb)
  (and (= (length (dedup la)) (length (dedup lb)))
       (every (lambda (x) (contains x lb)) la)
       (every (lambda (x) (contains x la)) lb)))

; ============================================================
; 1. π₁(Spec(F_q)) = Ẑ
; ============================================================
; The étale fundamental group classifies finite étale covers.
; For a field F_q, π₁(Spec(F_q)) = Gal(\bar{F_q}/F_q) = Ẑ.
; Ẑ = lim_{←n} Z/nZ, topologically generated by Frobenius Fr(x) = x^q.
; Finite continuous Ẑ-sets ↔ finite sets with automorphism (the Fr-action).

(print "--- 1. π₁(Spec(F_q)) = Ẑ ---")
(print "The absolute Galois group of F_q is Ẑ (profinite).")
(print "Generator: Frobenius automorphism Fr(x) = x^q.")

; Ẑ is only visible through its finite quotients Gal(F_{q^n}/F_q) = Z/nZ.
; Check that quotient honestly: list the distinct maps Fr^k on the whole field
; (k = 0..5, deliberately more than the expected order) and count them.
; Exactly n distinct maps <=> Fr has order exactly n <=> Gal = Z/nZ = Ẑ/nẐ.
(define f8 (list 1 1 0 1))            ; x³+x+1 over F_2, so F_8 = F_2[x]/(f8)
(define f9 (list 1 0 1))              ; x²+1 over F_3, so F_9 = F_3[x]/(f9)
(define (frob-powers f m dd)
  (dedup (map (lambda (k) (map (lambda (a) (iterfrob k a f m)) (felts dd m))) (seq 0 5))))
(define (frob-fixed f m dd)
  (filter (lambda (a) (equal (frob a f m) a)) (felts dd m)))
(print "number of distinct Frobenius powers on F_8:") (print (length (frob-powers f8 2 3)))
(print "number of distinct Frobenius powers on F_9:") (print (length (frob-powers f9 3 2)))
(print "Frobenius-fixed elements of F_8:") (print (frob-fixed f8 2 3))
(check "pi1-Spec-Fq-is-Zhat"
       (and (= (length (frob-powers f8 2 3)) 3)      ; Ẑ ↠ Gal(F_8/F_2) = Z/3Z
            (= (length (frob-fixed f8 2 3)) 2)       ; fixed field = F_2
            (= (length (frob-powers f9 3 2)) 2)      ; Ẑ ↠ Gal(F_9/F_3) = Z/2Z
            (= (length (frob-fixed f9 3 2)) 3)))     ; fixed field = F_3

; ============================================================
; 2. Degree-n étale covers ↔ Z/nZ-sets
; ============================================================
; Finite étale F_q-algebras of dimension n correspond to:
; (1) Continuous actions of Ẑ on an n-element set.
; (2) Since the action factors through Z/nZ (finite quotient),
;     this is the same as Z/nZ-sets.
;
; Concretely: degree-n étale F_q-algebra = ⊕_i F_{q^{d_i}} where Σ d_i = n.
; The Frobenius permutes the factors cyclically.
;
; Example for n=2 over F_2:
; Degree-2 étale algebras: F_4 (irreducible, connected cover) or F_2 × F_2 (trivial cover).
; These correspond to Z/2Z-sets: the transitive one (orbit of size 2) and the trivial one (two fixed points).

(print "--- 2. Degree-n étale covers ↔ Z/nZ-sets ---")
(print "Degree-n étale = product of F_{q^{d_i}} with Σd_i = n.")
(print "Frobenius acts by cyclic permutation of each factor's Galois group.")

; ROUTE A (topology/combinatorics of the fibre): enumerate ALL n! permutations
; of an n-point set — every continuous Ẑ-action on n points is one of them —
; and reduce them modulo isomorphism by taking cycle types.
; ROUTE B (algebra): a degree-n étale F_q-algebra is ⊕ F_{q^{d_i}} with Σd_i = n,
; i.e. a partition of n. Enumerate partitions recursively.
; The two lists must agree, for every n.
(print "cycle types in S_1..S_5:")
(print (map (lambda (nn) (length (cycle-types-of-sn nn))) (seq 1 5)))
(print "partitions of 1..5:")
(print (map (lambda (nn) (length (partitions nn))) (seq 1 5)))
(check "degree-n-etale-covers"
       (and (every (lambda (nn) (same-collection (cycle-types-of-sn nn) (partitions nn)))
                   (seq 1 5))
            ; and the counts are the partition numbers 1,2,3,5,7 — not all equal
            (equal (map (lambda (nn) (length (cycle-types-of-sn nn))) (seq 1 5))
                   (list 1 2 3 5 7))))

; ============================================================
; 3. The geometric point and fiber functor
; ============================================================
; Geometric point: \bar{F_q} → Spec(F_q).
; Fiber functor: for étale cover S/F_q, compute S ⊗_{F_q} \bar{F_q}.
; Since \bar{F_q} is algebraically closed, this is just:
; S ⊗ \bar{F_q} = ∏_{i} \bar{F_q} (one copy per factor of S).
; The fiber is a finite set with a continuous Ẑ-action.
;
; Example: S = F_{q^n} (degree n separable extension).
; S ⊗ \bar{F_q} = ∏_{σ: F_{q^n} → \bar{F_q}} \bar{F_q} (n copies).
; The Frobenius permutes the n embeddings cyclically.

(print "--- 3. Fiber functor ---")
(print "For S = F_{q^n}: fiber = n copies of F_q-bar.")
(print "Frobenius cyclically permutes the n embeddings.")

; The fibre of S = F_q[x]/(g) at the geometric point is Hom_{F_q}(S, \bar{F_q}),
; and an F_q-homomorphism is exactly a choice of root of g. So compute the fibre
; by ROOT-FINDING inside the splitting field, then let Frobenius act on it.
; For S = F_8 = F_2[x]/(x³+x+1): the fibre should have 3 points forming ONE
; Frobenius orbit (S is a field => the cover is connected => action transitive).
(define f8-roots (froots f8 f8 2))
(define f9-roots (froots f9 f9 3))
(define (frob-orbit a f m)
  (dedup (map (lambda (k) (iterfrob k a f m)) (seq 0 5))))
(print "roots of x³+x+1 in F_8 (the fibre):") (print f8-roots)
(print "Frobenius orbit of the first root:") (print (frob-orbit (car f8-roots) f8 2))
(print "roots of x²+1 in F_9 (the fibre):") (print f9-roots)
(check "fiber-functor-F_qn"
       (and (= (length f8-roots) 3)                       ; |fibre| = [F_8:F_2]
            (= (length (frob-orbit (car f8-roots) f8 2)) 3)
            (same-collection (frob-orbit (car f8-roots) f8 2) f8-roots)  ; transitive
            (= (length f9-roots) 2)                       ; |fibre| = [F_9:F_3]
            (same-collection (frob-orbit (car f9-roots) f9 3) f9-roots)
            ; Frobenius genuinely moves the fibre — it is not the identity on it
            (not (equal (frob (car f8-roots) f8 2) (car f8-roots)))))

; ============================================================
; 4. Compute all degree-3 étale covers of Spec(F_5)
; ============================================================
; Classification: degree-3 étale F_5-algebras.
; Possibilities:
; (a) F_5 × F_5 × F_5 (trivial, 3 fixed points)
; (b) F_{25} × F_5 (Frobenius fixes F_5 component, acts on F_{25} by x ↦ x^5)
; (c) F_{125} (single orbit of size 3 under Frobenius)
;
; These correspond to partitions of n=3:
; (a) 1+1+1, (b) 2+1, (c) 3.
; The number of such covers is the number of conjugacy classes
; of homomorphisms Ẑ → S_3, i.e., conjugacy classes in S_3.
; S_3 has 3 conjugacy classes: {id}, {transpositions}, {3-cycles}.
; These correspond exactly to the 3 types above.

(print "--- 4. Degree-3 étale covers of Spec(F_5) ---")
(print "3 partition types: 1+1+1, 2+1, 3.")
(print "(a) F_5 × F_5 × F_5 (trivial)")
(print "(b) F_{25} × F_5 (mixed)")
(print "(c) F_{125} (irreducible)")
(print "Correspond to 3 conjugacy classes in S_3.")

; ROUTE A: the three Ẑ-set types on 3 points = cycle types of S_3.
; ROUTE B: exactly one of them is transitive, so there is exactly ONE CONNECTED
; degree-3 cover, namely F_125. Confirm F_125 really is unique by counting the
; monic irreducible cubics over F_5 by brute force (a cubic is irreducible iff it
; has no root in F_5) and comparing with the necklace count (5³-5)/3, which is
; the number of degree-3 elements of F_125 — all giving the SAME field.
(define s3-types (cycle-types-of-sn 3))
(define transitive-3 (filter (lambda (ct) (equal ct (list 3))) s3-types))
(define (tuples3 q)
  (foldr append nil
         (map (lambda (a) (foldr append nil
                (map (lambda (b) (map (lambda (c) (list a b c)) (seq 0 (- q 1))))
                     (seq 0 (- q 1)))))
              (seq 0 (- q 1)))))
(define (cubic-has-root a b c q)
  (any (lambda (x) (= (mod (+ (^ x 3) (+ (* a (^ x 2)) (+ (* b x) c))) q) 0)) (seq 0 (- q 1))))
(define irred-cubics-F5
  (count (lambda (tr) (not (cubic-has-root (nth 0 tr) (nth 1 tr) (nth 2 tr) 5))) (tuples3 5)))
(print "cycle types on 3 points:") (print s3-types)
(print "monic irreducible cubics over F_5, brute force:") (print irred-cubics-F5)
(print "necklace count (5³-5)/3 =") (print (/ (- (^ 5 3) 5) 3))
(check "degree-3-covers-Spec-F5"
       (and (= (length s3-types) 3)
            (same-collection s3-types (partitions 3))
            (= (length transitive-3) 1)                       ; unique connected cover
            (= irred-cubics-F5 (/ (- (^ 5 3) 5) 3))))         ; 40 cubics, one field F_125

; ============================================================
; 5. Verify: degree-2 étale covers of Spec(F_3)
; ============================================================
; F_3 has 2 degree-2 extensions up to isomorphism:
; (a) F_3 × F_3 (product, trivial Fr-action: both points fixed)
; (b) F_9 (field extension, Fr swaps the 2 embeddings)
; F_9 = F_3[x]/(x²+1) since x²+1 is irreducible over F_3
; (1²+1 = 2, 2²+1 = 5 ≡ 2 mod 3, neither is 0).
; Also F_9 = F_3[x]/(x²+x+2) etc. All degree-2 extensions are isomorphic.

(print "--- 5. Degree-2 étale covers of Spec(F_3) ---")
(print "2 types:")
(print "  (a) F_3 × F_3 — split, trivial cover")
(print "  (b) F_9 = F_3[x]/(x²+1) — connected, Fr acts by swapping.")

; Verify that x²+1 is irreducible over F_3:
(define (irred-check)
  (and (not (= (mod (+ (* 0 0) 1) 3) 0))
       (not (= (mod (+ (* 1 1) 1) 3) 0))
       (not (= (mod (+ (* 2 2) 1) 3) 0))))
(print "x²+1 has no root in F_3?") (print (irred-check))
(check "x^2+1-irreducible-over-F3" (irred-check))

(print "=== Étale Fundamental Group Done ===")
