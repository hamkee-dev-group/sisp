; ============================================================
; SGA 3 — Étale Cohomology of Spec(F_q)
; H⁰(Spec(F_q), F) = F(Spec(F_q)) = global sections.
; H¹(Spec(F_q), μ_n) via the Kummer sequence.
; ============================================================

(print "=== Étale Cohomology of Spec(F_q) ===")

; ------------------------------------------------------------
; Machinery — finite fields F_{p^d} = Z/pZ[x]/(f) as coefficient lists
; (LOW to HIGH), f monic irreducible of degree d.
; ------------------------------------------------------------
(define (zn a m) (mod (+ (mod a m) m) m))
(define (zeros k) (cond ((<= k 0) nil) (t (cons 0 (zeros (- k 1))))))
(define (padto p dd) (append p (zeros (- dd (length p)))))
(define (coefat p i) (cond ((< i 0) 0) ((>= i (length p)) 0) (t (nth i p))))
(define (vsub a b m) (map (lambda (pr) (zn (- (car pr) (cadr pr)) m)) (zip a b)))
(define (vadd a b m) (map (lambda (pr) (zn (+ (car pr) (cadr pr)) m)) (zip a b)))
(define (scale-poly c p m) (map (lambda (co) (zn (* c co) m)) p))
(define (poly-mul a b m)
  (map (lambda (k)
         (zn (foldl + 0 (map (lambda (i) (* (coefat a i) (coefat b (- k i)))) (seq 0 k))) m))
       (seq 0 (- (+ (length a) (length b)) 2))))
(define (poly-reduce p f m)
  (cond ((< (length p) (length f)) p)
        (t (let ((cc (last p)) (shift (- (length p) (length f))))
             (poly-reduce (butlast (vsub p (append (zeros shift) (scale-poly cc f m)) m)) f m)))))
(define (fdeg f) (- (length f) 1))
(define (fone f) (padto (list 1) (fdeg f)))
(define (fzero f) (zeros (fdeg f)))
(define (fmul a b f m) (padto (poly-reduce (poly-mul a b m) f m) (fdeg f)))
(define (felts dd m)
  (cond ((= dd 0) (list nil))
        (t (foldr append nil
                  (map (lambda (v) (map (lambda (c) (cons c v)) (seq 0 (- m 1))))
                       (felts (- dd 1) m))))))
(define (fpow a k f m) (cond ((= k 0) (fone f)) (t (fmul a (fpow a (- k 1) f m) f m))))
(define (frob a f m) (fpow a m f m))

; ============================================================
; 1. The étale site of Spec(F_q)
; ============================================================
; Objects: étale morphisms U → Spec(F_q).
; Since F_q is a field, étale means étale F_q-algebra = finite product
; of separable field extensions of F_q.
; The absolute Galois group Γ = Gal(\bar{F_q}/F_q) ≅ Ẑ (profinite).
; An étale sheaf F is equivalent to a discrete Γ-module.
; Hⁱ_{ét}(Spec(F_q), F) ≅ Hⁱ(Γ, F) (Galois cohomology).

(print "--- 1. Étale site of Spec(F_q) ---")
(print "Objects: finite separable F_q-algebras.")
(print "Étale cohomology ≅ Galois cohomology of Γ = Gal(F_q-bar / F_q).")

; The whole identification rests on Γ being topologically generated by the
; Frobenius, with finite quotients Gal(F_{q^n}/F_q) = Z/nZ = <Fr>.
; Verify that at the first finite level, by brute force in F_9 = F_3[x]/(x²+1):
; Fr(a) = a³ is a ring automorphism, Fr² = id, Fr ≠ id, and the fixed field
; of Fr is EXACTLY the prime field F_3 (3 elements, not 9).
(define f9 (list 1 0 1))                   ; x² + 1 over F_3
(define f9-all (felts 2 3))
(define (f9-frob a) (frob a f9 3))
(define f9-fixed (filter (lambda (a) (equal (f9-frob a) a)) f9-all))
(print "|F_9| =") (print (length f9-all))
(print "fixed field of Frobenius on F_9 =") (print f9-fixed)
(check "etale-site-Spec-Fq"
       (and (= (length f9-all) 9)
            ; Fr is additive and multiplicative on every pair — a genuine automorphism
            (every (lambda (pr)
                     (and (equal (f9-frob (vadd (car pr) (cadr pr) 3))
                                 (vadd (f9-frob (car pr)) (f9-frob (cadr pr)) 3))
                          (equal (f9-frob (fmul (car pr) (cadr pr) f9 3))
                                 (fmul (f9-frob (car pr)) (f9-frob (cadr pr)) f9 3))))
                   (foldr append nil
                          (map (lambda (a) (map (lambda (b) (list a b)) f9-all)) f9-all)))
            ; Fr has order exactly 2 => Gal(F_9/F_3) = Z/2Z
            (every (lambda (a) (equal (f9-frob (f9-frob a)) a)) f9-all)
            (any (lambda (a) (not (equal (f9-frob a) a))) f9-all)
            ; fixed field = F_3, so the extension degree matches the group order
            (= (length f9-fixed) 3)))

; ============================================================
; 2. H⁰(Spec(F_q), F) = global sections
; ============================================================
; For the constant sheaf Z/nZ: H⁰ = Z/nZ.
; For G_m: H⁰ = F_q^×.
; For μ_n: H⁰ = {x ∈ F_q | xⁿ = 1} = μ_n(F_q).

(print "--- 2. H⁰ — global sections ---")
(print "H⁰(Spec(F_q), Z/nZ) = Z/nZ.")
(print "H⁰(Spec(F_q), G_m) = F_q^×.")
; For q=5: 1²=1, 2²=4, 3²=4, 4²=1. μ₂(F_5) = {1, 4}.

; Brute force over F_q^× on one side; the cyclic-group formula |μ_n(F_q)| =
; gcd(n, q-1) on the other side.
(define (units q) (seq 1 (- q 1)))
(define (mu-n nn q) (filter (lambda (x) (= (mod (^ x nn) q) 1)) (units q)))
(define (nth-powers nn q) (sort < (dedup (map (lambda (x) (mod (^ x nn) q)) (units q)))))
(print "H⁰(Spec(F_5), μ₂) = {1,4}")
(print "brute-force μ₂(F_5) =") (print (mu-n 2 5))
(print "brute-force μ₃(F_5) =") (print (mu-n 3 5))
(check "H0-Spec-F5-mu2"
       (and (equal (mu-n 2 5) (list 1 4))
            (= (length (mu-n 2 5)) (gcd 2 4))
            ; μ₃(F_5) is trivial since gcd(3,4)=1 — the same routine, a different answer
            (equal (mu-n 3 5) (list 1))
            (= (length (mu-n 3 5)) (gcd 3 4))
            ; and H⁰(G_m) = F_q^× has order q-1
            (= (length (units 5)) 4)))

; ============================================================
; 3. H¹(Spec(F_q), μ_n) via Kummer sequence
; ============================================================
; Kummer exact sequence of étale sheaves:
; 1 → μ_n → G_m → G_m → 1  (the map is x ↦ xⁿ)
; Long exact sequence gives:
; 1 → H⁰(μ_n) → H⁰(G_m) → H⁰(G_m) → H¹(μ_n) → H¹(G_m) → ...
; i.e., 1 → μ_n(F_q) → F_q^× → F_q^× → H¹(μ_n) → H¹(G_m,F_q^×) = 0 (Hilbert 90)
; So: H¹(Spec(F_q), μ_n) = F_q^×/(F_q^×)^n.
;
; For q=5, n=2:
; F_5^× = {1, 2, 3, 4}
; (F_5^×)² = {1², 2², 3², 4²} = {1, 4} (since 2² = 4, 3² = 9 ≡ 4 mod 5).
; H¹ = F_5^×/(F_5^×)² ≅ {1, 2, 3, 4}/{1, 4} ≅ Z/2Z.

(print "--- 3. H¹(Spec(F_5), μ₂) via Kummer sequence ---")
(print "Kummer: 1 → μ₂ → G_m →² G_m → 1")
(print "H¹(Spec(F_5), μ₂) = F_5^×/(F_5^×)²")
(define F5x (list-to-set (units 5)))
(define F5x2 (list-to-set (nth-powers 2 5)))   ; computed image of x ↦ x², not hand-written
(print "F_5^× =") (print F5x)
(print "(F_5^×)² = {1,4}:") (print F5x2)
(print "Quotient size = |F_5^×|/|(F_5^×)²| = 4/2 = 2")
(print "H¹ = Z/2Z.")
(check "H1-Spec-F5-mu2-is-Z2" (= (length F5x) (* 2 (length F5x2))))

; ============================================================
; 4. Verify for q=7, n=3
; ============================================================
; F_7^× = {1,2,3,4,5,6} (order 6).
; (F_7^×)³: 1³ = 1, 2³ = 8 ≡ 1, 3³ = 27 ≡ 6, 4³ = 64 ≡ 1, 5³ = 125 ≡ 6, 6³ = 216 ≡ 6.
; So (F_7^×)³ = {1,6}.
; H¹ = F_7^×/(F_7^×)³ ≅ Z/3Z (since |F_7^×|=6, |(F_7^×)³|=2, 6/2=3).

(print "--- 4. H¹(Spec(F_7), μ₃) ---")
(print "F_7^× = {1,2,3,4,5,6} (order 6)")
(print "(F_7^×)³ = {1,6} (order 2)")
(print "H¹ = Z/6Z / Z/2Z ≅ Z/3Z.")

; |H¹(Spec F_q, μ_n)| = |F_q^×| / |(F_q^×)^n|, both sides brute-forced,
; then compared against the independent formula gcd(n, q-1).
(define (h1-mu-order nn q) (/ (- q 1) (length (nth-powers nn q))))
(define qn-cases (list (list 2 5) (list 3 5) (list 2 7) (list 3 7)
                       (list 6 7) (list 4 13) (list 5 11)))
(print "(F_7^×)³ computed =") (print (nth-powers 3 7))
(print "cases (n q):") (print qn-cases)
(print "brute-force |H¹(μ_n)|:")
(print (map (lambda (pr) (h1-mu-order (car pr) (cadr pr))) qn-cases))
(print "gcd(n, q-1):")
(print (map (lambda (pr) (gcd (car pr) (- (cadr pr) 1))) qn-cases))
(check "H1-Spec-F7-mu3-is-Z3"
       (and (equal (nth-powers 3 7) (list 1 6))
            (= (h1-mu-order 3 7) 3)
            (equal (map (lambda (pr) (h1-mu-order (car pr) (cadr pr))) qn-cases)
                   (map (lambda (pr) (gcd (car pr) (- (cadr pr) 1))) qn-cases))))

; ============================================================
; 5. H¹(Spec(F_q), Z/nZ) for constant sheaf
; ============================================================
; For constant sheaf Z/nZ with trivial Galois action:
; H¹(Spec(F_q), Z/nZ) = Hom_cont(Γ, Z/nZ) = Hom(Ẑ, Z/nZ) = Z/nZ.
; Since Γ = Ẑ is topologically generated by Frobenius,
; continuous homomorphisms Γ → Z/nZ correspond to choosing the image of Fr,
; which is any element of Z/nZ.
; So H¹ = Z/nZ.

(print "--- 5. H¹(Spec(F_q), Z/nZ) constant sheaf ---")
(print "Γ = Ẑ, continuous Hom(Ẑ, Z/nZ) = Z/nZ.")
(print "H¹(Spec(F_q), Z/nZ) = Z/nZ.")

; Brute force: a continuous cocycle on Γ = Ẑ factors through some finite
; quotient Z/kZ. Represent c by the list (c(g⁰) c(g¹) ... c(g^{k-1})) and search
; ALL m^k functions for the ones satisfying c(i+j) = c(i) + c(j) (the action is
; trivial). The action being trivial also makes every coboundary 0, so H¹ = Z¹.
(define (tuples kk m)
  (cond ((= kk 0) (list nil))
        (t (foldr append nil
                  (map (lambda (v) (map (lambda (c) (cons c v)) (seq 0 (- m 1))))
                       (tuples (- kk 1) m))))))
(define (allpairs la lb)
  (foldr append nil (map (lambda (i) (map (lambda (j) (list i j)) lb)) la)))
(define (triv-cocycle-p c kk m)
  (and (= (nth 0 c) 0)
       (every (lambda (pr) (= (nth (mod (+ (car pr) (cadr pr)) kk) c)
                              (mod (+ (nth (car pr) c) (nth (cadr pr) c)) m)))
              (allpairs (seq 0 (- kk 1)) (seq 0 (- kk 1))))))
(define (z1-count kk m) (count (lambda (c) (triv-cocycle-p c kk m)) (tuples kk m)))

(define km-cases (list (list 2 2) (list 3 3) (list 4 2) (list 3 2) (list 4 4) (list 2 4)))
(print "(k m) cases:") (print km-cases)
(print "exhaustive |Z¹(Z/kZ, Z/mZ)|:")
(print (map (lambda (pr) (z1-count (car pr) (cadr pr))) km-cases))
(print "gcd(k,m):")
(print (map (lambda (pr) (gcd (car pr) (cadr pr))) km-cases))
(check "H1-constant-sheaf"
       (and (equal (map (lambda (pr) (z1-count (car pr) (cadr pr))) km-cases)
                   (map (lambda (pr) (gcd (car pr) (cadr pr))) km-cases))
            ; Hom_cont(Ẑ, Z/mZ) = Z/mZ: at the level k = m all m homs appear
            (every (lambda (m) (= (z1-count m m) m)) (list 2 3 4))))

(print "=== Étale Cohomology Done ===")
