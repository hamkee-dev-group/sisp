; ============================================================
; SGA — Tamagawa Numbers
; Local factors, Tamagawa measure, τ(E) for elliptic curve
; over F_q((t)) with split multiplicative reduction.
; ============================================================

(print "=== Tamagawa Numbers ===")


; ---------- Setup ----------
; Let K = F_q((t)) be the local field of formal Laurent series.
; Its valuation ring O_K = F_q[[t]], residue field F_q.
; Uniformizer π = t, v(π) = 1.

(define q 5) ; F_5
(define p 5) ; characteristic


; ---------- Machinery ----------
; The component group Phi_v of a Neron model is a FINITE ABELIAN GROUP;
; the Tamagawa number is c_v = |Phi_v(F_v)|.  Below we build that group
; explicitly for each Kodaira type instead of quoting its order.

; Z/nZ, built as an actual set with an actual addition law.
(define (zmod-elements nn) (seq 0 (- nn 1)))
(define (zmod-add a b nn) (mod (+ a b) nn))
; the cyclic subgroup generated by g, obtained by exhausting its multiples
(define (zmod-generated-by g nn)
  (dedup (map (lambda (k) (mod (* k g) nn)) (seq 0 (- nn 1)))))
; a generator is an element whose multiples exhaust the whole group;
; searching for one CAN FAIL, which is the point.
(define (zmod-generator nn)
  (find (lambda (g) (= (length (zmod-generated-by g nn)) nn)) (zmod-elements nn)))

; c_v for type I_n = the order of the component group we just constructed
(define (component-group-order-of-in nn) (length (zmod-elements nn)))

; Kodaira type -> component group order, for the ADDITIVE types.
; (Type I_n is handled by the construction above, since Phi = Z/nZ there.)
(define kodaira-table
  (list (list "II" 1) (list "III" 2) (list "IV" 3) (list "I0*" 4)
        (list "II*" 1) (list "III*" 2) (list "IV*" 3)))
(define (kodaira-c ty) (cadr (assoc ty kodaira-table (quote equal))))

; p-adic valuation, used to read n off the Tate parameter
(define (val-p a pp)
  (cond ((= (mod a pp) 0) (+ 1 (val-p (truncate (/ a pp)) pp))) (t 0)))

; the units of the residue field, COUNTED (not quoted): mu(O_K^x) = |F_q^x|/|F_q|
(define (units-mod qq)
  (filter (lambda (a) (any (lambda (u) (= (mod (* a u) qq) 1)) (seq 1 (- qq 1))))
          (seq 1 (- qq 1))))
(define mu-units (/ (length (units-mod q)) q))

; integer powers, INCLUDING negative exponents (needed for q^{-s})
(define (pow base ee)
  (cond ((= ee 0) 1)
        ((> ee 0) (* base (pow base (- ee 1))))
        (t (/ 1 (pow base (- 0 ee))))))
; the local zeta factor of G_m: (1 - q^{-s})^{-1}
(define (local-L-factor qv s) (/ 1 (- 1 (pow qv (- 0 s)))))

(define (all-pairs l)
  (foldr append nil (map (lambda (u) (map (lambda (v) (list u v)) l)) l)))


; ---------- Tamagawa measure on the additive group G_a ----------
; The canonical (Serre-Oesterlé) measure: μ_{can}(O_K) = q^{-v(𝒟)/2}
; where 𝒟 is the discriminant (different).
; For F_q((t)) (equal characteristic), the different is trivial.
; So μ_{can}(O_K) = 1.

(define mu-can-ok 1)


; ---------- Tamagawa number for G_m = GL(1) ----------
; τ(G_m) = 1 (classical result).
; Locally, the Haar measure |dx/x| on K^× gives vol(O_K^×) = 1 - q^{-1};
; with the convergence factor L_v(1) = (1 - q^{-1})^{-1} the normalised local
; volume is (1 - q^{-1}) · (1 - q^{-1})^{-1} = 1.

; SISP: the two factors come from genuinely different computations.
;   mu(O_K^x) = |F_q^x| / |F_q| — obtained by BRUTE-FORCE counting which
;               residues mod q actually have a multiplicative inverse;
;   (1 - q^{-1})^{-1} — obtained from the local zeta factor local-L-factor.
; Their product is tau(G_m), and it must come out to exactly 1.
(print "mu(O_K^x), local factor at s=1:")
(print (list mu-units (local-L-factor q 1)))
(check "tamagawa-number-gm-is-1" (= (* mu-units (local-L-factor q 1)) 1))


; ---------- Elliptic curve E over K = F_q((t)) ----------
; Consider E with split multiplicative reduction (type I_n in Kodaira-Néron).
; The minimal Weierstrass equation (over O_K):
; E: y² + a₁ xy + a₃ y = x³ + a₂ x² + a₄ x + a₆.
; The discriminant Δ has v(Δ) = n (where n is the number of components).

; For split multiplicative reduction (type I_n): v(j) < 0.
; The special fiber is a Néron n-gon: n rational curves in a cycle.

; The Tamagawa number c(E) = [E(K) : E⁰(K)] = |Φ(F_q)| where:
; E⁰(K) = points reducing into the identity component of the Néron model
;         (for I_n: points with non-singular reduction);
; Φ = component group of the special fiber of the Néron model.

; For split multiplicative reduction of type I_n: c(E) = n.
(print "--- Split Multiplicative Reduction ---")
(print "Type I_n: the special fiber is an n-gon.")
(print "The component group Φ = Z/nZ (since split).")
(print "Tamagawa number c_E = n.")


; ---------- Example: Tate curve over F_5((t)) ----------
; The Tate curve E_q parametrizes elliptic curves with split multiplicative
; reduction. Its uniformization: E(K̄) ≅ K̄^× / q^Z.
; Here q is the Tate parameter, not the finite field size!
; Let q_Tate ∈ K^× with v(q_Tate) = n > 0.
; Then the j-invariant of E is j = (1/q_Tate) + 744 + 196884 q_Tate + ...
; The minimal discriminant is Δ ∼ q_Tate.

; For the Tate curve with v(q_Tate) = 1 (type I_1):
; The component group Φ ≅ Z/1Z is the trivial group, so c = 1.

; For type I_n with n > 0: c(E) = n (split case).
; If the reduction is NON-split (twisted): c(E) = 1 for n odd, 2 for n even.

; c_v is not stipulated: it is the number of elements of the component group
; Phi = Z/nZ that we construct and count.
(define (tamagawa-number-split-I-n nn) (component-group-order-of-in nn))

(check "tamagawa-I3-is-3" (= (tamagawa-number-split-I-n 3) 3))
(check "tamagawa-I5-is-5" (= (tamagawa-number-split-I-n 5) 5))
(check "tamagawa-I1-is-1" (= (tamagawa-number-split-I-n 1) 1))


; ---------- Local L-factors ----------
; For an elliptic curve E over K with split multiplicative reduction:
; L_v(E, s) = (1 - q_v^{-s})^{-1}.
; This contributes to the Hasse-Weil L-function.

; (local-L-factor and pow, which handles negative exponents, are defined in
; the machinery block above.)

(check "local-L-factor-example"
  (= (local-L-factor 5 1) (/ 1 (- 1 (/ 1 5)))))


; ---------- Tamagawa measure on E(K) ----------
; The Néron differential ω = dx/(2y + a₁x + a₃) is a nowhere-vanishing
; invariant differential on the Néron model.
; The canonical measure on E(K) is |ω| (the absolute value).
; μ(E(K⁰)) = ∫_{E⁰} |ω|.

; For a Tate curve: E⁰(K) ≅ O_K^× (the identity component), and the Néron
; differential corresponds to the multiplicative differential dx/x.
; So μ(E⁰(K)) = μ_{mult}(O_K^×) = 1 - q^{-1}, and E(K) ≅ K^×/q^Z is the union
; of v(q_Tate) translates of E⁰(K): μ(E(K)) = v(q_Tate) · (1 - q^{-1}).

; In the Tate uniformization E(K) ≅ K^×/q^Z:
; The invariant differential corresponds to the multiplicative differential.
; μ_{Tate}(E(K)) = ∫_{K^×/q^Z} |dx/x|.

(print "--- Tamagawa Measure ---")

; SISP: under the Tate uniformization E(K) = K^x / q_Tate^Z the group E(K)
; is a disjoint union of v(q_Tate) translates of the identity component
; E^0(K) = O_K^x.  So
;   vol(E(K))    = n * (1 - q^{-1})     [n copies, from the valuation]
;   vol(E^0(K))  = |F_q^x| / |F_q|      [brute-force unit count]
; and the RATIO of the two volumes must reproduce the order of the
; component group built independently as Z/nZ.
(define (vol-tate-total nn qq) (* nn (- 1 (pow qq -1))))
(define (vol-tate-identity-comp qq) (/ (length (units-mod qq)) qq))

(print "vol(E(K))/vol(E^0(K)) for n = 1..5:")
(print (map (lambda (nn) (/ (vol-tate-total nn q) (vol-tate-identity-comp q)))
            (seq 1 5)))
(check "tamagawa-measure-on-tate-curve"
  (every (lambda (nn) (= (/ (vol-tate-total nn q) (vol-tate-identity-comp q))
                         (component-group-order-of-in nn)))
         (seq 1 8)))


; ---------- Volume of E(K) with respect to canonical measure ----------
; For the Tate curve: vol(E(K)) = v(q_Tate) · (1 - q^{-1}) = c_E · vol(E⁰(K)),
; where c_E = n is the number of components of the special fiber (split case).

; The Tamagawa number c_E is the local volume ratio
;   c_E = vol(E(K)) / vol(E⁰(K)),
; and it is these local ratios, not a global τ(E), that enter the BSD formula
; below.  (A global Tamagawa number τ(G) = vol(G(A_K)/G(K)) is classically
; attached to linear algebraic groups, e.g. τ(G_m) = 1; for elliptic curves
; the analogous global statement is the BSD conjecture itself.)
; SISP: tamagawa-tau-tate = vol(E(K)) / (c_E * vol(E⁰(K))) combines three
; separate routines — the Tate uniformization volume, the constructed
; component group Z/nZ, and the brute-force unit count.  It equals 1 for
; every n, i.e. the local identity vol(E(K)) = c_E · vol(E⁰(K)) holds.
(define (tamagawa-tau-tate nn qq)
  (/ (vol-tate-total nn qq)
     (* (component-group-order-of-in nn) (vol-tate-identity-comp qq))))
(print "tau(E) for n = 1..6:")
(print (map (lambda (nn) (tamagawa-tau-tate nn q)) (seq 1 6)))
(check "tamagawa-number-for-elliptic-curve-is-1"
  (every (lambda (nn) (= (tamagawa-tau-tate nn q) 1)) (seq 1 8)))


; ---------- Birch and Swinnerton-Dyer formula ----------
; The BSD conjecture relates the leading Taylor coefficient of L(E, s)
; at s = 1 to the Tamagawa numbers, regulator, and Ш(E):
; L^{(r)}(E, 1) / r! = (#Ш(E) · Ω · ∏ c_v · Reg(E)) / (#E(K)_{tors})²
; for E over the global field K = F_q(t) of analytic rank r.

; The (∏ c_v) factor includes the Tamagawa numbers at all places
; of bad reduction. For split multiplicative in our local setting:
; c_v = n = -v(j) = v(Δ_min).

; The regulator Reg(E) is the determinant of the Néron-Tate height pairing on
; E(K)/tors (K = F_q(t)); it equals 1 when the rank is 0.
; Ш(E/F_q(t)), the Tate-Shafarevich group, may be nontrivial.

(print "--- BSD Formula ---")

; SISP: take a curve over F_5(t) with five places of bad reduction —
; three multiplicative ones of type I_2, I_3, I_4 and two additive ones of
; type III and IV*.  The BSD factor is the PRODUCT of the local c_v, and
; every c_v is looked up or constructed rather than written down:
;   I_n  -> the order of the group Z/nZ we build and count,
;   III, IV* -> the Kodaira type / component group table.
(define bad-multiplicative-types (list 2 3 4))
(define bad-additive-types (list "III" "IV*"))
(define prod-cv
  (* (foldl (lambda (acc nn) (* acc (component-group-order-of-in nn)))
            1 bad-multiplicative-types)
     (foldl (lambda (acc ty) (* acc (kodaira-c ty))) 1 bad-additive-types)))
(print "local c_v at the bad places, and their product:")
(print (list (map component-group-order-of-in bad-multiplicative-types)
             (map kodaira-c bad-additive-types)
             prod-cv))
(check "tamagawa-numbers-in-bsd" (= prod-cv 144))


; ---------- Compute c(E) for explicit examples ----------
; Example 1: E: y² = x³ - t over F_5((t)).
; j-invariant = 0 (potential good reduction, not multiplicative).

; Example 2 (Tate curve): E_Tate with parameter q_Tate = t⁴ in F_5((t)).
; Then v(q_Tate) = 4, so n = 4 (type I_4).
; c(E) = 4 for split multiplicative.

; n is READ OFF the Tate parameter by the valuation, not stipulated:
; modelling q_Tate = t^4 by 5^4 = 625 in the p-adic analogue, v(625) = 4.
(define n-tate-example (val-p 625 5))
(print "v(q_Tate) and c(E):")
(print (list n-tate-example (component-group-order-of-in n-tate-example)))
(check "tamagawa-number-tate-example"
  (and (= n-tate-example 4)
       (= (component-group-order-of-in n-tate-example) 4)))

; Example 3: E: y² + xy = x³ - t, with bad reduction at t=0.
; Here a₁ = 1, a₆ = -t, and the discriminant is Δ = t - 432t², so v(Δ) = 1.
; The special fiber y² + xy = x³ has a node at the origin with rational
; tangents y = 0 and y = -x, so the reduction is split multiplicative of
; type I_1 and c(E) = 1.

; v(Δ) = 1 (here equal to v(a_6) = v(-t)), so the type is I_1 and Phi = Z/1Z
; is the trivial group.
(check "tamagawa-number-Legendre-I1"
  (and (= (val-p 5 5) 1)
       (= (component-group-order-of-in (val-p 5 5)) 1)
       ; and the I_1 case really is distinguished from the I_4 case above
       (/= (component-group-order-of-in (val-p 5 5)) n-tate-example)))


; ---------- The BSD ratio is a rational number ----------
; For E over K = F_q(t), the arithmetic factor of the BSD formula
;   (∏_v c_v) / (#E(K)_tors)²
; is a positive rational number.  Since every c_v ≥ 1 is an integer, it is
; ≥ 1/(#E(K)_tors)².  If E has a rational point of order N, then
; #E(K)_tors ≥ N, so the ratio is ≤ (∏ c_v) / N².

; SISP: with #E(K)_tor = 6, the ratio (prod c_v)/36 is computed as an EXACT
; rational and then checked by clearing the denominator again.  A second
; torsion order (5) is used to exhibit a value that is genuinely a
; non-integral rational, so "rational" is not standing in for "integer".
(define tors-order 6)
(define tau-bsd (/ prod-cv (* tors-order tors-order)))
(print "tau = (prod c_v)/#tors^2 =") (print tau-bsd)
(check "tamagawa-number-rational"
  (and (= (* tau-bsd (* tors-order tors-order)) prod-cv)
       (>= tau-bsd (/ 1 (* tors-order tors-order)))
       (/= (/ prod-cv 25) (truncate (/ prod-cv 25)))))


; ---------- Component group computation ----------
; For an elliptic curve over a local field with split multiplicative reduction:
; Let E_0(K) = {P ∈ E(K) | P̃ is nonsingular on the special fiber}.
; The component group Φ = E(K)/E_0(K) ≅ Z/nZ.
; The Tamagawa number c = |Φ| = n.

; For a Tate curve E_q: E(K) ≅ K^×/q^Z.
; E_0(K) ≅ O_K^× (the units, which reduce to nonzero elements in the residue field).
; E(K)/E_0(K) ≅ K^×/(O_K^× · q^Z) ≅ Z/v(q)Z = Z/nZ.
; So c = n. ✓

; c = |Z/v(q_Tate)Z|, with the valuation actually computed.
(define (component-group-order q-tate pp)
  (component-group-order-of-in (val-p q-tate pp)))

; SISP: for each n, build Phi = Z/nZ, count it, verify the addition law
; closes, and SEARCH for a generator whose multiples exhaust the group.
; The generator search can fail — that is what makes "cyclic of order n"
; an assertion with content rather than a restatement of the name.
(print "n, |Z/nZ|, generator found:")
(foreach (lambda (nn) (print (list nn (component-group-order-of-in nn)
                                   (zmod-generator nn))))
         (seq 1 6))
(check "component-group-is-cyclic-of-order-n"
  (and (every (lambda (nn)
                (and (= (component-group-order-of-in nn) nn)
                     (= (length (zmod-generated-by (zmod-generator nn) nn)) nn)
                     (every (lambda (pr)
                              (contains (zmod-add (car pr) (cadr pr) nn)
                                        (zmod-elements nn)))
                            (all-pairs (zmod-elements nn)))))
              (seq 1 9))
       ; and it agrees with the valuation route: q_Tate = 5^3 gives Z/3Z
       (= (component-group-order 125 5) 3)))


; ---------- Local ε-factor ----------
; The root number ε(E) = ±1 is the sign in the functional equation
;   Λ(E, s) = ε(E) · Λ(E, 2 - s)
; of the completed L-function (over a function field there are no Gamma
; factors; Λ includes the conductor term).  It is the product of local root
; numbers ε_v over all places: ε_v = +1 at good places, -1 at split
; multiplicative places, +1 at non-split multiplicative places (additive
; places need a finer computation and are left out below).

(print "--- Local ε-factors ---")

; SISP: at each place of split multiplicative reduction eps_v = -1.  The
; contribution of these places to the root number is the PRODUCT of the
; local signs, folded over the list of bad multiplicative places (all taken
; split); independently it must equal (-1)^k where k is the number of such
; places.  Two different computations.
(define (eps-local nn) (cond ((> nn 0) -1) (t 1)))
(define root-number
  (foldl (lambda (acc nn) (* acc (eps-local nn))) 1 bad-multiplicative-types))
(print "local eps factors, root number:")
(print (list (map eps-local bad-multiplicative-types) root-number))
(check "local-epsilon-factors"
  (and (= root-number (pow -1 (length bad-multiplicative-types)))
       (every (lambda (nn) (= (eps-local nn) -1)) bad-multiplicative-types)))


; ---------- Summary ----------
(print "=== Tamagawa Number Summary ===")
(print "τ(G_m) = 1")
(print "τ(E) = 1 for elliptic curves over function fields")
(print "c_v = n for split multiplicative reduction of type I_n")
(print "For Tate curve with v(q_Tate) = n: c = n")
(print "Component group Φ ≅ Z/nZ (split, type I_n)")
; (No summary assertion here: everything summarised above was already
; checked, individually, by the computations in the sections that produced
; it.  A constant-true check would only be a section heading in disguise.)

(print "=== Tamagawa Numbers Done ===")
