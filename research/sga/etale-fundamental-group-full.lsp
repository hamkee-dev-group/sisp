; ============================================================
; SGA -- Etale Fundamental Group: Full Galois Correspondence
; for Finite Etale Covers. pi1(Spec(F_q)) = Z-hat.
; Fundamental Exact Sequence. Specialization Map.
; ============================================================

(print "=== Etale Fundamental Group (Full) ===")

; ============================================================
; 1. pi1(Spec(F_q)) = Z-hat (PROFINITE COMPLETION OF Z)
; ============================================================
; The etale fundamental group of Spec(F_q) (with geometric point
; Spec(F_q-bar)) is the absolute Galois group:
;   pi1(Spec(F_q), F_q-bar) = Gal(F_q-bar/F_q) ≅ Z-hat.
; Z-hat = lim_{← n} Z/nZ, the profinite completion of Z.
; Topological generator: geometric Frobenius Fr(x) = x^{1/q}.

(print "--- 1. pi1(Spec(F_q)) = Z-hat ---")
(print "pi1(Spec(F_q)) = Gal(F_q-bar/F_q) ≅ Z-hat = lim Z/nZ")
(print "Generator: geometric Frobenius Fr(x) = x^{1/q}")

; ------------------------------------------------------------
; Machinery: F_{p^d} = F_p[x]/(f), elements are coefficient lists low->high.
; Everything about Frobenius below is computed in these fields.
; ------------------------------------------------------------
(define (zz a mm) (mod (+ (mod a mm) mm) mm))
(define (zeros k) (cond ((<= k 0) nil) (t (cons 0 (zeros (- k 1))))))
(define (padto pl dd) (append pl (zeros (- dd (length pl)))))
(define (coefat pl i) (cond ((< i 0) 0) ((>= i (length pl)) 0) (t (nth i pl))))
(define (vsub a b mm) (map (lambda (pr) (zz (- (car pr) (cadr pr)) mm)) (zip a b)))
(define (vadd a b mm) (map (lambda (pr) (zz (+ (car pr) (cadr pr)) mm)) (zip a b)))
(define (scal c pl mm) (map (lambda (co) (zz (* c co) mm)) pl))
(define (pmul a b mm)
  (map (lambda (k)
         (zz (foldl + 0 (map (lambda (i) (* (coefat a i) (coefat b (- k i)))) (seq 0 k))) mm))
       (seq 0 (- (+ (length a) (length b)) 2))))
(define (preduce pl f mm)
  (cond ((< (length pl) (length f)) pl)
        (t (let ((cc (last pl)) (sh (- (length pl) (length f))))
             (preduce (butlast (vsub pl (append (zeros sh) (scal cc f mm)) mm)) f mm)))))
(define (fdeg f) (- (length f) 1))
(define (fone f) (padto (list 1) (fdeg f)))
(define (fzero f) (zeros (fdeg f)))
(define (fmul a b f mm) (padto (preduce (pmul a b mm) f mm) (fdeg f)))
(define (felts dd mm)
  (cond ((= dd 0) (list nil))
        (t (foldr append nil
             (map (lambda (v) (map (lambda (c) (cons c v)) (seq 0 (- mm 1))))
                  (felts (- dd 1) mm))))))
(define (fpow a k f mm) (cond ((= k 0) (fone f)) (t (fmul a (fpow a (- k 1) f mm) f mm))))
(define (frob a f mm) (fpow a mm f mm))
(define (frob-iter a k f mm)
  (cond ((= k 0) a) (t (frob-iter (frob a f mm) (- k 1) f mm))))
; smallest k >= 1 with Fr^k = identity on the whole field
(define (frob-order f mm)
  (find (lambda (k) (every (lambda (a) (equal (frob-iter a k f mm) a)) (felts (fdeg f) mm)))
        (seq 1 (+ (fdeg f) 3))))
(define (frob-fixed f mm)
  (filter (lambda (a) (equal (frob a f mm) a)) (felts (fdeg f) mm)))

(define f9  (list 1 0 1))          ; x^2 + 1      -> F_9  over F_3
(define f27 (list 1 2 0 1))        ; x^3 + 2x + 1 -> F_27 over F_3

; SISP: pi1(Spec F_q) = Gal(F_q-bar/F_q) is PROCYCLIC, generated by
; Frobenius, with finite quotients Gal(F_{q^n}/F_q) = Z/nZ.  Compute the
; exact order of Frobenius in F_9 and F_27 and the size of its fixed field;
; then check that the inverse system Z/mn ->> Z/n whose limit is Z-hat
; really is surjective and carries generator to generator (procyclicity).
(define (reduce-mod mn nn) (lambda (k) (mod k nn)))
(define (surjective-onto f dom cod) (equal (sort < (dedup (map f dom))) (sort < cod)))

(print "order of Frobenius on F_9, F_27:")
(print (list (frob-order f9 3) (frob-order f27 3)))
(print "fixed field of Frobenius (must be F_3, 3 elements):")
(print (list (length (frob-fixed f9 3)) (length (frob-fixed f27 3))))

(check "pi1-Spec-Fq-is-Zhat"
  (and ; Gal(F_{3^n}/F_3) is cyclic of order exactly n
       (= (frob-order f9 3) (fdeg f9))
       (and (= (frob-order f27 3) (fdeg f27))
            (and ; fixed field is the base field F_3 in both cases
                 (and (= 3 (length (frob-fixed f9 3))) (= 3 (length (frob-fixed f27 3))))
                 ; Z-hat = lim Z/nZ: the transition maps are onto ...
                 (and (every (lambda (pr)
                               (surjective-onto (reduce-mod (car pr) (cadr pr))
                                                (seq 0 (- (car pr) 1))
                                                (seq 0 (- (cadr pr) 1))))
                             (list (list 6 2) (list 6 3) (list 12 4) (list 12 6)))
                      ; ... and the system is compatible: Z/12 -> Z/6 -> Z/2
                      ; agrees with Z/12 -> Z/2 on every element
                      (every (lambda (k) (= (mod (mod k 6) 2) (mod k 2))) (seq 0 11)))))))

; ============================================================
; 2. FULL GALOIS CORRESPONDENCE
; ============================================================
; There is an equivalence of categories:
;   (finite etale covers of Spec(F_q)) ≅ (finite discrete Z-hat-sets)
;
; Under this equivalence:
; - A connected etale cover (finite separable field extension F_{q^n}/F_q)
;   corresponds to a transitive Z-hat-set with n elements.
; - The Galois group Gal(F_{q^n}/F_q) ≅ Z/nZ corresponds to the quotient
;   of Z-hat acting on the finite set.
; - Homs of etale algebras ↔ Z-hat-equivariant maps of finite sets.
;
; The Galois correspondence:
;   {connected finite etale covers} ↔ {open subgroups of Z-hat}
;   {intermediate etale covers} ↔ {subgroups between Z-hat and an open subgroup}

(print "--- 2. Full Galois correspondence ---")
(print "Finite etale covers of Spec(F_q) = finite Z-hat-sets")
(print "Connected degree-n cover ↔ Z-hat set with n elements (transitive)")
(print "F_{q^n} ↔ Z/nZ-set (cyclic of size n)")

; Verification for F_4/F_2:
; F_4 = F_2[x]/(x^2+x+1), degree 2 extension.
; Corresponds to Z/2Z-set (2-point set with Z/2Z action).
; Z-hat → Z/2Z is the quotient map.

; SISP: F_4 = F_2[x]/(x^2+x+1).  Its fibre over the geometric point is the
; SET OF ROOTS of x^2+x+1 in F_4, found by exhaustive evaluation; Frobenius
; a -> a^2 permutes that set.  The cover corresponds to a transitive
; 2-element Z-hat-set exactly when the roots are 2 in number and Frobenius
; swaps them (one orbit, not two fixed points).
(define f4 (list 1 1 1))                      ; x^2 + x + 1 over F_2
(define (feval-poly cs a f mm)
  (foldr (lambda (c acc) (vadd (padto (list (zz c mm)) (fdeg f)) (fmul a acc f mm) mm))
         (fzero f) cs))
(define f4-roots
  (filter (lambda (a) (equal (feval-poly f4 a f4 2) (fzero f4))) (felts 2 2)))
(define (orbit-of a f mm)
  (dedup (map (lambda (k) (frob-iter a k f mm)) (seq 0 (- (frob-order f mm) 1)))))

(print "F_4 = F_2[x]/(x^2+x+1); roots of x^2+x+1 in F_4:") (print f4-roots)
(print "Frobenius image of the first root:") (print (frob (car f4-roots) f4 2))
(print "Frobenius orbit of the first root:") (print (orbit-of (car f4-roots) f4 2))

(check "F4-corresponds-to-Z2-set"
  (and (= 2 (length f4-roots))                        ; the fibre has 2 points
       (and (= 2 (frob-order f4 2))                   ; Gal(F_4/F_2) = Z/2Z
            (and ; the action is TRANSITIVE: one orbit covering both roots
                 (= 2 (length (orbit-of (car f4-roots) f4 2)))
                 (and (not (equal (frob (car f4-roots) f4 2) (car f4-roots)))
                      ; and Frobenius really swaps them, squaring to the identity
                      (equal (frob-iter (car f4-roots) 2 f4 2) (car f4-roots)))))))

; ============================================================
; 3. THE FUNDAMENTAL EXACT SEQUENCE
; ============================================================
; For a proper smooth geometrically connected curve X/F_q:
;   1 → pi1(X ⊗ F_q-bar) → pi1(X) → pi1(Spec(F_q)) → 1
;
; This relates the arithmetic fundamental group pi1(X) to the geometric
; fundamental group pi1(X-bar) and the absolute Galois group.
;
; For X = P^1: pi1(P^1-bar) = 1 (trivial, simply connected over alg. closed
; field), so pi1(P^1_{F_q}) = pi1(Spec(F_q)) = Z-hat.
;
; For X = E (elliptic curve): pi1(E-bar) is abelian, equal to the full Tate
; module T(E) = lim E[n] ≅ (∏_{ℓ≠p} Z_ℓ)² × T_p(E), where T_p(E) ≅ Z_p
; (ordinary E) or 0 (supersingular E), p = char F_q.  Its prime-to-p part
; is two copies of the prime-to-p completion of Z (over C it would be Z-hat²).
; The sequence: 1 → T(E) → pi1(E) → Z-hat → 1.
;
; This sequence splits: the rational point O gives a section Spec(F_q) → E,
; hence a section of pi1(E) → Z-hat, so pi1(E) ≅ T(E) ⋊ Z-hat, with Z-hat
; acting through the Galois (Frobenius) action on the Tate module.

(print "--- 3. Fundamental exact sequence ---")
(print "1 → pi1(X-bar) → pi1(X) → pi1(Spec(F_q)) → 1")
(print "For P^1: pi1(P^1-bar)=1, so pi1(P^1_Fq) = Z-hat")
(print "For E: pi1(E-bar)=Z-hat^2, pi1(E) is an extension")

; SISP: test EXACTNESS at a finite level of the sequence
;    1 -> pi1(X-bar) -> pi1(X) -> pi1(Spec F_q) -> 1.
; The finite quotients are 0 -> Z/nZ --(times m)--> Z/mnZ --(mod m)--> Z/mZ -> 0.
; Injectivity, surjectivity and image = kernel are all decided by
; enumerating the groups; nothing is assumed.
(define (incl nn mm) (lambda (a) (mod (* mm a) (* mm nn))))
(define (proj mm) (lambda (b) (mod b mm)))
(define (exact-at nn mm)
  (let* ((gi (map (incl nn mm) (seq 0 (- nn 1))))
         (ker (filter (lambda (b) (= 0 (mod b mm))) (seq 0 (- (* mm nn) 1)))))
    (and ; injective on the left
         (= nn (length (dedup gi)))
         (and ; image of pi1(X-bar) equals kernel of the projection
              (equal (sort < (dedup gi)) (sort < ker))
              ; and the projection is onto pi1(Spec F_q)
              (equal (sort < (dedup (map (proj mm) (seq 0 (- (* mm nn) 1)))))
                     (seq 0 (- mm 1)))))))

(print "exactness of 0 -> Z/n -> Z/mn -> Z/m -> 0 for (n m) pairs:")
(print (map (lambda (pr) (exact-at (car pr) (cadr pr)))
            (list (list 1 5) (list 2 3) (list 3 4) (list 4 6))))
(print "P^1 case: pi1(X-bar)=1, so pi1(X) -> pi1(Spec F_q) is an isomorphism.")
(print (list (length (dedup (map (incl 1 5) (seq 0 0)))) 1))

(check "fundamental-exact-sequence"
  (and (every (lambda (pr) (exact-at (car pr) (cadr pr)))
              (list (list 1 5) (list 2 3) (list 3 4) (list 4 6) (list 2 2)))
       ; for X = P^1 the geometric group is trivial and the sequence
       ; degenerates to an isomorphism pi1(X) = pi1(Spec F_q)
       (and (= 1 (length (dedup (map (incl 1 5) (seq 0 0)))))
            (= 5 (length (dedup (map (proj 5) (seq 0 4))))))))

; ============================================================
; 4. SPECIALIZATION MAP
; ============================================================
; Let R be a henselian DVR (e.g. Z_p) with fraction field K and residue
; field k.  Restricting the Galois action to the residue field gives a
; surjection
;   pi1(Spec K) = Gal(K-bar/K) → Gal(k-bar/k) = pi1(Spec k)
; whose kernel is the inertia group I.  (For X proper and smooth over R,
; SGA 1 X also gives a specialization map pi1(X_{K-bar}) → pi1(X_{k-bar}),
; which is surjective and an isomorphism on prime-to-p quotients.)
;
; For R = Z_p, K = Q_p, k = F_p this relates pi1(Spec(Q_p)) to pi1(Spec(F_p)).

(print "--- 4. Specialization map ---")
(print "sp: pi1(Spec(K)) → pi1(Spec(k)) for DVR with residue field k")
(print "For Z_p: relates pi1(Spec(Q_p)) to pi1(Spec(F_p))")

; SISP: the specialization map is the quotient of the decomposition group by
; inertia,   1 -> I -> D -> pi1(Spec k) -> 1,
; and sp is the induced surjection D ->> Gal(k-bar/k).  At finite level take
; D = Z/eZ x Z/nZ (tame, split), I = Z/eZ x 0, sp = second projection.
; Verify by enumeration that sp is a homomorphism, is onto, that its kernel
; is exactly I, and that |D|/|ker sp| = n (first isomorphism theorem).
(define (dgroup ee nn)
  (foldr append nil (map (lambda (i) (map (lambda (j) (list i j)) (seq 0 (- nn 1))))
                         (seq 0 (- ee 1)))))
(define (dmul u v ee nn)
  (list (mod (+ (car u) (car v)) ee) (mod (+ (cadr u) (cadr v)) nn)))
(define (sp u) (cadr u))
(define (sp-ok ee nn)
  (let* ((dd (dgroup ee nn))
         (ker (filter (lambda (u) (= 0 (sp u))) dd)))
    (and ; homomorphism
         (every (lambda (pr) (= (sp (dmul (car pr) (cadr pr) ee nn))
                                (mod (+ (sp (car pr)) (sp (cadr pr))) nn)))
                (foldr append nil (map (lambda (a) (map (lambda (b) (list a b)) dd)) dd)))
         (and ; surjective onto pi1(Spec k) = Z/nZ
              (equal (sort < (dedup (map sp dd))) (seq 0 (- nn 1)))
              (and ; kernel is exactly the inertia subgroup, of order e
                   (= ee (length ker))
                   (every (lambda (u) (= 0 (cadr u))) ker))))))

(print "specialization map ok for (e n) = (1 3) (2 3) (3 4) (4 5):")
(print (map (lambda (pr) (sp-ok (car pr) (cadr pr)))
            (list (list 1 3) (list 2 3) (list 3 4) (list 4 5))))
(print "|D|, |ker sp|, |image| for e=3, n=4:")
(print (list (length (dgroup 3 4)) 3 4))

(check "specialization-map"
  (and (every (lambda (pr) (sp-ok (car pr) (cadr pr)))
              (list (list 1 3) (list 2 3) (list 3 4) (list 4 5)))
       ; first isomorphism theorem: |D| / |ker sp| = |pi1(Spec k)|
       (every (lambda (pr)
                (= (cadr pr)
                   (truncate (/ (length (dgroup (car pr) (cadr pr))) (car pr)))))
              (list (list 1 3) (list 2 3) (list 3 4) (list 4 5)))))

; ============================================================
; 5. CORRESPONDENCE FOR LOW-DEGREE COVERS
; ============================================================
; Degree-n etale covers of Spec(F_q) correspond to conjugacy classes of
; continuous homomorphisms Z-hat → S_n.  Since Z-hat is procyclic, generated
; by Frobenius, such a homomorphism is determined by one permutation, so the
; covers correspond to conjugacy classes in S_n, i.e. to partitions of n
; (cycle types).  A cover is connected iff the action is transitive, i.e.
; the permutation is an n-cycle.

(print "--- 5. Low-degree covers enumeration ---")

; For n=1: only the trivial cover F_q.
; For n=2: cycle types (1)(2) and (12): F_q × F_q and F_{q^2}.
;   2 covers, 1 connected.
; For n=3: (1)(2)(3), (12)(3), (123): F_q×F_q×F_q, F_{q^2}×F_q, F_{q^3}.
;   3 covers, 1 connected.

; A CONNECTED degree-n cover of Spec(F_q) is an open subgroup of Z-hat of
; index n, and at the finite level Z/NZ that is a subgroup of index n.
; Enumerate the subgroups of Z/NZ by brute force (each is generated by a
; single element) and count those of index n.  Counting ALL covers instead
; gives the partition numbers 1, 2, 3, 5, 7, ... (see below).
(define (subgroup-gen g nn) (sort < (dedup (map (lambda (k) (mod (* k g) nn)) (seq 0 (- nn 1))))))
(define (subgroups nn) (dedup (map (lambda (g) (subgroup-gen g nn)) (seq 0 (- nn 1)))))
(define (conn-cover-count n)
  ; work inside Z/(12n), which always contains a subgroup of index n
  (let ((big (* 12 n)))
    (count (lambda (h) (= n (truncate (/ big (length h))))) (subgroups big))))

(print "connected covers of degree 1..5 (subgroups of Z-hat of that index):")
(print (map conn-cover-count (seq 1 5)))
(check "conn-covers-degree1" (= (conn-cover-count 1) 1))
(check "conn-covers-degree2" (= (conn-cover-count 2) 1))
(check "conn-covers-degree3" (= (conn-cover-count 3) 1))
(check "conn-covers-degree4" (= (conn-cover-count 4) 1))

; Total covers (connected + disconnected): partition function
; For n=2: partitions of 2: 1+1, 2 => 2 isomorphism classes.
; For n=3: partitions: 1+1+1, 2+1, 3 => 3 classes.

; p(n), computed by the standard recursion on the largest part allowed.
(define (parts nn maxp)
  (cond ((= nn 0) 1)
        ((<= maxp 0) 0)
        ((< nn maxp) (parts nn nn))
        (t (+ (parts (- nn maxp) maxp) (parts nn (- maxp 1))))))
(define (partition-count n) (parts n n))
(print "p(1..6):") (print (map partition-count (seq 1 6)))

(check "all-covers-degree2-classes" (= (partition-count 2) 2))
(check "all-covers-degree3-classes" (= (partition-count 3) 3))
(check "all-covers-degree4-classes" (= (partition-count 4) 5))

; ============================================================
; 6. GALOIS OBJECTS
; ============================================================
; A finite etale cover A of Spec(F_q) is a Galois object if it is connected
; and Aut(A) acts transitively on the fibre F(A).  The connected covers are
; the fields F_{q^n}, and each is Galois, with Galois group
; Gal(F_{q^n}/F_q) ≅ Z/nZ (n = [A:F_q]).  A product F_q^n has Aut = S_n,
; which does act transitively on the n-point fibre, but F_q^n is not
; connected for n ≥ 2, so it is not a Galois object in the sense of SGA 1.

(print "--- 6. Galois objects ---")
(print "F_{q^n} is Galois over F_q with Galois group Z/nZ")
(print "F_q × F_q is NOT Galois (automorphism group S_2 not transitive on fiber?)")
(print "Actually Aut(F_q×F_q/F_q)=S_2, fiber has 2 points, action is transitive.")
(print "F_q×F_q IS Galois over F_q. Any etale algebra is a finite etale cover and ...")
(print "A product F_q^n is Galois: Aut = S_n permuting the n factors.")

; ============================================================
; 7. VERIFICATION: pi1 COUNTS CONNECTED COVERS
; ============================================================
; The number of isomorphism classes of connected finite etale covers of
; degree n equals the number of open subgroups of Z-hat of index n.  The
; open subgroups of Z-hat are exactly the n·Z-hat (n ≥ 1), so there is
; exactly ONE connected cover of each degree n:
; Spec(F_{q^n}) → Spec(F_q).  The disconnected covers are products of
; connected ones; counting all covers gives the partition numbers p(n).

(print "--- 7. Number of connected covers per degree ---")
(print "Connected degree-n etale cover of Spec(F_q): exactly 1, namely F_{q^n}")
(print "This corresponds to the unique open subgroup n·Z-hat of index n")
(print "So connective cover count is always 1 per degree")

; SISP: the claim of this section, computed.  Inside every finite quotient
; Z/NZ the subgroups are enumerated by brute force; there must be EXACTLY
; ONE of each index dividing N (and none of any other index), which is the
; statement that Spec(F_{q^n}) is the unique connected degree-n cover.
(define (divisors nn) (filter (lambda (d) (= 0 (mod nn d))) (seq 1 nn)))
(define (index-multiset nn) (sort < (map (lambda (h) (truncate (/ nn (length h)))) (subgroups nn))))

(print "indices of the subgroups of Z/12Z:") (print (index-multiset 12))
(print "divisors of 12:") (print (divisors 12))
(print "indices of the subgroups of Z/18Z:") (print (index-multiset 18))

(check "unique-connected-cover-per-degree"
  (and ; every index that occurs is a divisor, each occurring exactly once
       (every (lambda (nn) (equal (index-multiset nn) (divisors nn))) (list 6 12 18 20 30))
       (and ; hence exactly one connected cover of each degree
            (every (lambda (n) (= 1 (conn-cover-count n))) (seq 1 6))
            ; and this is strictly smaller than the number of ALL covers
            ; of degree n for n >= 2, which is p(n)
            (every (lambda (n) (< (conn-cover-count n) (partition-count n))) (seq 2 5)))))

(print "=== Etale Fundamental Group Full Done ===")
