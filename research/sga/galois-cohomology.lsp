; ============================================================
; SGA 2 — Galois Cohomology: H¹ for Finite Galois Groups
; G = Gal(F_{q^n} / F_q) ≅ Z/nZ (cyclic, generator = Frobenius Fr).
; H¹(G,A) = {cocycles: G→A | c(gh)=c(g)+g·c(h)} / {c(a)(g)=a-g·a}.
; ============================================================

(print "=== Galois Cohomology ===")

; ------------------------------------------------------------
; Machinery A — finite fields F_{p^d} as coefficient lists (LOW to HIGH)
; modulo a monic irreducible f of degree d over Z/pZ.
; ------------------------------------------------------------
(define (zn a m) (mod (+ (mod a m) m) m))
(define (zeros k) (cond ((<= k 0) nil) (t (cons 0 (zeros (- k 1))))))
(define (padto p dd) (append p (zeros (- dd (length p)))))
(define (coefat p i) (cond ((< i 0) 0) ((>= i (length p)) 0) (t (nth i p))))
(define (vsub a b m) (map (lambda (pr) (zn (- (car pr) (cadr pr)) m)) (zip a b)))
(define (vadd a b m) (map (lambda (pr) (zn (+ (car pr) (cadr pr)) m)) (zip a b)))
(define (scale-poly c p m) (map (lambda (co) (zn (* c co) m)) p))
(define (poly-mul a b m)
  (map (lambda (k)
         (zn (foldl + 0 (map (lambda (i) (* (coefat a i) (coefat b (- k i)))) (seq 0 k))) m))
       (seq 0 (- (+ (length a) (length b)) 2))))
(define (poly-reduce p f m)
  (cond ((< (length p) (length f)) p)
        (t (let ((cc (last p)) (shift (- (length p) (length f))))
             (poly-reduce (butlast (vsub p (append (zeros shift) (scale-poly cc f m)) m)) f m)))))
(define (fdeg f) (- (length f) 1))
(define (fone f) (padto (list 1) (fdeg f)))
(define (fzero f) (zeros (fdeg f)))
(define (fmul a b f m) (padto (poly-reduce (poly-mul a b m) f m) (fdeg f)))
(define (felts dd m)
  (cond ((= dd 0) (list nil))
        (t (foldr append nil
                  (map (lambda (v) (map (lambda (c) (cons c v)) (seq 0 (- m 1))))
                       (felts (- dd 1) m))))))
(define (fstar f m) (filter (lambda (a) (not (equal a (fzero f)))) (felts (fdeg f) m)))
(define (fpow a k f m) (cond ((= k 0) (fone f)) (t (fmul a (fpow a (- k 1) f m) f m))))
(define (frob a f m) (fpow a m f m))

; ------------------------------------------------------------
; Machinery B — cohomology of a CYCLIC group G = <g> of order nn acting on
; a finite abelian group M given by (elts, op, idt) with g acting as `act`.
; For cyclic G:  H^0 = M^g,  H^1 = ker(Norm) / image(1 - g).
; Norm(a) = a · g(a) · ... · g^{nn-1}(a).  Everything below is brute force
; over the actual element list, so it can genuinely fail.
; ------------------------------------------------------------
(define (grp-inv elts op idt a) (find (lambda (u) (equal (op a u) idt)) elts))
(define (iact act k a) (cond ((= k 0) a) (t (iact act (- k 1) (act a)))))
(define (gnorm op idt act nn a)
  (foldl (lambda (acc i) (op acc (iact act i a))) idt (seq 0 (- nn 1))))
(define (ker-norm elts op idt act nn)
  (filter (lambda (a) (equal (gnorm op idt act nn a) idt)) elts))
(define (img-one-minus-g elts op idt act)
  (dedup (map (lambda (a) (op a (grp-inv elts op idt (act a)))) elts)))
(define (h0-order elts act) (length (filter (lambda (a) (equal (act a) a)) elts)))
(define (h1-order elts op idt act nn)
  (/ (length (ker-norm elts op idt act nn))
     (length (img-one-minus-g elts op idt act))))

; additive group Z/mZ, used as a trivial-action module
(define (zmod-elts m) (seq 0 (- m 1)))
(define (zmod-add m) (lambda (a b) (mod (+ a b) m)))
(define (triv-act a) a)

; ============================================================
; 1. Hilbert's Theorem 90: H¹(G, F_{q^n}^×) = 0
; ============================================================
; G = Gal(F_{q^n}/F_q) ≅ Z/nZ, generated by Frobenius Fr(x) = x^q.
; For multiplicative group A = F_{q^n}^×, the norm map N(a) = a·Fr(a)·...·Fr^{n-1}(a)
; is surjective, so every 1-cocycle is a coboundary => H¹ = 0.
;
; Explicit verification for F_4/F_2 (q=2, n=2):
; F_4 = {0, 1, α, α+1} where α² = α+1.
; G = {1, Fr} where Fr(x) = x².
; F_4^× = {1, α, α+1} = cyclic of order 3.
; Fr(α) = α² = α+1, Fr(α+1) = (α+1)² = α²+1 = α+1+1 = α.
;
; A 1-cocycle c: G → F_4^× satisfies c(Fr·Fr) = c(Fr) + Fr·c(Fr).
; Since Fr² = 1, we need c(1) = c(Fr) + Fr(c(Fr)).
; But c(1) = 1 (normalized), so Fr(c(Fr)) = c(Fr)^{-1}.
; This means c(Fr) ∈ ker(Norm) = {x | x·Fr(x) = 1}.
; The norm map N(x) = x·x² = x³. For F_4^×, x³ = 1 for all x.
; So ker(N) = F_4^×, every element.
; A coboundary is c(Fr) = a / Fr(a) = a^{1-q} = a^{-1} (since q=2).
; Since squaring in F_4^× is an automorphism, every element is of the form a/a².
; Thus every cocycle is a coboundary => H¹ = 0.

(print "--- 1. Hilbert's Theorem 90: H¹(G, F_4^×) = 0 ---")
(print "G = Gal(F_4/F_2) ≅ Z/2Z, Fr(x)=x².")
(print "F_4^× = {1, α, α+1}. Every cocycle c(Fr) = a/Fr(a) for some a.")
(print "=> H¹ = 0. Verified.")

; F_4 = F_2[x]/(x²+x+1), elements written as coefficient lists (c0 c1).
(define f4 (list 1 1 1))
(define f4-all (felts 2 2))
(define f4x (fstar f4 2))
(define f4-mul (lambda (a b) (fmul a b f4 2)))
(define f4-frob (lambda (a) (frob a f4 2)))
(print "F_4^× (as coefficient lists) =") (print f4x)
(print "Frobenius x -> x² on F_4^× =") (print (map f4-frob f4x))
; Sanity: Frobenius really is the Galois generator — it fixes exactly F_2 (2 elements)
; and has order 2 on F_4.
(check "frob-fixes-exactly-F2"
       (= (h0-order f4-all f4-frob) 2))
(check "frob-has-order-2-on-F4"
       (and (equal (map (lambda (a) (f4-frob (f4-frob a))) f4-all) f4-all)
            (any (lambda (a) (not (equal (f4-frob a) a))) f4-all)))
; Hilbert 90 by brute force: ker(Norm) / image(1 - Fr) on F_4^×.
(print "ker(Norm) on F_4^× =") (print (ker-norm f4x f4-mul (fone f4) f4-frob 2))
(print "image of (1 - Fr) on F_4^× =") (print (img-one-minus-g f4x f4-mul (fone f4) f4-frob))
(check "hilbert-90-h1-F4x-is-zero"
       (and (= (h1-order f4x f4-mul (fone f4) f4-frob 2) 1)
            (= (length (img-one-minus-g f4x f4-mul (fone f4) f4-frob)) 3)))

; ============================================================
; 2. Compute H¹(G, Z/2Z) for F_4/F_2
; ============================================================
; G = {1, Fr} ≅ Z/2Z acts trivially on Z/2Z.
; Cocycles: c(1) = 0, c(Fr) can be 0 or 1.
; Cocycle condition: c(Fr·Fr) = c(Fr) + Fr·c(Fr) => 0 = c(Fr)+c(Fr) => 0 = 0 (Z/2Z).
; So both choices are cocycles: Z¹ = {0, 1} ≅ Z/2Z.
;
; Coboundaries: c(g) = a - g·a = a - a = 0 (trivial action).
; So B¹ = {0}.
; H¹ = Z¹/B¹ = Z/2Z.

(print "--- 2. H¹(Gal(F_4/F_2), Z/2Z) = Z/2Z ---")
(print "G = Z/2Z acts trivially on Z/2Z.")
(print "Cocycles: c(Fr) ∈ {0,1}, both satisfy cocycle condition.")
(print "Coboundaries: c(Fr) = a - a = 0 only.")
(print "H¹ = {cocycles}/{coboundaries} = Z/2Z.")

; Route A — literal brute force over ALL functions c: G -> Z/mZ.
; c is stored as a length-nn list, c_i = c(g^i); the action is trivial so the
; cocycle identity is c(i+j) = c(i) + c(j).
(define (tuples nn m)
  (cond ((= nn 0) (list nil))
        (t (foldr append nil
                  (map (lambda (v) (map (lambda (c) (cons c v)) (seq 0 (- m 1))))
                       (tuples (- nn 1) m))))))
(define (allpairs la lb)
  (foldr append nil (map (lambda (i) (map (lambda (j) (list i j)) lb)) la)))
(define (triv-cocycle-p c nn m)
  (and (= (nth 0 c) 0)
       (every (lambda (pr) (= (nth (mod (+ (car pr) (cadr pr)) nn) c)
                              (mod (+ (nth (car pr) c) (nth (cadr pr) c)) m)))
              (allpairs (seq 0 (- nn 1)) (seq 0 (- nn 1))))))
; trivial action => every coboundary c(g)=a-g·a is 0, so B¹={0} and H¹ = |Z¹|.
(define (z1-count nn m) (count (lambda (c) (triv-cocycle-p c nn m)) (tuples nn m)))

(print "Z¹(Z/2Z, Z/2Z) by exhaustive search over all 4 functions:")
(print (filter (lambda (c) (triv-cocycle-p c 2 2)) (tuples 2 2)))
; Route B — the ker(Norm)/image(1-g) machine used for Hilbert 90 above.
; Both routes must give 2, in contrast with the 1 they gave for F_4^×.
(check "h1-F4_F2-Z2-is-Z2"
       (and (= (z1-count 2 2) 2)
            (= (h1-order (zmod-elts 2) (zmod-add 2) 0 triv-act 2) 2)))

; ============================================================
; 3. General H¹(G, Z/nZ) for cyclic Galois groups
; ============================================================
; For G = Z/nZ acting trivially on Z/mZ:
; Cocycles are group homomorphisms G → Z/mZ.
; Z¹(G, Z/mZ) = Hom(Z/nZ, Z/mZ) = Z/gcd(n,m)Z.
; Coboundaries B¹ = 0 (trivial action).
; So H¹ = Z/gcd(n,m)Z.
;
; Example: G = Gal(F_8/F_2) ≅ Z/3Z, A = Z/2Z.
; H¹ = Z/gcd(3,2)Z = Z/1Z = 0.
;
; Example: G = Gal(F_9/F_3) ≅ Z/2Z, A = Z/2Z.
; H¹ = Z/gcd(2,2)Z = Z/2Z.

(print "--- 3. General H¹ for trivial action ---")
(print "For G=Z/nZ acting trivially on Z/mZ: H¹ = Z/gcd(n,m)Z.")
(print "G=Gal(F_8/F_2)≅Z/3Z on Z/2Z: H¹ = Z/gcd(3,2)Z = 0.")
(print "G=Gal(F_9/F_3)≅Z/2Z on Z/2Z: H¹ = Z/gcd(2,2)Z = Z/2Z.")

; LEFT SIDE: brute-force |ker Norm| / |image(1-g)| inside Z/mZ.
; RIGHT SIDE: the closed formula gcd(n,m). Independent routes.
(define nm-cases (list (list 3 2) (list 2 2) (list 6 4) (list 4 6) (list 5 5) (list 4 4)))
(define computed-h1
  (map (lambda (pr) (h1-order (zmod-elts (cadr pr)) (zmod-add (cadr pr)) 0 triv-act (car pr)))
       nm-cases))
(define formula-h1 (map (lambda (pr) (gcd (car pr) (cadr pr))) nm-cases))
(print "(n m) cases:") (print nm-cases)
(print "brute-force |H¹|:") (print computed-h1)
(print "gcd(n,m):") (print formula-h1)
(check "h1-general-triv-action"
       (and (equal computed-h1 formula-h1)
            ; and the exhaustive cocycle search agrees on two of them
            (= (z1-count 3 2) 1)
            (= (z1-count 4 6) 2)
            ; the answers are genuinely different from each other
            (> (length (dedup computed-h1)) 2)))

; ============================================================
; 4. Cocycle computation for F_8/F_2 with μ_3
; ============================================================
; G = Gal(F_8/F_2) ≅ Z/3Z, Fr(x) = x².
; F_8^× is cyclic of order 7.
; μ_3(F_8) = {x ∈ F_8 | x³ = 1}. F_8^× is cyclic of order 7 and gcd(3,7)=1,
; so cubing is a bijection and μ_3 = {1} only.
; So H¹(G, μ_3) = 0 trivially.
;
; But consider μ_7(F_8) = F_8^×.
; H¹(G, F_8^×) = 0 by Hilbert 90.
; The Kummer sequence gives H¹(G, μ_7) = F_2^×/(F_2^×)^7 = {1}/{1} = 0.

(print "--- 4. μ_n cohomology for F_8/F_2 ---")
(print "μ_3(F_8) = {1} only. H¹ = 0.")
(print "μ_7(F_8) = F_8^×. H¹ = 0 by Hilbert 90.")

; F_8 = F_2[x]/(x³+x+1). Gal(F_8/F_2) = <Fr>, Fr(x)=x², of order 3.
(define f8 (list 1 1 0 1))
(define f8x (fstar f8 2))
(define f8-mul (lambda (a b) (fmul a b f8 2)))
(define f8-frob (lambda (a) (frob a f8 2)))
(define mu3-f8 (filter (lambda (a) (equal (fpow a 3 f8 2) (fone f8))) f8x))
(define mu7-f8 (filter (lambda (a) (equal (fpow a 7 f8 2) (fone f8))) f8x))
(print "|F_8^×| =") (print (length f8x))
(print "μ_3(F_8) =") (print mu3-f8)
(print "|μ_7(F_8)| =") (print (length mu7-f8))
(check "mu-cohom-F8-F2"
       (and (= (length f8x) 7)
            ; μ_n(F_q) has order gcd(n, q-1) — brute force vs. formula
            (= (length mu3-f8) (gcd 3 7))
            (= (length mu7-f8) (gcd 7 7))
            ; Hilbert 90 again, now for the cyclic group of order 3
            (= (h1-order f8x f8-mul (fone f8) f8-frob 3) 1)
            ; Fr really has order 3 here: its fixed field is F_2, not all of F_8
            (= (h0-order (felts 3 2) f8-frob) 2)))

(print "=== Galois Cohomology Done ===")
