; Term-rewriting engine matches pattern variables, instantiates replacements, and normalizes expressions.
(define (tr-variable-p term) (and (listp term) (eq (car term) 'var)))
(define (tr-get environment variable)
  (let ((entry (find (lambda (binding) (equal (car binding) variable)) environment)))
    (cond ((eq entry nil) nil) (t (cadr entry)))))
(define (tr-match pattern term environment)
  (cond ((tr-variable-p pattern)
         (let ((known (tr-get environment pattern)))
           (cond ((eq known nil) (cons (list pattern term) environment))
                 ((equal known term) environment) (t nil))))
        ((and (atom pattern) (atom term)) (cond ((equal pattern term) environment) (t nil)))
        ((and (listp pattern) (listp term)) (tr-match-list pattern term environment))
        (t nil)))
(define (tr-match-list patterns terms environment)
  (cond ((and (eq patterns nil) (eq terms nil)) environment)
        ((or (eq patterns nil) (eq terms nil)) nil)
        (t (let ((next (tr-match (car patterns) (car terms) environment)))
          (cond ((eq next nil) nil) (t (tr-match-list (cdr patterns) (cdr terms) next)))))))
(define (tr-instantiate template environment)
  (cond ((tr-variable-p template) (tr-get environment template)) ((atom template) template)
        (t (map (lambda (part) (tr-instantiate part environment)) template))))
(define (tr-rule term rule)
  (let ((environment (tr-match (car rule) term '((marker marker)))))
    (cond ((eq environment nil) nil) (t (tr-instantiate (cadr rule) environment)))))
(define (tr-root rules term)
  (foldl (lambda (result rule)
    (cond ((not (eq result nil)) result) (t (tr-rule term rule)))) nil rules))
(define (tr-pass rules term)
  (let ((children (cond ((atom term) term) (t (map (lambda (part) (tr-pass rules part)) term)))))
    (let ((root (tr-root rules children))) (cond ((eq root nil) children) (t root)))))
(define (term-normalize rules term budget)
  (cond ((= budget 0) term)
        (t (let ((next (tr-pass rules term)))
          (cond ((equal next term) term) (t (term-normalize rules next (- budget 1))))))))
(define tr-arithmetic '(((+ (var x) 0) (var x)) ((* (var x) 1) (var x)) ((* (var x) 0) 0) ((- (var x) (var x)) 0)))
(term-normalize tr-arithmetic '(* (+ a 0) 1) 5) ; => a
(term-normalize tr-arithmetic '(+ (* x 0) 0) 5) ; => 0
(term-normalize tr-arithmetic '(- (+ z 0) z) 5) ; => 0

