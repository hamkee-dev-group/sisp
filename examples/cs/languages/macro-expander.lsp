; Data-driven hygienic-by-convention macro expander substitutes parameters and recursively expands output.
; Macro entries are (name parameters template); quoted forms are never traversed.
(define (mx-binding parameters arguments symbol)
  (cond ((eq parameters nil) nil) ((equal (car parameters) symbol) (car arguments))
        (t (mx-binding (cdr parameters) (cdr arguments) symbol))))
(define (mx-bound-p parameters symbol) (in symbol parameters))
(define (mx-substitute template parameters arguments)
  (cond ((symbolp template) (cond ((mx-bound-p parameters template)
                                   (mx-binding parameters arguments template)) (t template)))
        ((atom template) template)
        ((eq (car template) 'quote) template)
        (t (map (lambda (part) (mx-substitute part parameters arguments)) template))))
(define (mx-definition macros name)
  (find (lambda (macro) (equal (car macro) name)) macros))
(define (macro-expand-once macros form)
  (cond ((atom form) form)
        (t (let ((definition (mx-definition macros (car form))))
          (cond ((eq definition nil) form)
                (t (mx-substitute (caddr definition) (cadr definition) (cdr form))))))))
(define (macro-expand-all macros form)
  (cond ((atom form) form) ((eq (car form) 'quote) form)
        (t (let ((expanded (macro-expand-once macros form)))
          (cond ((not (equal expanded form)) (macro-expand-all macros expanded))
                (t (map (lambda (part) (macro-expand-all macros part)) form)))))))
(define mx-macros '((when (test body) (if test body nil)) (unless (test body) (when (not test) body)) (inc (value) (+ value 1))))
(macro-expand-all mx-macros '(when (> x 0) (inc x))) ; => (if (> x 0) (+ x 1) nil)
(macro-expand-all mx-macros '(unless ready (inc retries))) ; => (if (not ready) (+ retries 1) nil)
(macro-expand-all mx-macros '(quote (when x y))) ; => (quote (when x y))

