; First-order unification supports variables, compound terms, substitution chains, and occurs checking.
; Variables have the explicit representation (var name).
(define (un-var-p term) (and (listp term) (eq (car term) 'var)))
(define (un-lookup substitutions variable)
  (let ((entry (find (lambda (binding) (equal (car binding) variable)) substitutions)))
    (cond ((eq entry nil) nil) (t (cadr entry)))))
(define (un-walk term substitutions)
  (cond ((not (un-var-p term)) term)
        (t (let ((value (un-lookup substitutions term)))
          (cond ((eq value nil) term) (t (un-walk value substitutions)))))))
(define (un-occurs-p variable term substitutions)
  (let ((walked (un-walk term substitutions)))
    (cond ((equal variable walked) t) ((atom walked) nil)
          (t (foldl (lambda (found part) (or found (un-occurs-p variable part substitutions)))
               nil walked)))))
(define (un-extend variable term substitutions)
  (cond ((un-occurs-p variable term substitutions) nil)
        (t (cons (list variable term) substitutions))))
(define (unify left right substitutions)
  (let ((a (un-walk left substitutions)) (b (un-walk right substitutions)))
    (cond ((equal a b) substitutions) ((un-var-p a) (un-extend a b substitutions))
          ((un-var-p b) (un-extend b a substitutions))
          ((and (listp a) (listp b)) (unify-lists a b substitutions))
          (t nil))))
(define (unify-lists left right substitutions)
  (cond ((and (eq left nil) (eq right nil)) substitutions)
        ((or (eq left nil) (eq right nil)) nil)
        (t (let ((next (unify (car left) (car right) substitutions)))
          (cond ((eq next nil) nil) (t (unify-lists (cdr left) (cdr right) next)))))))
(define (un-apply term substitutions)
  (let ((walked (un-walk term substitutions)))
    (cond ((atom walked) walked) ((un-var-p walked) walked)
          (t (map (lambda (part) (un-apply part substitutions)) walked)))))
(define un-result (unify '(parent (var x) bob) '(parent ada (var y)) '((marker marker))))
(un-apply '((var x) (var y)) un-result) ; => (ada bob)
(unify '(f (var x)) '(f (g (var x))) '((marker marker))) ; => nil
(un-apply '(pair (var x) (var x)) (unify '(pair (var x) 2) '(pair 2 (var y)) '((marker marker)))) ; => (pair 2 2)
