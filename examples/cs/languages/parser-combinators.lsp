; Parser-combinator library builds token parsers from sequencing, choice, mapping, and repetition.
; A parser returns (value remaining-tokens) or nil.
(define (pcb-token expected)
  (lambda (tokens) (cond ((and (not (eq tokens nil)) (equal (car tokens) expected))
                           (list (car tokens) (cdr tokens))) (t nil))))
(define (pcb-satisfy predicate)
  (lambda (tokens) (cond ((and (not (eq tokens nil)) (predicate (car tokens)))
                           (list (car tokens) (cdr tokens))) (t nil))))
(define (pcb-map parser function)
  (lambda (tokens) (let ((result (parser tokens)))
    (cond ((eq result nil) nil) (t (list (function (car result)) (cadr result)))))))
(define (pcb-sequence left right)
  (lambda (tokens) (let ((first (left tokens)))
    (cond ((eq first nil) nil)
          (t (let ((second (right (cadr first))))
            (cond ((eq second nil) nil)
                  (t (list (list (car first) (car second)) (cadr second))))))))))
(define (pcb-choice left right)
  (lambda (tokens) (let ((result (left tokens)))
    (cond ((eq result nil) (right tokens)) (t result)))))
(define (pcb-many parser)
  (lambda (tokens) (pcb-many-loop parser tokens nil)))
(define (pcb-many-loop parser tokens values)
  (let ((result (parser tokens)))
    (cond ((eq result nil) (list (reverse values) tokens))
          (t (pcb-many-loop parser (cadr result) (cons (car result) values))))))
(define pcb-assignment (pcb-sequence (pcb-satisfy (lambda (token) (symbolp token)))
  (pcb-sequence (pcb-token '=) (pcb-satisfy (lambda (token) (numberp token))))))
(pcb-assignment '(x = 42 rest)) ; => ((x (= 42)) (rest))
((pcb-many (pcb-token 'a)) '(a a a b)) ; => ((a a a) (b))
((pcb-choice (pcb-token 'yes) (pcb-token 'no)) '(no next)) ; => (no (next))

