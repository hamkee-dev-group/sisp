; Append-only key-value journal supports replay, deletion, history, and compaction.
(define (kvj-put state key value)
  (cons (list key value) (remove (lambda (entry) (equal (car entry) key)) state)))
(define (kvj-delete state key)
  (remove (lambda (entry) (equal (car entry) key)) state))
(define (kvj-apply state operation)
  (cond ((eq (car operation) 'put) (kvj-put state (cadr operation) (caddr operation)))
        ((eq (car operation) 'delete) (kvj-delete state (cadr operation)))
        (t state)))
(define (kvj-replay journal)
  (foldl (lambda (state operation) (kvj-apply state operation)) nil journal))
(define (kvj-get state key default)
  (let ((entry (find (lambda (pair) (equal (car pair) key)) state)))
    (cond ((eq entry nil) default) (t (cadr entry)))))
(define (kvj-history journal key)
  (filter (lambda (operation) (equal (cadr operation) key)) journal))
(define (kvj-compact journal)
  (map (lambda (entry) (list 'put (car entry) (cadr entry))) (reverse (kvj-replay journal))))
(define kvj-demo '((put a 1) (put b 2) (put a 3) (delete b) (put c 4)))
(reverse (kvj-replay kvj-demo)) ; => ((a 3) (c 4))
(kvj-history kvj-demo 'a) ; => ((put a 1) (put a 3))
(kvj-compact kvj-demo) ; => ((put a 3) (put c 4))

