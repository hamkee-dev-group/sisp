; Declarative schema validator checks required fields, primitive types, and custom predicates.
; Schema entries are (field type required-p predicate-or-nil).
(define (sv-get record field)
  (let ((entry (find (lambda (pair) (equal (car pair) field)) record)))
    (cond ((eq entry nil) nil) (t (cadr entry)))))
(define (sv-type-p value type)
  (cond ((eq type 'number) (numberp value)) ((eq type 'string) (equal (typeof value) "string"))
        ((eq type 'symbol) (symbolp value)) ((eq type 'list) (listp value))
        ((eq type 'any) t) (t nil)))
(define (sv-field-errors record rule)
  (let ((value (sv-get record (car rule))))
    (cond ((and (eq value nil) (caddr rule)) (list (list (car rule) 'required)))
          ((eq value nil) nil)
          ((not (sv-type-p value (cadr rule))) (list (list (car rule) 'wrong-type)))
          ((and (not (eq (cadddr rule) nil)) (not ((cadddr rule) value)))
           (list (list (car rule) 'invalid-value)))
          (t nil))))
(define (schema-validate schema record)
  (foldl (lambda (errors rule) (append errors (sv-field-errors record rule))) nil schema))
(define sv-user-schema (list (list 'name 'string t nil)
  (list 'age 'number t (lambda (value) (>= value 0)))
  (list 'role 'symbol nil nil)))
(schema-validate sv-user-schema '((name "Ada") (age 36) (role admin))) ; => nil
(schema-validate sv-user-schema '((age -2))) ; => ((name required) (age invalid-value))
(schema-validate sv-user-schema '((name 9) (age 2))) ; => ((name wrong-type))
