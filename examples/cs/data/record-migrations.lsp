; Versioned record migrations apply rename, default, transform, and drop operations.
(define (mig-get record key)
  (let ((entry (find (lambda (pair) (equal (car pair) key)) record)))
    (cond ((eq entry nil) nil) (t (cadr entry)))))
(define (mig-put record key value)
  (cons (list key value) (remove (lambda (pair) (equal (car pair) key)) record)))
(define (mig-operation record operation)
  (cond ((eq (car operation) 'rename)
         (mig-put (remove (lambda (pair) (equal (car pair) (cadr operation))) record)
           (caddr operation) (mig-get record (cadr operation))))
        ((eq (car operation) 'default)
         (cond ((eq (mig-get record (cadr operation)) nil)
                (mig-put record (cadr operation) (caddr operation))) (t record)))
        ((eq (car operation) 'transform)
         (mig-put record (cadr operation) ((caddr operation) (mig-get record (cadr operation)))))
        ((eq (car operation) 'drop)
         (remove (lambda (pair) (equal (car pair) (cadr operation))) record))
        (t record)))
(define (mig-apply record operations)
  (foldl (lambda (current operation) (mig-operation current operation)) record operations))
(define (mig-upgrade record version migrations target)
  (cond ((= version target) record)
        (t (mig-upgrade (mig-apply record (cadr (find (lambda (entry) (= (car entry) version)) migrations)))
             (+ version 1) migrations target))))
(define mig-plan '((1 ((rename fullname name) (default active t))) (2 ((transform age (lambda (value) (+ value 1))) (drop legacy)))))
(mig-apply '((fullname "Ada")) '((rename fullname name) (default active t))) ; => ((active t) (name "Ada"))
(mig-upgrade '((fullname "Ada") (age 35) (legacy old)) 1 mig-plan 3) ; => ((age 36) (active t) (name "Ada"))
(mig-get (mig-upgrade '((fullname "Lin") (age 20)) 1 mig-plan 3) 'active) ; => t

