; ETL pipeline validates raw string rows, converts types, rejects missing data, and aggregates output.
(define (etl-valid-row-p row)
  (and (= (length row) 3) (not (equal (cadr row) "NA"))
    (not (equal (caddr row) "NA"))))
(define (etl-transform row)
  (list (car row) (str-to-num (cadr row)) (str-to-num (caddr row))))
(define (etl-run raw-rows)
  (list (map (lambda (row) (etl-transform row))
          (filter (lambda (row) (etl-valid-row-p row)) raw-rows))
        (remove (lambda (row) (etl-valid-row-p row)) raw-rows)))
(define (etl-groups rows)
  (foldl (lambda (groups row)
    (let ((entry (find (lambda (group) (equal (car group) (car row))) groups)))
      (cond ((eq entry nil) (append groups (list (list (car row) (cadr row) 1))))
            (t (map (lambda (group) (cond ((equal (car group) (car row))
              (list (car group) (+ (cadr group) (cadr row)) (+ (caddr group) 1)))
              (t group))) groups))))) nil rows))
(define (etl-averages rows)
  (map (lambda (group) (list (car group) (/ (cadr group) (caddr group))))
    (etl-groups rows)))
(define etl-result (etl-run '((red "10" "2") (blue "NA" "3") (red "20" "4"))))
(car etl-result) ; => ((red 10 2) (red 20 4))
(cadr etl-result) ; => ((blue "NA" "3"))
(etl-averages (car etl-result)) ; => ((red 15))

