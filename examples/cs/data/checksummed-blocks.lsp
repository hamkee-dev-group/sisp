; Checksummed block store detects corruption and reconstructs validated payload sequences.
(define (cb-checksum payload modulus)
  (mod (foldl (lambda (sum value) (+ (* sum 31) value)) 0 payload) modulus))
(define (cb-make id payload modulus)
  (list id payload (cb-checksum payload modulus)))
(define (cb-valid-p block modulus)
  (= (caddr block) (cb-checksum (cadr block) modulus)))
(define (cb-read blocks modulus)
  (foldl (lambda (result block)
    (cond ((cb-valid-p block modulus) (append result (cadr block))) (t result))) nil blocks))
(define (cb-invalid-ids blocks modulus)
  (map (lambda (block) (car block))
    (remove (lambda (block) (cb-valid-p block modulus)) blocks)))
(define cb-blocks (list (cb-make 1 '(10 20 30) 997) (cb-make 2 '(40 50) 997)))
(map (lambda (block) (cb-valid-p block 997)) cb-blocks) ; => (t t)
(cb-read cb-blocks 997) ; => (10 20 30 40 50)
(cb-invalid-ids (append cb-blocks '((3 (1 2) 0))) 997) ; => (3)
