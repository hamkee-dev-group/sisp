; Recursive JSON-like parser consumes a token stream into SISP lists and association pairs.
; String tokens are (string value); delimiters are lb rb ls rs colon and comma.
(define (jp-value tokens)
  (cond ((numberp (car tokens)) (list (car tokens) (cdr tokens)))
        ((and (listp (car tokens)) (eq (caar tokens) 'string))
         (list (cadar tokens) (cdr tokens)))
        ((eq (car tokens) 'true) (list t (cdr tokens)))
        ((eq (car tokens) 'false) (list nil (cdr tokens)))
        ((eq (car tokens) 'null) (list 'null (cdr tokens)))
        ((eq (car tokens) 'lb) (jp-object (cdr tokens) nil))
        ((eq (car tokens) 'ls) (jp-array (cdr tokens) nil))
        (t (error "JP-VALUE: UNEXPECTED TOKEN" (car tokens)))))
(define (jp-object tokens pairs)
  (cond ((eq (car tokens) 'rb) (list (reverse pairs) (cdr tokens)))
        (t (let ((key (cadar tokens)) (parsed (jp-value (cddr tokens))))
          (let ((rest (cadr parsed)))
            (jp-object (cond ((eq (car rest) 'comma) (cdr rest)) (t rest))
              (cons (list key (car parsed)) pairs)))))))
(define (jp-array tokens values)
  (cond ((eq (car tokens) 'rs) (list (reverse values) (cdr tokens)))
        (t (let ((parsed (jp-value tokens)))
          (let ((rest (cadr parsed)))
            (jp-array (cond ((eq (car rest) 'comma) (cdr rest)) (t rest))
              (cons (car parsed) values)))))))
(define (jp-parse tokens) (catch (car (jp-value tokens)) (lambda (e) (list 'parse-error (cadr e)))))
(jp-parse '(lb (string name) colon (string ada) comma (string age) colon 36 rb)) ; => ((name ada) (age 36))
(jp-parse '(ls 1 comma 2 comma lb (string ok) colon true rb rs)) ; => (1 2 ((ok t)))
(jp-parse '(lb (string values) colon ls 3 comma 4 rs rb)) ; => ((values (3 4)))

