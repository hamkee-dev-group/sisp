; ============================================================
; polygon-clipping.lsp — Sutherland-Hodgman & Greiner-Hormann
; Clip polygon against convex window. Boolean operations.
; ============================================================

(print "=== Polygon Clipping ===")

(define (px0 p) (nth 0 p))
(define (py0 p) (nth 1 p))

(define (inside-p-cur left cur edge-s edge-e)
  (let* ((ex0 (px0 edge-s)) (ey0 (py0 edge-s))
         (ex1 (px0 edge-e)) (ey1 (py0 edge-e))
         (cx (px0 cur)) (cy (py0 cur))
         (val (- (* (- ex1 ex0) (- cy ey0)) (* (- ey1 ey0) (- cx ex0)))))
    (if left (>= val 0) (<= val 0))))

(define (intersect-edge-cur pti ptj edge-s edge-e)
  (let* ((ix (px0 pti)) (iy (py0 pti))
         (jx (px0 ptj)) (jy (py0 ptj))
         (sx (px0 edge-s)) (sy (py0 edge-s))
         (ex (px0 edge-e)) (ey (py0 edge-e))
         (a1 (- jy iy)) (b1 (- ix jx)) (c1 (+ (* a1 ix) (* b1 iy)))
         (a2 (- ey sy)) (b2 (- sx ex)) (c2 (+ (* a2 sx) (* b2 sy)))
         (det (- (* a1 b2) (* a2 b1))))
    (if (= det 0) nil
      (list (/ (- (* b2 c1) (* b1 c2)) det)
            (/ (- (* a1 c2) (* a2 c1)) det)))))

(define (sutherland-hodgman subject clip)
  (define (clip-against-edge poly edge-s edge-e left)
    (if (equal poly nil) nil
      (let* ((cur (car poly)) (rest (cdr poly))
             (cur-in (inside-p-cur left cur edge-s edge-e)))
        (if (equal rest nil)
          (let* ((prev (last poly))
                 (prev-in (inside-p-cur left prev edge-s edge-e)))
            (cond
              ((and cur-in prev-in) (list cur))
              ((and cur-in (not prev-in))
               (let* ((ip (intersect-edge-cur prev cur edge-s edge-e)))
                 (if ip (list ip cur) (list cur))))
              ((and (not cur-in) prev-in)
               (let* ((ip (intersect-edge-cur prev cur edge-s edge-e)))
                 (if ip (list ip) nil)))
              (t nil)))
          (let* ((tail (clip-against-edge rest edge-s edge-e left))
                 (prev (last (cons cur rest))))
            (if (equal rest nil)
              (if cur-in (cons cur tail) tail)
              (let* ((prev-in (inside-p-cur left prev edge-s edge-e)))
                (cond
                  ((and cur-in prev-in) (cons cur tail))
                  ((and cur-in (not prev-in))
                   (let* ((ip (intersect-edge-cur prev cur edge-s edge-e)))
                     (if ip (cons ip (cons cur tail)) (cons cur tail))))
                  ((and (not cur-in) prev-in)
                   (let* ((ip (intersect-edge-cur prev cur edge-s edge-e)))
                     (if ip (cons ip tail) tail)))
                  (t tail)))))))))
  (let* ((n (length clip)))
    (foldl (lambda (poly i)
      (let* ((es (nth i clip))
             (ee (nth (mod (+ i 1) n) clip)))
        (clip-against-edge poly es ee t)))
      subject (range-r n))))

(define (range-r n)
  (if (= n 0) nil (cons (- n 1) (range-r (- n 1)))))

(define (polygon-area-2 poly)
  (let* ((n (length poly)))
    (if (< n 3) 0
      (/ (abs (foldl (lambda (acc i)
              (let* ((pi (nth i poly)) (pj (nth (mod (+ i 1) n) poly)))
                (+ acc (- (* (px0 pi) (py0 pj)) (* (py0 pi) (px0 pj))))))
            0 (range-r n))) 2))))

(define (is-inside-polyp pt0 poly)
  (let* ((n (length poly)) (px_ (px0 pt0)) (py_ (py0 pt0))
         (cnt (foldl (lambda (acc i)
                (let* ((si (nth i poly)) (sj (nth (mod (+ i 1) n) poly))
                       (six (px0 si)) (siy (py0 si))
                       (sjx (px0 sj)) (sjy (py0 sj)))
                  (if (or (and (<= siy py_) (< py_ sjy)
                               (< (* (- sjx six) (- py_ siy))
                                  (* (- sjy siy) (- px_ six))))
                          (and (<= sjy py_) (< py_ siy)
                               (< (* (- six sjx) (- py_ sjy))
                                  (* (- siy sjy) (- px_ sjx)))))
                    (+ acc 1) acc)))
                0 (range-r n))))
    (= (mod cnt 2) 1)))

(define (gh-op subject clip op0)
  (cond
    ((eq op0 (quote intersect))
     (filter (lambda (pt0) (and (is-inside-polyp pt0 clip) (is-inside-polyp pt0 subject))) subject))
    ((eq op0 (quote union))
     (let* ((from-sub (filter (lambda (pt0) (not (is-inside-polyp pt0 clip))) subject))
            (from-clip (filter (lambda (pt0) (not (is-inside-polyp pt0 subject))) clip)))
       (append from-sub from-clip)))
    ((eq op0 (quote difference))
     (filter (lambda (pt0) (not (is-inside-polyp pt0 clip))) subject))
    (t subject)))

(define subject-square '((1 1) (5 1) (5 5) (1 5)))
(define clip-diamond '((3 0) (6 3) (3 6) (0 3)))

(print "--- Sutherland-Hodgman ---")
(define sh-result (sutherland-hodgman subject-square clip-diamond))
(print "Clipped polygon:")
(print sh-result)
(print (list "Area:" (polygon-area-2 sh-result)))
(check "sh-clip-area-positive" (> (polygon-area-2 sh-result) 0))

(print "--- Boolean Operations ---")
(define tri1 '((0 0) (4 0) (2 4)))
(define tri2 '((2 0) (6 0) (4 4)))
(print "Triangle 1:") (print tri1)
(print "Triangle 2:") (print tri2)
(define diff-result (gh-op tri1 tri2 (quote difference)))
(print "Difference:") (print diff-result)
(check "diff-nonempty" (> (length diff-result) 0))

(print "=== Done ===")
