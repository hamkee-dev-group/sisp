; ============================================================
; Q-Learning on 3x3 Grid World
; Start (0,0), Goal (2,2) +100, Hole (1,1) -100
; Epsilon-greedy, alpha=0.1, gamma=0.9, 500 episodes
; ============================================================
(print "=== Q-Learning Grid World ===")
(define (ck name ok) (cond (ok (print (list 'pass name))) (t (print (list 'FAIL name)))))
(seed 42)
(define trans '((0 1 3 0)(1 2 4 0)(2 2 5 1)(0 4 6 3)(1 5 7 3)(2 5 8 4)(3 7 6 6)(4 8 7 6)(8 8 8 8)))
(define rewds '(-1.0 -1.0 -1.0 -1.0 -100.0 -1.0 -1.0 -1.0 100.0))
(define tlist '(nil nil nil nil t nil nil nil t))
(define (ns s a) (nth a (nth s trans)))
(define (rw s) (nth s rewds))
(define (term s) (nth s tlist))
(define (lset lst idx val) (cond ((= idx 0) (set-car lst val) lst) (t (lset (cdr lst) (- idx 1) val))))
(define (qget q s a) (nth (+ (* s 4) a) q))
(define (qset q s a val) (lset q (+ (* s 4) a) val))
(define (qmax q s) (let ((b (* s 4))) (max (nth b q) (nth (+ b 1) q) (nth (+ b 2) q) (nth (+ b 3) q))))
(define (qbest q s) (let* ((b (* s 4)) (v0 (nth b q)) (v1 (nth (+ b 1) q)) (v2 (nth (+ b 2) q)) (v3 (nth (+ b 3) q)) (best (max v0 v1 v2 v3))) (cond ((= best v0) 0) ((= best v1) 1) ((= best v2) 2) (t 3))))
(define (mktable n acc) (cond ((> n 0) (mktable (- n 1) (cons 0.0 acc))) (t acc)))
(define alpha 0.1)
(define gamma-l 0.9)
(define epsilon 0.1)
(define (choose-act q s eps) (cond ((< (random 1.0) eps) (random 4)) (t (qbest q s))))
(define (run-ep q s st mx) (cond ((or (term s) (>= st mx)) q) (t (let* ((act (choose-act q s epsilon)) (sn (ns s act)) (r (rw sn))) (let* ((old (qget q s act)) (nq (cond ((term sn) 0.0) (t (qmax q sn)))) (td (+ r (* gamma-l nq))) (err (- td old)) (nv (+ old (* alpha err)))) (qset q s act nv) (run-ep q sn (+ st 1) mx))))))
(define (train epx q) (cond ((> epx 500) q) (t (train (+ epx 1) (run-ep q 0 0 100)))))
(print "Training 500 episodes...")
(define q-table (mktable 36 nil))
(define final-q (train 1 q-table))
(print "Training done.")
(define (act-name a) (cond ((= a 0) (quote up)) ((= a 1) (quote right)) ((= a 2) (quote down)) ((= a 3) (quote left)) (t (quote unknown))))
(define (showq q s) (let ((ba (qbest q s)) (v0 (qget q s 0)) (v1 (qget q s 1)) (v2 (qget q s 2)) (v3 (qget q s 3))) (print (list 'st s 'act (act-name ba) 'Q (list v0 v1 v2 v3)))))
(print "Learned policy:")
(showq final-q 0) (showq final-q 1) (showq final-q 2) (showq final-q 3) (showq final-q 4) (showq final-q 5) (showq final-q 6) (showq final-q 7) (showq final-q 8)
(define (follow q s left) (cond ((term s) s) ((<= left 0) -1) (t (follow q (ns s (qbest q s)) (- left 1)))))
(define result (follow final-q 0 50))
(print "Following policy from start reaches state:") (print result)
(ck "policy-reaches-goal" (= result 8))
(define q5d (qget final-q 5 2))
(ck "path-to-goal-learned" (> q5d -10.0))
(define q1d (qget final-q 1 2))
(ck "avoids-hole" (< q1d -10.0))
(define st0 (qbest final-q 0))
(ck "start-not-up" (not (= st0 0)))
(ck "start-not-left" (not (= st0 3)))
(print "=== Q-Learning Grid World Done ===")
