; ============================================================
; 71 — Sorting Networks and the 0–1 Principle (TAOCP Vol 3, 5.3.4)
; Batcher's odd-even merge networks are GENERATED by the recursive
; construction (no memorized constants), proven correct via the
; zero-one principle — a network sorting all 2^n binary inputs
; sorts everything — and S(4)=5 is established by exhausting all
; 1296 four-comparator networks. Knuth's inversion statistic for
; straight insertion is verified exactly over all 120 permutations.
; ============================================================

(print "=== Sorting Networks and the 0-1 Principle ===")


; ---------- comparators on lists ----------
(define (list-with xs i v)
  (cond ((= i 0) (cons v (cdr xs)))
        (t (cons (car xs) (list-with (cdr xs) (- i 1) v)))))
(define (comparator xs i j)
  (let ((a (nth i xs)) (b (nth j xs)))
    (cond ((> a b) (list-with (list-with xs i b) j a))
          (t xs))))
(define (run-network net xs)
  (foldl (lambda (v c) (comparator v (car c) (cadr c))) xs net))

; ---------- Batcher's construction, generated recursively ----------
; odd-even merge and sort exactly as in TAOCP; hi is inclusive.
(define (batcher-merge lo hi r)
  (cond ((< (* r 2) (- hi lo))
    (append (batcher-merge lo hi (* r 2))
      (append (batcher-merge (+ lo r) hi (* r 2))
        (map (lambda (i) (list i (+ i r)))
          (filter (lambda (i) (<= (+ i r) hi))
            (map (lambda (k) (+ (+ lo r) (* 2 (* r k))))
              (seq 0 (- hi lo))))))))
    (t (list (list lo (+ lo r))))))
(define (batcher-sort lo hi)
  (cond ((< lo hi)
    (let ((mid (+ lo (truncate (/ (- hi lo) 2)))))
      (append (batcher-sort lo mid)
        (append (batcher-sort (+ mid 1) hi)
          (batcher-merge lo hi 1)))))
    (t nil)))
(define (batcher n) (batcher-sort 0 (- n 1)))

(define net2 (batcher 2))
(define net4 (batcher 4))
(define net8 (batcher 8))
(print (list (quote batcher-4) net4))
(check "batcher-sizes-1-5-19"
  (and (= (length net2) 1) (= (length net4) 5) (= (length net8) 19)))

; ---------- the 0-1 principle ----------
; all binary vectors of length n
(define (binary-vectors n)
  (cond ((= n 0) (list nil))
        (t (foldl (lambda (acc v)
             (cons (cons 0 v) (cons (cons 1 v) acc)))
             nil (binary-vectors (- n 1))))))
(define (sorted-p xs)
  (cond ((eq (cdr xs) nil) t)
        ((> (car xs) (cadr xs)) nil)
        (t (sorted-p (cdr xs)))))
(define (sorts-all-binary net n)
  (every (lambda (v) (sorted-p (run-network net v)))
    (binary-vectors n)))

(check "batcher-2-sorts-binary" (sorts-all-binary net2 2))
(check "batcher-4-sorts-binary" (sorts-all-binary net4 4))
(check "batcher-8-sorts-binary" (sorts-all-binary net8 8))

; the principle's conclusion, cross-checked on real data: the same
; network sorts every permutation of distinct keys.
(define (insert-everywhere x xs)
  (cond ((eq xs nil) (list (list x)))
        (t (cons (cons x xs)
             (map (lambda (p) (cons (car xs) p))
               (insert-everywhere x (cdr xs)))))))
(define (permutations xs)
  (cond ((eq xs nil) (list nil))
        (t (foldl (lambda (acc p) (append (insert-everywhere (car xs) p) acc))
             nil (permutations (cdr xs))))))
(check "zero-one-principle-holds-on-permutations"
  (every (lambda (p) (sorted-p (run-network net4 p)))
    (permutations (list 1 2 3 4))))

; ---------- S(4) = 5 by exhaustion ----------
; No 4-comparator network sorts 4 wires: all 6^4 = 1296 sequences
; of comparators fail on some binary input; Batcher's 5 succeed.
(define wire-pairs
  (list (list 0 1) (list 0 2) (list 0 3)
        (list 1 2) (list 1 3) (list 2 3)))
(define *networks-tried* 0)
(define *networks-sorting* 0)
(define (try-network net)
  (setq *networks-tried* (+ *networks-tried* 1))
  (cond ((sorts-all-binary net 4)
    (setq *networks-sorting* (+ *networks-sorting* 1))) (t nil)))
(foreach (lambda (c1)
  (foreach (lambda (c2)
    (foreach (lambda (c3)
      (foreach (lambda (c4) (try-network (list c1 c2 c3 c4)))
        wire-pairs))
      wire-pairs))
    wire-pairs))
  wire-pairs)
(print (list (quote four-comparator-networks) *networks-tried*
  (quote that-sort) *networks-sorting*))
(check "all-1296-tried" (= *networks-tried* 1296))
(check "no-4-comparator-network-sorts" (= *networks-sorting* 0))
(check "s4-is-exactly-5"
  (and (= *networks-sorting* 0) (= (length net4) 5)
       (sorts-all-binary net4 4)))

; ---------- Knuth's inversion statistic, exactly ----------
; The average number of inversions over ALL permutations of n
; elements is exactly n(n-1)/4: each of the C(n,2) pairs is
; inverted in exactly half the permutations. Verified as an exact
; rational over all 120 permutations of 5 elements.
(define (inversions xs)
  (cond ((eq xs nil) 0)
        (t (+ (count (lambda (y) (> (car xs) y)) (cdr xs))
              (inversions (cdr xs))))))
(define perms5 (permutations (list 1 2 3 4 5)))
(define total-inversions
  (foldl (lambda (acc p) (+ acc (inversions p))) 0 perms5))
(print (list (quote permutations) (length perms5)
  (quote average-inversions) (/ total-inversions (length perms5))))
(check "120-permutations" (= (length perms5) 120))
(check "average-inversions-is-exactly-5"
  (= (/ total-inversions (length perms5)) 5))
(check "matches-knuth-formula-n-n-1-over-4"
  (= (/ total-inversions (length perms5)) (/ (* 5 4) 4)))

(print "=== Sorting Networks Done ===")
