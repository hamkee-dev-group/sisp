; Dependent types: Vec A n where n is a value index.
; (vcons 1 (vcons 2 vnil)) : (Vec Int 2)

(define (dt-ev x env)
  (cond ((numberp x) x)
        ((symbolp x) (let ((e (find (lambda (b) (eq (car b) x)) env))) (cond (e (cadr e)) (t x))))
        ((eq (car x) '+) (+ (dt-ev (cadr x) env) (dt-ev (caddr x) env)))
        ((eq (car x) '-) (- (dt-ev (cadr x) env) (dt-ev (caddr x) env)))
        ((eq (car x) '*) (* (dt-ev (cadr x) env) (dt-ev (caddr x) env)))
        (t x)))

(define (dt-simp idx env)
  (cond ((numberp idx) idx)
        ((symbolp idx) (let ((e (find (lambda (b) (eq (car b) idx)) env))) (cond (e (cadr e)) (t idx))))
        (t (dt-ev idx env))))

(define (dt-ieq a b env)
  (let ((sa (dt-simp a env)) (sb (dt-simp b env)))
    (cond ((and (numberp sa) (numberp sb)) (= sa sb)) (t (equal a b)))))

(define (dt-teq t1 t2 env)
  (cond ((and (atom t1) (atom t2)) (eq t1 t2))
        ((and (listp t1) (listp t2) (eq (car t1) (car t2)))
         (cond ((eq (car t1) 'Vec)
                (and (dt-teq (cadr t1) (cadr t2) env)
                     (dt-ieq (caddr t1) (caddr t2) env)))
               ((and (caddr t1) (caddr t2))
                (and (dt-teq (cadr t1) (cadr t2) env)
                     (dt-teq (caddr t1) (caddr t2) env)))
               (t nil)))
        (t nil)))

(define (dt-ty expr ctx)
  (cond ((numberp expr) 'Int)
        ((symbolp expr)
         (cond ((eq expr 'vnil) 'nil-type)
               (t (let ((e (find (lambda (b) (eq (car b) expr)) ctx)))
                    (cond (e (cadr e)) (t nil))))))
        ((eq (car expr) 'vnil) 'nil-type)
        ((eq (car expr) 'vcons)
         (let ((vty (dt-ty (cadr expr) ctx)) (rty (dt-ty (caddr expr) ctx)))
           (cond ((eq rty 'nil-type)
                  (list 'Vec vty 1))
                 ((and (listp rty) (eq (car rty) 'Vec)
                       (dt-teq vty (cadr rty) nil))
                  (list 'Vec vty (list '+ 1 (caddr rty))))
                 (t nil))))
        ((eq (car expr) 'vhead)
         (let ((vt (dt-ty (cadr expr) ctx)))
           (cond ((and (listp vt) (eq (car vt) 'Vec)) (cadr vt)) (t nil))))
        ((eq (car expr) 'vtail)
         (let ((vt (dt-ty (cadr expr) ctx)))
           (cond ((and (listp vt) (eq (car vt) 'Vec))
                  (list 'Vec (cadr vt) (list '- (caddr vt) 1)))
                 (t nil))))
        ((eq (car expr) 'vec-append)
         (let ((at (dt-ty (cadr expr) ctx)) (bt (dt-ty (caddr expr) ctx)))
           (cond ((and (listp at) (listp bt) (eq (car at) 'Vec) (eq (car bt) 'Vec)
                       (dt-teq (cadr at) (cadr bt) nil))
                  (list 'Vec (cadr at) (list '+ (caddr at) (caddr bt))))
                 (t nil))))
        (t nil)))

; vcons 1 vnil : Vec Int 1
(define dv1 (dt-ty '(vcons 1 vnil) '((1 Int) (2 Int))))
(check "vcons 1 vnil is a Vec" (eq (car dv1) 'Vec))
(check "vcons 1 vnil element type Int" (eq (cadr dv1) 'Int))
(check "vcons 1 vnil length simplifies to 1" (= (dt-simp (caddr dv1) nil) 1))

; vcons 1 (vcons 2 vnil) : Vec Int 2
(define dv2 (dt-ty '(vcons 1 (vcons 2 vnil)) '((1 Int) (2 Int))))
(check "vcons 1 (vcons 2 vnil) is a Vec" (eq (car dv2) 'Vec))
(check "vcons 1 (vcons 2 vnil) element type Int" (eq (cadr dv2) 'Int))
(check "vcons 1 (vcons 2 vnil) length simplifies to 2" (= (dt-simp (caddr dv2) nil) 2))

; vec-append : Vec Int 1 -> Vec Int 1 -> Vec Int 2
(define dv3 (dt-ty '(vec-append (vcons 1 vnil) (vcons 2 vnil)) '((1 Int) (2 Int))))
(check "vec-append is a Vec" (eq (car dv3) 'Vec))
(check "vec-append length simplifies to 2" (= (dt-simp (caddr dv3) nil) 2))

; vnil type
(define dv4 (dt-ty 'vnil nil))
(check "vnil has nil-type" (eq dv4 'nil-type))
