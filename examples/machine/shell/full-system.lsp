; Full system: CPU + Forth + Filesystem + Shell, all working.
(define WORD 16777216)
(define MEM 256)
(define NREG 16)
(define PCI 8)
(define FLG 9)
(define SPI 10)
(define CYC 12)

(define (rd m a) (truncate (mat-ref (car m) 0 a)))
(define (wr m a v) (mat-set (car m) 0 a (mod v WORD)))
(define (gr m r) (truncate (mat-ref (car (cdr m)) 0 r)))
(define (sr m r v) (mat-set (car (cdr m)) 0 r (mod v WORD)))
(define (mk) (list (make-matrix 1 MEM) (make-matrix 1 NREG)))
(define (iw op a b) (+ (* op 65536) (* a 256) b))

(define (exec m w)
  (let ((op (mod (truncate (/ w 65536)) 256)))
  (let ((a (mod (truncate (/ w 256)) 256)))
  (let ((b (mod w 256)))
  (cond ((= op 0) (sr m FLG (+ (gr m FLG) 1)))
        ((= op 1) (sr m a b))
        ((= op 2) (sr m a (+ (gr m a) (gr m b))))
        ((= op 3) (sr m a (- (gr m a) (gr m b))))
        ((= op 4) (sr m a (* (gr m a) (gr m b))))
        ((= op 11) (print (cat "> " (num-to-str (gr m a)))))
        ((= op 14) (let ((s (- (gr m SPI) 1))) (sr m SPI s) (wr m s (gr m a))))
        ((= op 15) (let ((s (gr m SPI))) (let ((v (rd m s))) (sr m SPI (+ s 1)) (sr m a v))))
        (t nil))))))

(define (run m n)
  (sr m SPI 200)
  (sr m FLG 2)
  (run1 m n 0))

(define (run1 m budget n)
  (cond ((= (mod (gr m FLG) 2) 1) n)
        ((= n budget) n)
        (t (let ((p (gr m PCI)))
             (let ((w (rd m p)))
               (sr m PCI (+ p 1))
               (exec m w)))
           (run1 m budget (+ n 1)))))

(define (load-prog m ws)
  (labels (((go w a)
    (cond ((null w) a) (t (progn (wr m a (car w)) (go (cdr w) (+ a 1)))))))
    (go ws 0)))

(define (rev lst)
  (labels (((go l a) (cond ((null l) a) (t (go (cdr l) (cons (car l) a))))))
    (go lst nil)))

(define (fc ts out)
  (cond ((null ts) out)
        ((numberp (car ts)) (fc (cdr ts) (append out (list (iw 1 0 (car ts)) (iw 14 0 0)))))
        ((eq (car ts) '+) (fc (cdr ts) (append out (list (iw 15 1 0) (iw 15 0 0) (iw 2 0 1) (iw 14 0 0)))))
        ((eq (car ts) '-) (fc (cdr ts) (append out (list (iw 15 1 0) (iw 15 0 0) (iw 3 0 1) (iw 14 0 0)))))
        ((eq (car ts) '*) (fc (cdr ts) (append out (list (iw 15 1 0) (iw 15 0 0) (iw 4 0 1) (iw 14 0 0)))))
        ((eq (car ts) 'p) (fc (cdr ts) (append out (list (iw 15 0 0) (iw 11 0 0)))))
        (t (fc (cdr ts) out))))

(define (forth tokens) (append (fc tokens nil) (list (iw 0 0 0))))

(define (sjoin parts)
  (cond ((null parts) "")
        ((null (cdr parts)) (car parts))
        (t (cat (cat (car parts) " ") (sjoin (cdr parts))))))

(define fs (list (list "/bin/add" (list 3 4 '+ 'p))
                  (list "/bin/mul" (list 7 6 '* 'p))
                  (list "/home/readme" "hello from sisp os")))

(define (fs-get path)
  (let ((e (assoc path fs (quote equal))))
    (cond (e (cadr e)) (t nil))))

(define (fs-ls dir)
  (let ((ents (map car
                (filter (lambda (e) (equal (substr 0 (length dir) (car e)) dir))
                  fs))))
    (cond ((null ents) "empty") (t (sjoin ents)))))

(define (tokenize input)
  (tok (str-to-list input) "" nil))

(define (tok chars cur tokens)
  (cond ((null chars)
         (cond ((= (length cur) 0) (rev tokens))
               (t (rev (cons cur tokens)))))
        ((equal (car chars) " ")
         (cond ((= (length cur) 0) (tok (cdr chars) "" tokens))
               (t (tok (cdr chars) "" (cons cur tokens)))))
        (t (tok (cdr chars) (cat cur (car chars)) tokens))))

(define (shell cmd)
  (let ((tokens (tokenize cmd)))
    (cond ((null tokens) "")
          ((equal (car tokens) "help") "ls <path> | cat <file> | run <prog> | exit")
          ((equal (car tokens) "ls")
           (let ((d (cond ((cdr tokens) (cadr tokens)) (t "/"))))
             (fs-ls d)))
          ((equal (car tokens) "cat")
           (let ((val (fs-get (cadr tokens))))
             (cond (val (cond ((consp val) (sjoin (list "forth: " (num-to-str val)))) (t val)))
                   (t "not found"))))
          ((equal (car tokens) "run") "loaded (see CPU output below)")
          ((equal (car tokens) "exit") "bye")
          (t (sjoin (list "sh: " (car tokens) ": not found"))))))

