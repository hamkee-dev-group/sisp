(print "--- CPU Execution ---")
(print "Program: 3 4 + p")
(define add-cpu (mk))
(load-prog add-cpu (forth (list 3 4 '+ 'p)))
(sr add-cpu PCI 0)
(sr add-cpu FLG 2)
(run add-cpu 30)
(print (sjoin (list "  R0=" (num-to-str (gr add-cpu 0)))))
(print "")

(print "Program: 7 6 * p")
(define mul-cpu (mk))
(load-prog mul-cpu (forth (list 7 6 '* 'p)))
(sr mul-cpu PCI 0)
(sr mul-cpu FLG 2)
(run mul-cpu 30)
(print (sjoin (list "  R0=" (num-to-str (gr mul-cpu 0)))))
(print "")

