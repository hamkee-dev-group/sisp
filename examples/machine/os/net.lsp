; ============================================================
; NET — machine-to-machine communication over a file spool
;
; Each machine owns an inbox file at
;   /tmp/sispnet-<machine-id>.in
; (/tmp exists on any host and needs no subdirectory, so boot never
;  depends on an ambient spool directory being pre-created.)
; A frame is one text line:  SRC '>' DST ':' PORT ':' BODY
; Sending appends to the peer's inbox (append-file); receiving
; polls our own inbox (read-file) and consumes new lines.
; Two machines are two independent OS processes — communication
; goes through these real files.
;
; Services: netd dispatches incoming frames to port listeners;
; ping (port 7), web (port 80), kv (port 42) are built in.
; ============================================================

(define *machine-id* "ada")
(define *net-read-len* 0)
(define *net-inbox* nil)      ; queue of (src port body)
(define *net-listeners* nil)  ; alist (port . handler-fn)

(define (net-inbox-path id) (cat (cat "/tmp/sispnet-" id) ".in"))
(define (net-init id)
  (setq *machine-id* id)
  (append-file (net-inbox-path id) "")
  (setq *net-read-len* 0)
  (setq *net-inbox* nil)
  (str-join (list "net: " id " online, inbox " (net-inbox-path id)) ""))

; ---- frames ---------------------------------------------------
(define (split-first-sep s sep)
  (let ((i (str-find s sep)))
    (cond ((null i) (list s))
          (t (list (substr 0 i s)
                   (substr (+ i 1) (- (length s) (+ i 1)) s))))))
(define (net-frame-str src dst port body)
  (cat (cat src ">")
       (cat dst (cat ":" (cat (num-to-str port) (cat ":" body))))))
; bodies are encoded: newline <-> char 1 (the spool is line-based)
(define (net-encode s)
  (labels (((go cs acc)
      (cond ((null cs) (list-to-str (reverse acc)))
            ((equal (car cs) nl) (go (cdr cs) (cons (code-char 1) acc)))
            ((equal (car cs) (code-char 1)) (go (cdr cs) (cons (code-char 2) acc)))
            (t (go (cdr cs) (cons (car cs) acc))))))
    (go (str-to-list s) nil)))
(define (net-decode s)
  (labels (((go cs acc)
      (cond ((null cs) (list-to-str (reverse acc)))
            ((equal (car cs) (code-char 1)) (go (cdr cs) (cons nl acc)))
            ((equal (car cs) (code-char 2)) (go (cdr cs) (cons (code-char 1) acc)))
            (t (go (cdr cs) (cons (car cs) acc))))))
    (go (str-to-list s) nil)))
(define (net-send-raw dst port body)
  (append-file (net-inbox-path dst)
               (cat (net-frame-str *machine-id* dst port (net-encode body)) nl)))
(define (net-parse line)
  (let ((p1 (split-first-sep line ">")))
    (cond ((null (cdr p1)) nil)
          (t (let ((p2 (split-first-sep (cadr p1) ":")))
               (cond ((null (cdr p2)) nil)
                     (t (let ((p3 (split-first-sep (cadr p2) ":")))
                          (cond ((null (cdr p3)) nil)
                                (t (list (car p1) (car p2)
                                         (car p3) (net-decode (cadr p3)))))))))))))
(define (net-deliver line)
  (let ((f (net-parse line)))
    (cond ((null f) nil)
          ((or (equal (cadr f) *machine-id*) (equal (cadr f) "*"))
           (setq *net-inbox* (append *net-inbox* (list f)))))))
; poll the inbox file; returns how many new frames were accepted.
; Only complete lines (up to the last newline) are consumed, so a
; frame caught mid-append is picked up whole on the next poll.
(define (last-newline-pos s)
  ; index just past the last newline, or 0
  (labels (((go i last)
      (cond ((= i (length s)) last)
            ((equal (substr i 1 s) nl) (go (+ i 1) (+ i 1)))
            (t (go (+ i 1) last)))))
    (go 0 0)))
(define (net-poll)
  (let ((s (read-file (net-inbox-path *machine-id*))))
    (cond ((> (length s) *net-read-len*)
           (let ((tail (substr *net-read-len* (- (length s) *net-read-len*) s)))
             (let ((good (last-newline-pos tail)))
               (cond ((= good 0) 0)
                     (t (let ((new (substr 0 good tail)))
                          (setq *net-read-len* (+ *net-read-len* good))
                          (map net-deliver (split-lines new))
                          (length (split-lines new))))))))
          (t 0))))

; ---- netd: dispatch incoming frames to listeners --------------
; ports are matched as strings (the parser yields strings)
(define (net-listen port fn)
  (setq *net-listeners* (cons (cons (num-to-str port) fn) *net-listeners*)))
(define (netd-tick)
  (net-poll)
  (setq *net-inbox*
        (labels (((go frames acc)
            (cond ((null frames) acc)
                  (t (let ((f (car frames)))
                       (let ((l (assoc (car (cdr (cdr f))) *net-listeners* (quote equal))))
                         (cond ((not (null l))
                                (funcall (cdr l) (car f) (car (cdr (cdr (cdr f)))))
                                (go (cdr frames) acc))
                               (t (go (cdr frames) (append acc (list f)))))))))))
          (go *net-inbox* nil))))
(define (netd-start)
  (net-listen 7 echo-handler)
  (net-listen 80 web-handler)
  (net-listen 42 kv-handler)
  (setq *k-tick-hook* netd-tick))
(define (netd-stop) (setq *k-tick-hook* nil))
; pump the spool while otherwise idle (n ticks)
(define (netd-serve n)
  (cond ((= n 0) 0)
        (t (netd-tick) (netd-serve (- n 1)))))

; ---- request/response clients ---------------------------------
; requests carry "tag|body"; replies echo the tag so clients can
; match them.  net-request blocks polling until the reply lands
; (or the timeout runs out).
(define *net-req-id* 0)
(define (net-request dst port body timeout)
  (setq *net-req-id* (+ *net-req-id* 1))
  (let ((tag (cat *machine-id* (num-to-str *net-req-id*))))
    (net-send-raw dst port (cat tag (cat "|" body)))
    (net-await tag timeout)))
(define (net-await tag timeout)
  (cond ((= timeout 0) nil)
        (t (net-poll)
           (let ((hit (net-take-reply tag)))
             (cond ((not (null hit)) hit)
                   (t (net-await tag (- timeout 1))))))))
(define (net-take-reply tag)
  (labels (((go rest acc)
      (cond ((null rest) nil)
            (t (let ((f (car rest)) (b (car (cdr (cdr (cdr (car rest)))))))
                 (cond ((str-contains b (cat tag "|"))
                        (setq *net-inbox* (append acc (cdr rest)))
                        (substr (+ (length tag) 1)
                                (- (length b) (+ (length tag) 1))
                                b))
                       (t (go (cdr rest) (append acc (list f))))))))))
    (go *net-inbox* nil)))
; convenience for servers: split "tag|body" request
(define (net-split-req body) (split-first-sep body "|"))

; ---- built-in services ------------------------------------------
; ECHO (port 7): ping
(define (echo-handler src body)
  (let ((r (net-split-req body)))
    (net-send-raw src 1007 (cat (car r) (cat "|" (cadr r))))))
(define (ping host)
  (let ((r (net-request host 7 "ping" 200000)))
    (cond ((null r) (str-join (list host ": no reply") ""))
          (t (str-join (list host ": pong") "")))))

; WEB (port 80): GET /path served from this machine's disk
(define (web-handler src body)
  (let ((r (net-split-req body)))
    (let ((tag (car r)) (req (cadr r)))
      (let ((path (cadr (split-first-sep req " "))))
        (let ((content (kf-read path)))
          (cond ((null content)
                 (net-send-raw src 1080 (cat tag "|404 not found")))
                (t (net-send-raw src 1080 (cat tag (cat "|200 " (cat nl content)))))))))))
(define (web-start) (net-listen 80 web-handler))
(define (web-get host path)
  (let ((r (net-request host 80 (cat "GET " path) 200000)))
    (cond ((null r) (str-join (list host path ": no reply") ""))
          (t r))))

; KV (port 42): disk-backed key-value store at /var/kv.db
(define (kv-ensure)
  (cond ((null (fs-resolve-ino "/var" FS-ROOT)) (kf-mkdir "/var")))
  (cond ((null (fs-resolve-ino "/var/kv.db" FS-ROOT)) (kf-create "/var/kv.db"))))
(define (kv-read-all)
  (kv-ensure)
  (let ((s (kf-read "/var/kv.db")))
    (cond ((null s) nil)
          (t (map (lambda (line)
                    (let ((p (split-first-sep line "=")))
                      (cons (car p) (cadr p))))
                  (split-lines s))))))
(define (kv-write-all db)
  (kf-write "/var/kv.db"
            (str-join (map (lambda (e) (cat (car e) (cat "=" (cdr e)))) db)
                          nl)))
(define (kv-local-put k v)
  (let ((db (kv-read-all)))
    (kv-write-all (cons (cons k v)
                        (remove (lambda (e) (equal (car e) k)) db)))))
(define (kv-local-get k)
  (let ((e (assoc k (kv-read-all) (quote equal))))
    (cond ((null e) nil) (t (cdr e)))))
(define (kv-local-del k)
  (kv-write-all (remove (lambda (e) (equal (car e) k)) (kv-read-all))))
(define (kv-handler src body)
  (let ((r (net-split-req body)))
    (let ((tag (car r)) (op-line (cadr r)))
      (let ((op (split-first-sep op-line " ")))
        (cond ((equal (car op) "PUT")
               (let ((kv (split-first-sep (cadr op) " ")))
                 (kv-local-put (car kv) (cadr kv))
                 (net-send-raw src 1042 (cat tag "|OK"))))
              ((equal (car op) "GET")
               (let ((v (kv-local-get (cadr op))))
                 (cond ((null v) (net-send-raw src 1042 (cat tag "|NIL")))
                       (t (net-send-raw src 1042 (cat tag (cat "|" v)))))))
              ((equal (car op) "DEL")
               (kv-local-del (cadr op))
               (net-send-raw src 1042 (cat tag "|OK")))
              (t (net-send-raw src 1042 (cat tag "|ERR"))))))))
(define (kv-start) (net-listen 42 kv-handler))
(define (kv-put host k v)
  (net-request host 42 (cat (cat "PUT " k) (cat " " v)) 200000))
(define (kv-get host k)
  (net-request host 42 (cat "GET " k) 200000))
(define (kv-del host k)
  (net-request host 42 (cat "DEL " k) 200000))
