(print "=== char-code / code-char tests ===")
(if (equal (char-code "A") 65) (print "PASS: char-code-A") (print "FAIL: char-code-A"))
(if (equal (char-code "a") 97) (print "PASS: char-code-a") (print "FAIL: char-code-a"))
(if (equal (char-code " ") 32) (print "PASS: char-code-space") (print "FAIL: char-code-space"))
(if (equal (code-char 66) "B") (print "PASS: code-char-B") (print "FAIL: code-char-B"))
(if (equal (code-char 48) "0") (print "PASS: code-char-0") (print "FAIL: code-char-0"))
(if (equal (char-code (code-char 200)) 200) (print "PASS: roundtrip-200") (print "FAIL: roundtrip-200"))
(if (equal (char-code (code-char 127)) 127) (print "PASS: roundtrip-127") (print "FAIL: roundtrip-127"))
(if (equal (catch (code-char 256) (lambda (e) (quote raised))) (quote raised)) (print "PASS: code-char-range-err") (print "FAIL: code-char-range-err"))
(if (equal (catch (code-char -1) (lambda (e) (quote raised))) (quote raised)) (print "PASS: code-char-neg-err") (print "FAIL: code-char-neg-err"))
